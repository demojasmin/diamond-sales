<Application x:Class="SolitaireDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme (colors) — index 0. ThemeManager swaps this at runtime. -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <!-- Design tokens -->
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <!-- Component styles -->
                <ResourceDictionary Source="Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Styles/Inputs.xaml"/>
                <ResourceDictionary Source="Styles/Widgets.xaml"/>
                <ResourceDictionary Source="Styles/DataGridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
