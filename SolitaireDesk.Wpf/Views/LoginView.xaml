<UserControl x:Class="SolitaireDesk.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{StaticResource UiFont}"
             TextElement.FontSize="13.5"
             TextOptions.TextFormattingMode="Ideal">
    <!-- Standalone screen (shown before the shell). Preview directly in the designer. -->
    <Grid>
        <!-- Background is the gradient below; the attribute form set it twice, which XAML refuses. -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.8" RadiusY="0.7">
                <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource BgColor}" Offset="0.7"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Style="{StaticResource Card}" Width="396" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Text="Solitaire Desk" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Sign in" Style="{StaticResource H1Text}" Margin="0,0,0,6"/>
                <TextBlock Text="Sales floor terminal · Surat unit" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,24"/>

                <TextBlock Text="USERNAME" Style="{StaticResource LabelCaps}" FontSize="11.5" Margin="0,0,0,7"/>
                <TextBox Style="{StaticResource FieldTextBox}" Height="36" Text="h.parekh" Margin="0,0,0,16"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource LabelCaps}" FontSize="11.5" Margin="0,0,0,7"/>
                <PasswordBox Height="36" VerticalContentAlignment="Center" Padding="11,0"
                             Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1" Foreground="{DynamicResource TextBrush}"/>

                <CheckBox Style="{StaticResource FieldCheckBox}" Content="Remember this terminal" IsChecked="True" Margin="0,18,0,22"/>

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Height="38" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Role: Sales · v2.4.1" Style="{StaticResource MutedText}" FontSize="11.5"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
