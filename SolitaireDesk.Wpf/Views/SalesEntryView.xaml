<UserControl x:Class="SolitaireDesk.Views.SalesEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:SolitaireDesk.Design"
             Background="{DynamicResource BgBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{StaticResource UiFont}"
             TextElement.FontSize="13.5"
             TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ================= MAIN COLUMN ================= -->
        <DockPanel Grid.Column="0">

            <!-- Header band -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,12,0">
                            <Path Data="M12,7 H2 M5.5,3.5 L2,7 L5.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                        <TextBlock Text="SB/26-27/157" Style="{StaticResource MonoText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Label Style="{StaticResource Chip}" Tag="Posted" Content="POSTED" VerticalAlignment="Center"/>
                        <TextBlock Text="Posted invoice — edits create an audit entry" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBlock Text="Ctrl+S save · Enter new line · Esc back" Style="{StaticResource MonoText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Field row 1 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="DATE" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <DatePicker/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,0">
                            <TextBlock Text="BUYER" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource FieldTextBox}" Text="Quest Diamond"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0">
                            <TextBlock Text="BROKER" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource FieldTextBox}" Text="Rajesh Mehta"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,12,0">
                            <TextBlock Text="BROKER %" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource NumericTextBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5">
                            <TextBlock Text="DOC TYPE" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource FieldComboBox}" ItemContainerStyle="{StaticResource FieldComboBoxItem}" SelectedIndex="0">
                                <ComboBoxItem Content="BILL"/><ComboBoxItem Content="MEMO"/><ComboBoxItem Content="APPROVAL"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Field row 2 -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="TERMS DAYS" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource NumericTextBox}" Text="45"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="DUE DATE" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                            <Border Height="32" CornerRadius="{StaticResource RadiusControl}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="Transparent">
                                <TextBlock Text="07 Sep 26" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            </Border>
                        </StackPanel>
                        <!-- inline validation slot (set Visibility=Visible when a line is invalid) -->
                        <Border Grid.Column="2" Grid.ColumnSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Height="32" CornerRadius="{StaticResource RadiusControl}"
                                Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" Padding="11,0" Visibility="Collapsed">
                            <TextBlock Text="Check selection carats" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Footer totals + actions -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="LINES" Style="{StaticResource LabelCaps}" FontSize="10"/>
                        <TextBlock Text="3" Style="{StaticResource MonoText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="SELECTION CT" Style="{StaticResource LabelCaps}" FontSize="10"/>
                        <TextBlock Text="240.38" Style="{StaticResource MonoText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="REJECT CT" Style="{StaticResource LabelCaps}" FontSize="10"/>
                        <TextBlock Text="100.47" Style="{StaticResource MonoText}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="BLENDED RATE" Style="{StaticResource LabelCaps}" FontSize="10"/>
                        <TextBlock Text="₹41,405/ct" Style="{StaticResource MonoText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="1" Height="34" Background="{DynamicResource BorderBrush}" Margin="0,0,18,0"/>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="INVOICE TOTAL" Style="{StaticResource LabelCaps}" FontSize="10"/>
                        <TextBlock Text="₹99,54,923" Style="{StaticResource MonoDisplay}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Receipts (2)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Cancel invoice" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                        <Button Content="Save draft" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Post invoice" Style="{StaticResource PrimaryButton}" Padding="18,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Line items -->
            <DockPanel>
                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="12,8" Height="30" Padding="12,0"
                        Style="{StaticResource ButtonBase}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7,2 V12 M2,7 H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0"/>
                        <TextBlock Text="Add line" VerticalAlignment="Center"/>
                        <TextBlock Text=" (Enter)" Style="{StaticResource MonoText}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{x:Static design:SampleData.EntryLines}"
                          RowHeight="42" Margin="8,4,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding N}" Width="34" ElementStyle="{StaticResource MonoCellText}"/>
                        <DataGridTemplateColumn Header="Size" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource CellComboBox}" ItemContainerStyle="{StaticResource FieldComboBoxItem}" Text="{Binding Size}">
                                        <ComboBoxItem Content="−2"/><ComboBoxItem Content="−6.5"/><ComboBoxItem Content="+6.5"/><ComboBoxItem Content="+11"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Grade" Width="158">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellTextBox}" Text="{Binding Grade}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Weight ct" Width="94" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding Weight}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Selection ct" Width="96" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding Selection}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- computed read-only -->
                        <DataGridTemplateColumn Header="Reject ct" Width="92" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="{StaticResource RadiusSmall}" Padding="7,3" Margin="2,0">
                                        <TextBlock Text="{Binding Reject}" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Price / ct" Width="112" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding Price}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ex rate" Width="74" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding ExRate}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Less 1 %" Width="70" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding Less1}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Less 2 %" Width="70" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellNumericTextBox}" Text="{Binding Less2}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Amount" Width="138" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Amount}" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Remark" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBox Style="{StaticResource CellTextBox}" Text="{Binding Remark}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowIconButton}" Background="Transparent" BorderBrush="Transparent" ToolTip="Delete line">
                                        <Path Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>

        <!-- ================= RECEIPTS PANEL ================= -->
        <Border Grid.Column="1" Width="306" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14">
                    <TextBlock Text="Receipts" Style="{StaticResource H3Text}" FontSize="13.5" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RowIconButton}" HorizontalAlignment="Right" Background="{DynamicResource Surface2Brush}">
                        <Path Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <Border Style="{StaticResource Divider}" DockPanel.Dock="Top"/>

                <!-- Summary -->
                <StackPanel DockPanel.Dock="Top" Margin="16,14">
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="Invoice total" Style="{StaticResource MutedText}" FontSize="12.5"/>
                        <TextBlock Text="₹99,54,923" Style="{StaticResource MonoText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="Received" Style="{StaticResource MutedText}" FontSize="12.5"/>
                        <TextBlock Text="₹40,00,000" Style="{StaticResource MonoText}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,9"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Outstanding" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="₹59,54,923" Style="{StaticResource MonoText}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="6" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                        <Border Height="6" CornerRadius="999" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Left" Width="110"/>
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource Divider}" DockPanel.Dock="Top"/>

                <!-- Record button -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Button Content="Record receipt" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                </Border>

                <!-- Receipt cards -->
                <StackPanel Margin="8">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10" Margin="0,0,0,7">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="₹25,00,000" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="12 Jul 26" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="RTGS · UTR448120" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="₹15,00,000" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="20 Jul 26" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="NEFT · UTR771905" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
