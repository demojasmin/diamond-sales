<UserControl x:Class="SolitaireDesk.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{StaticResource UiFont}"
             TextElement.FontSize="13.5"
             TextOptions.TextFormattingMode="Ideal">
    <UserControl.Resources>
        <!-- Matrix header cell -->
        <Style x:Key="MxHead" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
        <Style x:Key="MxHeadText" TargetType="TextBlock" BasedOn="{StaticResource LabelCaps}"/>
        <!-- Matrix data cell -->
        <Style x:Key="MxCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <TextBlock Text="Balance carats and weighted-average value per grade × sieve size"
                               Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="Low" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <Border Width="78" Height="7" CornerRadius="999">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="High value" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                        <Button Content="+ Conversion" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="+ Rough intake" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid MinWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MxHead}"><TextBlock Text="GRADE" Style="{StaticResource MxHeadText}"/></Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MxHead}"><TextBlock Text="−2" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MxHead}"><TextBlock Text="−6.5" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MxHead}"><TextBlock Text="+6.5" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource MxHead}"><TextBlock Text="+11" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>
                    <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource MxHead}"><TextBlock Text="TOTAL CT" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>
                    <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource MxHead}"><TextBlock Text="STOCK VALUE" Style="{StaticResource MxHeadText}" TextAlignment="Right"/></Border>

                    <!-- Rows (grade | 4 cells with ct+avg | total ct | value) -->
                    <!-- Row template repeated; heat shading varied via cell Background -->
                    <!-- NO 1 -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MxCell}">
                        <StackPanel><TextBlock Text="NO 1" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="No. 1 Clean" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MxCell}" Background="#144C8DFF"><StackPanel><TextBlock Text="182.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹54,200" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MxCell}" Background="#264C8DFF"><StackPanel><TextBlock Text="486.10" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹56,400" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MxCell}" Background="#334C8DFF"><StackPanel><TextBlock Text="742.30" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹61,900" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource MxCell}" Background="#144C8DFF"><StackPanel><TextBlock Text="431.80" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹68,100" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="1" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="1,842.60" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="1" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹10,84,20,400" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- NO 1 BB -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="NO 1 BB" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="No. 1 Bottom Black" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MxCell}" Background="#0F4C8DFF"><StackPanel><TextBlock Text="120.60" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹47,900" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MxCell}" Background="#1C4C8DFF"><StackPanel><TextBlock Text="342.10" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹49,600" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource MxCell}" Background="#264C8DFF"><StackPanel><TextBlock Text="510.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹53,100" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource MxCell}" Background="#0F4C8DFF"><StackPanel><TextBlock Text="231.20" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹58,700" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="1,204.30" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹6,20,41,300" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- NO II -->
                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="NO II" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="No. II Spotted" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource MxCell}" Background="#264C8DFF"><StackPanel><TextBlock Text="512.80" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹44,100" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource MxCell}" Background="#334C8DFF"><StackPanel><TextBlock Text="618.30" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹47,300" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="3" Grid.Column="4" Style="{StaticResource MxCell}" Background="#1C4C8DFF"><StackPanel><TextBlock Text="246.80" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹52,900" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="3" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="1,377.90" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="3" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹6,42,88,100" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- EX 1 -->
                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="EX 1" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Extra No. 1" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource MxCell}" Background="#144C8DFF"><StackPanel><TextBlock Text="188.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹29,200" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="4" Grid.Column="3" Style="{StaticResource MxCell}" Background="#1C4C8DFF"><StackPanel><TextBlock Text="342.60" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹34,600" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="4" Grid.Column="4" Style="{StaticResource MxCell}" Background="#0F4C8DFF"><StackPanel><TextBlock Text="200.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹43,800" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="4" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="731.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="4" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹2,63,30,400" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- TOP-COL -->
                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="TOP-COL" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Top Colour" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource MxCell}" Background="#0F4C8DFF"><StackPanel><TextBlock Text="96.20" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹30,100" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="5" Grid.Column="3" Style="{StaticResource MxCell}" Background="#144C8DFF"><StackPanel><TextBlock Text="188.60" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹33,200" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="5" Grid.Column="4" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="125.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/><TextBlock Text="₹37,400" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="5" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="410.20" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="5" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹1,36,58,600" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- GH (low) -->
                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource MxCell}"><StackPanel><TextBlock Text="GH" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ghost" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
                    <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="6" Grid.Column="3" Style="{StaticResource MxCell}" Background="#0A4C8DFF"><StackPanel><TextBlock Text="32.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="₹21,400" Style="{StaticResource NumericCellText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel></Border>
                    <Border Grid.Row="6" Grid.Column="4" Style="{StaticResource MxCell}"><TextBlock Text="—" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource TextMutedBrush}"/></Border>
                    <Border Grid.Row="6" Grid.Column="5" Style="{StaticResource MxCell}"><TextBlock Text="32.40" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>
                    <Border Grid.Row="6" Grid.Column="6" Style="{StaticResource MxCell}"><TextBlock Text="₹6,93,360" Style="{StaticResource NumericCellText}" FontWeight="SemiBold"/></Border>

                    <!-- Company total -->
                    <Border Grid.Row="7" Grid.Column="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="Company total" FontWeight="Bold" FontSize="12.5"/></Border>
                    <Border Grid.Row="7" Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="303.00" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                    <Border Grid.Row="7" Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="2,125.30" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                    <Border Grid.Row="7" Grid.Column="3" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="3,014.90" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                    <Border Grid.Row="7" Grid.Column="4" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="1,467.40" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                    <Border Grid.Row="7" Grid.Column="5" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="7,911.60" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                    <Border Grid.Row="7" Grid.Column="6" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8"><TextBlock Text="₹41,20,08,900" Style="{StaticResource NumericCellText}" FontWeight="Bold"/></Border>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Movements drawer -->
        <Border Grid.Column="1" Width="380" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,14">
                    <StackPanel>
                        <TextBlock Text="NO 1 · sieve +6.5" Style="{StaticResource H3Text}" FontSize="13.5"/>
                        <TextBlock Text="742.30 ct balance · wtd avg ₹61,900/ct" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource RowIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource Surface2Brush}">
                        <Path Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <Border Style="{StaticResource Divider}" DockPanel.Dock="Top"/>
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="Grid" x:Key="MvRow"><Setter Property="Margin" Value="16,10"/></Style>
                        </StackPanel.Resources>
                        <Grid Style="{StaticResource MvRow}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="18 Feb 26" Style="{StaticResource MutedText}" FontSize="12" Width="80"/><TextBlock Text="Intake" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="+680.00" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource SuccessBrush}" Width="80"/><TextBlock Text="₹56,400" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0"/></StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource MvRow}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="02 Apr 26" Style="{StaticResource MutedText}" FontSize="12" Width="80"/><TextBlock Text="ConvertIn" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="+124.00" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource SuccessBrush}" Width="80"/><TextBlock Text="₹58,900" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0"/></StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource MvRow}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="22 Jul 26" Style="{StaticResource MutedText}" FontSize="12" Width="80"/><TextBlock Text="Sale" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="12.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="−61.70" Style="{StaticResource NumericCellText}" Foreground="{DynamicResource DangerBrush}" Width="80"/><TextBlock Text="₹62,400" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,0,0"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
