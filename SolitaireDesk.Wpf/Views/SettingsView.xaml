<UserControl x:Class="SolitaireDesk.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:SolitaireDesk.Design"
             Background="{DynamicResource BgBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{StaticResource UiFont}"
             TextElement.FontSize="13.5"
             TextOptions.TextFormattingMode="Ideal">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,28">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Appearance -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource H3Text}"/>
                        <TextBlock Text="Applies instantly across the app." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,16"/>
                        <TextBlock Text="THEME" Style="{StaticResource LabelCaps}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <!-- Light -->
                            <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}" Padding="11" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Height="34" CornerRadius="5" Background="#F4F6F9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                                            <Border Width="16" Height="5" CornerRadius="2" Background="#2F6BE0" Margin="0,0,3,0"/>
                                            <Border Width="26" Height="5" CornerRadius="2" Background="#D9DFE8"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Light" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <!-- Dark -->
                            <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Padding="11" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Height="34" CornerRadius="5" Background="#0E1116" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,9">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5">
                                            <Border Width="16" Height="5" CornerRadius="2" Background="#4C8DFF" Margin="0,0,3,0"/>
                                            <Border Width="26" Height="5" CornerRadius="2" Background="#2A313C"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Dark" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <!-- System -->
                            <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Padding="11">
                                <StackPanel>
                                    <Border Height="34" CornerRadius="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,9">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#F4F6F9" Offset="0.5"/><GradientStop Color="#0E1116" Offset="0.5"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="System" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Divider}"/>
                        <Grid Margin="0,11">
                            <StackPanel>
                                <TextBlock Text="Reduce motion" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Disables non-essential transitions" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Margin="0,11,0,0">
                            <StackPanel>
                                <TextBlock Text="Grid density" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Row height in all data grids" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Density" Style="{StaticResource SegmentButton}" Content="Compact" IsChecked="True"/>
                                    <RadioButton GroupName="Density" Style="{StaticResource SegmentButton}" Content="Comfortable"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Company + thresholds -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Company" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="LEGAL NAME" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource FieldTextBox}" Text="Solitaire Exports Pvt Ltd"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="GSTIN" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource MonoFont}" Text="24AABCS1429P1ZK"/>
                                </StackPanel>
                                <StackPanel Margin="0,12,6,0">
                                    <TextBlock Text="CURRENCY" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <ComboBox Style="{StaticResource FieldComboBox}" ItemContainerStyle="{StaticResource FieldComboBoxItem}" SelectedIndex="0">
                                        <ComboBoxItem Content="INR (₹)"/><ComboBoxItem Content="USD ($)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="6,12,0,0">
                                    <TextBlock Text="ROUNDING" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <ComboBox Style="{StaticResource FieldComboBox}" ItemContainerStyle="{StaticResource FieldComboBoxItem}" SelectedIndex="0">
                                        <ComboBoxItem Content="Money 2 dp · Carats 4 dp"/><ComboBoxItem Content="Money 0 dp · Carats 2 dp"/>
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Alert thresholds" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="LOW STOCK BELOW (CT)" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource NumericTextBox}" Text="40"/>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="OVERDUE WARNING (DAYS)" Style="{StaticResource LabelCaps}" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource NumericTextBox}" Text="15"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Audit log -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14">
                        <TextBlock Text="Audit log" Style="{StaticResource H3Text}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Width="260" Height="30" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" DockPanel.Dock="Top"/>
                    <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{x:Static design:SampleData.Audit}" Margin="0,4,0,4" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="150" ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="150" ElementStyle="{StaticResource MonoCellText}"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*" ElementStyle="{StaticResource MutedCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
