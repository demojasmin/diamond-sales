<UserControl x:Class="SolitaireDesk.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:SolitaireDesk.Design"
             Background="{DynamicResource BgBrush}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontFamily="{StaticResource UiFont}"
             TextElement.FontSize="13.5"
             TextOptions.TextFormattingMode="Ideal">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,28">

            <!-- KPI row -->
            <UniformGrid Columns="4">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="0,0,16,0"/>
                        <Setter Property="Padding" Value="16,16,16,12"/>
                    </Style>
                </UniformGrid.Resources>

                <Border>
                    <StackPanel>
                        <TextBlock Text="TODAY'S SALES" Style="{StaticResource LabelCaps}"/>
                        <TextBlock Text="₹1,67,24,427" Style="{StaticResource MonoText}" FontSize="21" FontWeight="SemiBold" Margin="0,11,0,5"/>
                        <TextBlock Text="4 invoices posted today" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="CARATS SOLD TODAY" Style="{StaticResource LabelCaps}"/>
                        <TextBlock Text="516.62 ct" Style="{StaticResource MonoText}" FontSize="21" FontWeight="SemiBold" Margin="0,11,0,5"/>
                        <TextBlock Text="blended ₹32,371/ct" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="OUTSTANDING RECEIVABLES" Style="{StaticResource LabelCaps}"/>
                        <TextBlock Text="₹2,58,03,647" Style="{StaticResource MonoText}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,11,0,5"/>
                        <TextBlock Text="6 overdue · ₹1,42,84,747" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                </Border>
                <Border Margin="0">
                    <StackPanel>
                        <TextBlock Text="STOCK VALUE" Style="{StaticResource LabelCaps}"/>
                        <TextBlock Text="₹41,20,08,900" Style="{StaticResource MonoText}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,11,0,5"/>
                        <TextBlock Text="7,911.60 ct on hand" Style="{StaticResource MutedText}" FontSize="11.5"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent + side column -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.75*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent invoices -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,14">
                            <TextBlock Text="Recent invoices" Style="{StaticResource H3Text}" VerticalAlignment="Center"/>
                            <Button Content="View all" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}" DockPanel.Dock="Top"/>
                        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{x:Static design:SampleData.Recent}"
                                  IsHitTestVisible="True" Margin="0,4,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding No}" Width="132" ElementStyle="{StaticResource MonoCellText}"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="92" ElementStyle="{StaticResource MutedCellText}"/>
                                <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Carats" Binding="{Binding Carats}" Width="88"
                                                    ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="132"
                                                    ElementStyle="{StaticResource NumericCellText}" HeaderStyle="{StaticResource DataGridNumericHeaderStyle}"/>
                                <DataGridTemplateColumn Header="Status" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Label Style="{StaticResource Chip}" Tag="{Binding Status}" Content="{Binding Status}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Side column: attention + top buyers -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Attention" Style="{StaticResource H3Text}" Margin="16,14"/>
                            <Border Style="{StaticResource Divider}"/>
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="Border" x:Key="Alert">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="16,12"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Border Style="{StaticResource Alert}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Overdue invoices" FontSize="12.8" FontWeight="SemiBold"/>
                                                <TextBlock Text="6 invoices past due date" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="₹1,42,84,747" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Alert}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Draft invoices pending" FontSize="12.8" FontWeight="SemiBold"/>
                                                <TextBlock Text="4 not yet posted" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="4" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Alert}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Low stock · GH" FontSize="12.8" FontWeight="SemiBold"/>
                                                <TextBlock Text="Sieve +6.5 below threshold" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="32.40 ct" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <TextBlock Text="Credit limit watch" FontSize="12.8" FontWeight="SemiBold"/>
                                                <TextBlock Text="Meridian Diam at 78% of limit" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="78%" Style="{StaticResource MonoText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Top buyers · 90 days" Style="{StaticResource H3Text}" Margin="0,0,0,12"/>
                            <ItemsControl>
                                <ItemsControl.Resources>
                                    <Style TargetType="Grid" x:Key="Bar"><Setter Property="Margin" Value="0,0,0,11"/></Style>
                                </ItemsControl.Resources>
                                <!-- rows -->
                                <Grid Style="{StaticResource Bar}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Meridian Diam" FontSize="12.5"/>
                                            <TextBlock Text="₹92,80,120" Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="5" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                                            <Border Height="5" CornerRadius="999" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="220"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource Bar}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Z K Enterprise" FontSize="12.5"/>
                                            <TextBlock Text="₹72,45,110" Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="5" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                                            <Border Height="5" CornerRadius="999" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="172"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource Bar}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Quest Diamond" FontSize="12.5"/>
                                            <TextBlock Text="₹67,24,427" Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="5" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                                            <Border Height="5" CornerRadius="999" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="160"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource Bar}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Kiran Exports" FontSize="12.5"/>
                                            <TextBlock Text="₹51,90,300" Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="5" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                                            <Border Height="5" CornerRadius="999" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="124"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Aurum Diamonds" FontSize="12.5"/>
                                            <TextBlock Text="₹33,17,400" Style="{StaticResource MonoText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Height="5" CornerRadius="999" Background="{DynamicResource Surface2Brush}">
                                            <Border Height="5" CornerRadius="999" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="80"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
