<Window x:Class="SolitaireDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SolitaireDesk.Views"
        Title="Solitaire Desk — Diamond Sales &amp; Inventory"
        Height="904" Width="1440" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Screen title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ScreenTitle" Text="Dashboard" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ScreenSub" Text="Trading position at a glance"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Global search -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="400">
                    <TextBox Style="{StaticResource FieldTextBox}" Height="32" Padding="32,0,10,0"/>
                    <Path Data="M7,7 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 M11,11 L14,14"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                          Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search invoices, buyers, grades…" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False" Opacity="0.8"/>
                </Grid>

                <!-- Right cluster -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Height="26" CornerRadius="999" Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="Synced 2 min ago" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ThemeToggle" Style="{StaticResource IconButton}" Click="ThemeToggle_Click"
                            ToolTip="Toggle light / dark" Margin="0,0,10,0">
                        <Grid Width="14" Height="14">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                     StrokeThickness="1.6"/>
                            <Path Data="M7,0 A7,7 0 0,1 7,14 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>

                    <Border Width="28" Height="28" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,9,0">
                        <TextBlock Text="HP" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Harsh Parekh" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Manager" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= BODY: nav rail + content ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nav rail -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14">
                    <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Style="{StaticResource LabelCaps}"
                               FontSize="10" Margin="10,6,0,10"/>

                    <!-- bottom group -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                      Data="M10,7 A3,3 0 1,0 10,13 A3,3 0 1,0 10,7 M10,3 A7,7 0 1,0 10,17 A7,7 0 1,0 10,3"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <Button Style="{StaticResource NavButtonMuted}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                                      Data="M12,3 L5,3 L5,17 L12,17 M10,10 L17,10 M14,7 L17,10 L14,13"/>
                                <TextBlock Text="Sign out" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- main group -->
                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                      Data="M3,3 h6 v6 h-6 z M11,3 h6 v4 h-6 z M11,9 h6 v8 h-6 z M3,11 h6 v6 h-6 z"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSales" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Sales">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                          Data="M4,2.5 h12 v15 h-12 z M7,7.5 h6 M7,10.5 h6 M7,13.5 h4"/>
                                    <TextBlock Text="Sales" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Label Content="40" Style="{StaticResource CountPill}" HorizontalAlignment="Right"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavInventory" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Inventory">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Fill="Transparent"
                                      Data="M2.5,2.5 h4 v4 h-4 z M8,2.5 h4 v4 h-4 z M13.5,2.5 h4 v4 h-4 z M2.5,8 h4 v4 h-4 z M8,8 h4 v4 h-4 z M13.5,8 h4 v4 h-4 z M2.5,13.5 h4 v4 h-4 z M8,13.5 h4 v4 h-4 z"/>
                                <TextBlock Text="Inventory" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavReceivables" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Receivables">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                          Data="M10,2.8 A7.2,7.2 0 1,0 10,17.2 A7.2,7.2 0 1,0 10,2.8 M6.8,10.4 h6.4 M8.4,7.6 h3.2"/>
                                    <TextBlock Text="Receivables" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Label Content="6" Style="{StaticResource Chip}" Tag="Overdue" HorizontalAlignment="Right"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavMasters" GroupName="Nav" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Masters">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Margin="0,0,11,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                      Data="M2.8,4 h14.4 v4.4 h-14.4 z M2.8,11.6 h14.4 v4.4 h-14.4 z"/>
                                <TextBlock Text="Masters" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content host -->
            <ContentControl x:Name="ContentHost" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
