<Window x:Class="DiamondDesktop.RemarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Remark" Width="520" SizeToContent="Height" MinHeight="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="{StaticResource AppIcon}"
        ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5" TextOptions.TextFormattingMode="Ideal">

  <!-- ADD/EDIT REMARK (Nov 2026): the Remark icon's own small window, just the remark of one
       line. Save writes it onto that line; Cancel leaves it as it was. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Margin="0,0,10,0" IsCancel="True"
                Style="{StaticResource SecondaryAction}" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryAction}" Click="Save_Click"
                AutomationProperties.Name="Save the remark"/>
      </StackPanel>
    </Border>
    <StackPanel Margin="22,20,22,16">
      <TextBlock x:Name="Heading" Text="Add/Edit Remark" Style="{StaticResource CardTitle}"/>
      <TextBlock x:Name="LineText" Style="{StaticResource CardSubtitle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
      <TextBlock Text="REMARK" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
      <TextBox x:Name="RemarkBox" Style="{StaticResource AppTextBox}" MinHeight="90" MaxHeight="240"
               TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
               VerticalContentAlignment="Top" Padding="8,6"
               AutomationProperties.Name="Remark"/>
    </StackPanel>
  </DockPanel>
</Window>
