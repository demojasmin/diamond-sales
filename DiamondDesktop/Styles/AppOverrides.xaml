<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:ui="clr-namespace:DiamondDesktop">

    <ui:DayTitleConverter x:Key="DayTitle"/>
    <ui:StatusWordConverter x:Key="StatusWord"/>

    <!-- APPLICATION level, not MainWindow.Resources. The Update dialog is its own window and
         cannot see anything declared on the page; putting these here is what lets that modal wear
         the same buttons as the screen it mirrors instead of a second set that drifts. -->
    <!-- Invoice-line action icons. ONE style, ONE 16x16 box, ONE stroke weight, so the row of
         buttons reads as a set rather than as six separate decisions. Stroked rather than filled
         to match the icons already on this screen (the search clear, the dashboard glyphs), and
         bound to the button's own Foreground so each keeps its meaning: Remove stays red,
         Confirm sale stays on gold. -->
    <Style x:Key="ActionIcon" TargetType="Path">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

    <!-- a plus: one more line -->
    <Geometry x:Key="IconAdd">M 8,1 L 8,15 M 1,8 L 15,8</Geometry>
    <!-- a bin: take these lines off the invoice -->
    <Geometry x:Key="IconRemove">M 2,4 L 14,4 M 6,4 L 6,2 L 10,2 L 10,4 M 3.5,4 L 4.5,15 L 11.5,15 L 12.5,4 M 6.5,7 L 6.5,12 M 9.5,7 L 9.5,12</Geometry>
    <!-- a sheet with a folded corner: put it away as a memo -->
    <Geometry x:Key="IconMemo">M 3,1.5 L 10,1.5 L 13,4.5 L 13,14.5 L 3,14.5 Z M 10,1.5 L 10,4.5 L 13,4.5 M 5.5,8 L 10.5,8 M 5.5,11 L 10.5,11</Geometry>
    <!-- an arrow into a tray: go and look at the buckets -->
    <Geometry x:Key="IconStock">M 8,1.5 L 8,9 M 4.5,6 L 8,9.5 L 11.5,6 M 1.5,11 L 5,11 L 6,13 L 10,13 L 11,11 L 14.5,11</Geometry>
    <!-- a tick: the sale is confirmed -->
    <Geometry x:Key="IconConfirm">M 2,8.5 L 6.5,13 L 14,3</Geometry>
    <!-- a circular arrow: start again with an empty screen -->
    <Geometry x:Key="IconClear">M 14,8 A 6,6 0 1 1 11.8,3.4 M 14,1 L 14,4 L 11,4</Geometry>


    <!--
      App-level refinements on top of the Solitaire Desk design package.
      Kept in one file so the design folders stay exactly as delivered and can be re-copied.
    -->

    <!-- ================= TABLES =================
         Shaped after the reference table: quiet header, hairline row separators, a soft hover,
         generous row height, and status shown as a chip rather than bare text. -->

    <Style x:Key="AppColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SeparatorBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            <!-- THE SORT MARK, on every column the grid will actually sort by.
                                 The custom header template replaced WPF's own SortDirectionIndicator
                                 and never put anything back, so clicking a header reordered the
                                 table with nothing on screen to say it had — and nothing beforehand
                                 to say it could. Two triangles at rest, one of them alone and in
                                 the accent colour once the column is the one being sorted.
                                 CanUserSort, not the grid's setting: a template column with no
                                 SortMemberPath cannot be sorted, and offering the mark there would
                                 promise something the click does not deliver. -->
                            <Path x:Name="sortMark" Grid.Column="1" Stretch="None"
                                  Width="7" Height="11" Margin="6,0,0,0"
                                  VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                        <Setter Property="Opacity" Value="0.55"/>
                                        <Setter Property="Data" Value="M 3.5,0 L 0,4 L 7,4 Z M 3.5,11 L 0,7 L 7,7 Z"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding Column.CanUserSort,
                                                                           RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Value="Ascending"
                                                         Binding="{Binding SortDirection,
                                                                           RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}">
                                                <Setter Property="Data" Value="M 3.5,0 L 0,5 L 7,5 Z"/>
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Value="Descending"
                                                         Binding="{Binding SortDirection,
                                                                           RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}">
                                                <Setter Property="Data" Value="M 3.5,11 L 0,6 L 7,6 Z"/>
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left, matching the figures beneath it. The header must always agree with its column or the
         eye zig-zags; the alignment itself was a deliberate choice to keep every column on the same
         edge. Kept as a separate key so numeric columns can be flipped back in one place. -->
    <Style x:Key="AppNumericHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="AppRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="42"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <!-- 10, not 14. Padding is charged twice per column, so six columns spent 168px of the
             Stock table's width on whitespace — enough on its own to push the table past its half
             of the page and clip every cell in it. AppColumnHeader carries the same number; they
             have to move together or the header stops sitting over its column. -->
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A grid cell that says it can be typed in.
         
         The Grades alias column is the only free-text field in a grid of read-only ones, and it
         drew identically to them: a bare TextBlock, no border, no background. Nobody double-clicks
         text that looks like a label, so the aliases that make an import resolve went unedited and
         the file got blamed instead. This gives the cell the same box the form inputs use.

         The CELL, not the content. ElementStyle would restyle the text and could touch what is
         displayed; this changes only the frame around it, so the binding, the stored value and the
         alias matching are untouched. -->
    <Style x:Key="EditableCell" TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
        <Setter Property="Cursor" Value="IBeam"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="ToolTip" Value="Double-click to edit. Separate spellings with a semicolon."/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <!-- FieldTextBox's own numbers, not approximations of them: 32 high, 10,0
                         padding, RadiusControl, Surface2 on BorderBrush. The cell has to read as
                         the SAME control the editor turns into, or double-clicking it visibly
                         changes shape and the box that was there a moment ago looks like it was
                         something else. Height is fixed for the same reason — left to the row it
                         stretched, and a field that is a different height on every row does not
                         read as a field. -->
                    <!-- UseLayoutRounding, and it is the bottom border that needs it.
                         SnapsToDevicePixels only snaps the RENDER; the element itself can still be
                         laid out on a fractional device pixel, and at 125% or 150% scaling it is:
                         a 42px row is 52.5 device pixels, so every second row starts on a half
                         pixel and this box's 1px bottom edge lands across two of them. Split
                         between two rows of pixels a hairline is drawn at half strength against a
                         filled background, which is to say not drawn at all — the box looked open
                         at the bottom while its top, sitting on a whole pixel, was crisp.
                         Rounding the layout puts the whole box on device pixels, so both edges are
                         one solid line at any scaling. -->
                    <Border x:Name="box" Height="32" Margin="6,4"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <!-- The editor that replaces this wears AppTextBox, whose focus state is a
                             2px accent border. Matching it means the transition is invisible. -->
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="box" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGrid" TargetType="DataGrid" BasedOn="{StaticResource DataGridStyle}">
        <!-- Read-only by default. WPF's default is editable, and a DataGridTextColumn binds TwoWay,
             so every display grid in the app let you double-click an invoice number and type over
             it. Nothing was ever written back — the edit just sat there looking real until the next
             refresh. The two genuinely editable grids set IsReadOnly="False" on themselves. -->
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppColumnHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource AppRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource AppCell}"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Status as a chip, like the reference table's Closed / In progress pills. -->
    <DataTemplate x:Key="StatusChip">
        <Border x:Name="pill" CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="label" Text="{Binding Status, Converter={StaticResource StatusWord}}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="POSTED">
                <Setter TargetName="pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="DRAFT">
                <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Ageing bucket as a chip: anything overdue reads red at a glance. -->
    <DataTemplate x:Key="BucketChip">
        <Border x:Name="pill" CornerRadius="999" Padding="10,3" HorizontalAlignment="Left"
                Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="label" Text="{Binding AgeBucket}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding AgeBucket}" Value="not due">
                <Setter TargetName="pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding AgeBucket}" Value="1-30">
                <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= BUTTONS =================
         The design's own styles, with the spacing and focus behaviour the app needs so every
         toolbar reads the same. The dotted focus rectangle is WPF's default, not a design choice. -->

    <Style x:Key="AppButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="86"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- No right margin: the primary action is always last in a right-aligned row, so the 8px that
         separates the others just pushed it out of line with the grid edge above it. -->
    <Style x:Key="AppPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="86"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <!-- The base template dims a disabled button to 45% opacity. On the outline buttons that
                 reads clearly as "off", but 45% of a saturated accent is still a confident blue —
                 "Record receipt" looked live while it was disabled, so clicking it appeared to do
                 nothing. A disabled primary drops to the neutral surface instead of a faded accent. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppComboBox" TargetType="ComboBox" BasedOn="{StaticResource FieldComboBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <Style x:Key="AppTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Header numeric fields (broker %, terms). Same box as every other input — the in-grid
         numeric style is deliberately borderless and looked broken out here. -->
    <Style x:Key="AppNumericTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Padding" Value="8,0"/>
        <!-- Set here rather than per box: a binding to a decimal fails SILENTLY on bad input,
             keeping the old value while the box shows the typed text. Every numeric field in the
             app gets the guard by virtue of wearing this style. -->
        <Setter Property="ui:NumericInput.IsNumeric" Value="True"/>
    </Style>

    <!-- ================= PASSWORD =================
         The stock PasswordBox keeps Windows' own chrome, so it read as a foreign control sitting
         under two on-token text fields. Same template as FieldTextBox — PasswordBox exposes the
         same PART_ContentHost, so the design's field can be reused verbatim. -->

    <Style x:Key="AppPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusControl}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= DATE FIELD =================
         The stock DatePicker draws its own nested box and clipped the text. Strip the inner
         chrome and let the outer border be the field, like every other input. -->

    <Style TargetType="prim:DatePickerTextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="prim:DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDatePicker" TargetType="DatePicker">
        <!-- Load-bearing. DatePicker builds its own Calendar and binds its Style to THIS property:
               _calendar.SetBinding(StyleProperty, new Binding("CalendarStyle") { Source = this })
             A binding is a local value, and a local value suppresses implicit-style lookup — so the
             implicit <Style TargetType="Calendar"> could never reach it. Left unset, the binding
             resolved to null and the popup fell back to the STOCK calendar template, whose
             PART_MonthView carries Margin="6,-1,6,6" while the header row does not. That mismatch
             is what put a gap down both sides of the popup.
             DynamicResource, not StaticResource: AppCalendar is declared later in this file. -->
        <Setter Property="CalendarStyle" Value="{DynamicResource AppCalendar}"/>
        <!-- 32, not 34: this is an input and sits in a row of them. 34 is the BUTTON height, and
             borrowing it made the date field two pixels taller than every field beside it. -->
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusControl}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <prim:DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Center"/>

                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Style="{StaticResource IconButton}">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.3" Fill="Transparent"
                                      Data="M2,3 h12 v11 h-12 z M2,6.5 h12 M5,1.5 v3 M11,1.5 v3"/>
                            </Button>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   StaysOpen="False" PlacementTarget="{Binding ElementName=bd}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= CALENDAR =================
         The stock calendar is Windows-98 grey against this palette. Same surface, border and
         accent as the rest of the app; days become round targets instead of grey rectangles. -->

    <!-- Day cells, after the reference calendar: roomy squares, weekends in accent,
         today ringed rather than filled, selection filled. -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Width, not MinWidth. MinWidth only sets a floor, so the seven columns were still free
             to size themselves to their content — two digits, about 22px — which left the month
             grid narrower than the "July 2026" header above it. The header then decided the
             calendar's width and the day grid floated in the middle of it, which is the gap down
             both sides. Fixed columns make the grid 7 x 36 = 252px and the header follow IT. -->
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="bd" CornerRadius="6" Margin="1" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1.4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        </Trigger>
                        <!-- Today: filled with the SOFT accent, ringed in the solid one.
                             Three goes at this, and each failure said what the mark has to do:
                               green outline  wrong colour, and green is this app's "that worked"
                               blue outline   right colour, wrong mark - an outline beside a fill
                                              still read as two different calendars
                               blue fill      right mark, but identical to a selected day, so
                                              picking the 21st lit the 20th just as brightly and
                                              the calendar showed two selections
                             AccentSoftBrush is the same blue at a tenth of the weight, so today
                             is plainly filled and plainly not the selection. The ring keeps it
                             legible when a pale theme makes the tint nearly invisible.
                             No Foreground here: the number stays TextBrush, which is what reads on
                             a tint. OnAccent is white, and white on #E7F0FF is not a number. -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>

                        <!-- Blacked out: a day the range will not accept.
                             The Dashboard bounds its own pair: picking a From of 27 Aug blacks
                             out 1..26 on the To calendar, which is right, and SetBlackout's own
                             comment says it "strikes through the days that would invert the range".
                             Nothing struck through: this template replaced the stock one, and the
                             stock one is where that mark lived. So a blacked-out day rendered
                             identically to a selectable one, right down to the hand cursor, and
                             clicking it did nothing with nothing on screen to say why. "I cannot
                             select any dates", because the dates on offer were the five at the
                             end of the month and the other twenty-six looked exactly the same.

                             AFTER IsToday and IsSelected so it wins over both: today is blacked
                             out on the To calendar whenever From is later than today, and it must
                             not sit there looking available.

                             Opacity carries the weight of this, not Foreground. Style triggers
                             outrank template triggers, so the weekend colour below beats any
                             Foreground set here: a blacked-out Saturday would stay bright blue.
                             Opacity is set nowhere else, so it always applies. -->
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="Transparent"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Trigger>

                        <!-- LAST, so it wins over IsSelected above. 27 July is also a trailing cell
                             of the August grid: selecting it drew an accent box in BOTH months, and
                             the old version of this trigger then forced the number to muted-at-50%
                             opacity ON that accent fill — a blue box with no readable date in it.
                             Collapsing the Border rather than the button: CalendarItem assigns the
                             button's Visibility as a LOCAL value, which outranks every trigger. -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="bd" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A day button's DataContext is its DateTime, so weekends can colour themselves. -->
            <DataTrigger Binding="{Binding DayOfWeek}" Value="Saturday">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DayOfWeek}" Value="Sunday">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>

            <!-- MUST come after the weekend triggers, and must live here rather than in the
                 template. Style triggers outrank ControlTemplate triggers, so the template's
                 IsSelected foreground lost to the weekend colour — and since the selected cell is
                 filled with AccentBrush, a selected Saturday or Sunday was accent-on-accent: a
                 solid blue box with the date invisible inside it. Later trigger wins, so this one
                 does. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            </Trigger>

            <!-- The hand cursor is set on the style, so only the style can take it back. A
                 pointer that says "click me" over a day that refuses is the whole complaint in one
                 gesture. -->
            <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>

            <!-- A neighbouring month's day must not be clickable when it is not drawn. Its VISUAL
                 is hidden in the template below — CalendarItem assigns Visibility on every day
                 button as a LOCAL value, which outranks any trigger, so that property is not ours
                 to set. IsHitTestVisible it never touches. -->
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- NOTE: the Sun…Sat heading template lives in the Calendar's ControlTemplate.Resources at the
         bottom of this file, NOT here. CalendarItem resolves it with
             Owner.Template.Resources[DayTitleTemplateResourceKey]
         — the CALENDAR'S template, not the application's. Declared at app level it was never found,
         so CalendarItem fell back to `new ContentControl()`, which renders nothing: the headings
         measured 36 x 0 and the whole row was invisible. -->

    <!-- Month / year picker buttons behind the header.
         4 x 63 = 252, the same width the 7 x 36 day grid occupies, so switching to the year view
         does not resize the popup. -->
    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="63"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="bd" CornerRadius="6" Margin="2" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        </Trigger>
                        <!-- CalendarButton has no IsSelected — it exposes HasSelectedDays instead. -->
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header chevrons. Explicit style: the app's implicit Button style carries padding and a
         min width that would push these off the 32px square the header row allots them. -->
    <!-- Filled accent squares, paired at the right of the header — after the reference calendar.
         AccentStrongBrush, not AccentBrush: white glyphs on the lighter accent measured 3.2:1,
         under WCAG AA. Same reason the primary button uses it (docs/12 §3c). -->
    <Style x:Key="CalendarNavButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource AccentStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentStrongHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "July 2026" — left-aligned and prominent, click to zoom out to months, then years. -->
    <Style x:Key="CalendarHeaderButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="2,0">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== THE ACTUAL FIX ==========
         CalendarItem lays out the header, the day names and the date cells. Restyling its children
         could never align them, because the STOCK template insets the day grid and the header by
         different amounts: PART_MonthView carries a hardcoded Margin="6,-1,6,6" that the header row
         above it does not, and the whole thing sits inside a second Border of BorderThickness="2".
         So the header was 12px wider than the grid and offset from it, and every adjustment to
         widths or padding just moved both by the same amount.

         This template puts the header and the month view in ONE grid, on the SAME edges, with no
         hidden margins. 7 x 36 = 252px decides the width; everything else follows it. -->
    <Style x:Key="AppCalendarItem" TargetType="CalendarItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- CalendarItem builds the Sun…Sat cells in code, and only uses a
                             DataTemplate if it can resolve DayTitleTemplateResourceKey from
                             Owner.Template.Resources at that moment. It cannot — Owner is not wired
                             up yet — so it falls back to `new ContentControl()`, which measured
                             36 x 0 and left the heading row invisible.
                             Styling the fallback is what actually reaches those cells. Scoped to
                             this template, so no other ContentControl in the app is touched. -->
                        <Style TargetType="ContentControl">
                            <!-- Load-bearing. SetDayTitles assigns the day name to the cell's
                                 DataContext, not its Content — it expects a DataTemplate binding
                                 {Binding} to pick it up. A bare ContentControl therefore has a
                                 DataContext and NO content, and renders nothing at all. Sizing it
                                 was not enough: the row measured 36 x 26 and stayed blank. -->
                            <!-- Named from the column, not from the DataContext: WPF supplies
                                 ShortestDayNames there, which is one letter — two "S"s and two
                                 "T"s in a row nobody can read. -->
                            <Setter Property="Content"
                                    Value="{Binding RelativeSource={RelativeSource Self},
                                                    Converter={StaticResource DayTitle}}"/>
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="26"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- header -->
                            <RowDefinition Height="Auto"/>   <!-- divider -->
                            <RowDefinition Height="Auto"/>   <!-- month / year view -->
                        </Grid.RowDefinitions>

                        <!-- Header, after the reference: month and year on the left, the two
                             chevrons paired on the right. Still exactly the grid's 252px, so the
                             right-hand chevron ends flush with the Saturday column. -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_HeaderButton" Grid.Column="0"
                                    Style="{StaticResource CalendarHeaderButton}"/>

                            <Button x:Name="PART_PreviousButton" Grid.Column="1" Margin="0,0,6,0"
                                    Style="{StaticResource CalendarNavButton}"
                                    AutomationProperties.Name="Previous month">
                                <Path Data="M6.5,2 L2.5,6 L6.5,10" Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Button>

                            <Button x:Name="PART_NextButton" Grid.Column="2"
                                    Style="{StaticResource CalendarNavButton}"
                                    AutomationProperties.Name="Next month">
                                <Path Data="M2.5,2 L6.5,6 L2.5,10" Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="1.6" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Button>
                        </Grid>

                        <!-- Hairline under the header, as in the reference. -->
                        <Border Grid.Row="1" Height="1" Margin="0,0,0,6"
                                Background="{DynamicResource BorderBrush}"/>

                        <!-- Row 0 holds Sun…Sat, rows 1-6 the dates. Auto everywhere: the children
                             are a fixed 36x32, so the grid measures to exactly 252 x 224 and there
                             is no slack for anything to drift in. -->
                        <Grid x:Name="PART_MonthView" Grid.Row="2" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>

                        <!-- Month and year pickers. 4 x 63 = the same 252, so the popup keeps its
                             size when you click the header. -->
                        <Grid x:Name="PART_YearView" Grid.Row="2" Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- The header button is not a month picker in the year view; the stock
                             template disables it the same way. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keyed AND implicit. The key is what DatePicker needs (see AppDatePicker's CalendarStyle
         setter); the implicit alias keeps a standalone <Calendar/> looking the same. -->
    <Style x:Key="AppCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource {x:Type CalendarDayButton}}"/>
        <Setter Property="CalendarButtonStyle" Value="{DynamicResource {x:Type CalendarButton}}"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource AppCalendarItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <!-- THE ONLY PLACE THIS WORKS. CalendarItem reads the heading template from
                         Owner.Template.Resources — this dictionary. Anywhere else and it silently
                         falls back to an empty ContentControl. -->
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static prim:CalendarItem.DayTitleTemplateResourceKey}">
                            <!-- Width matches CalendarDayButton exactly, so Sun…Sat sit one per
                                 column instead of collapsing to "SunMonTue". -->
                            <TextBlock Text="{Binding}" Width="36" Height="26" TextAlignment="Center"
                                       Padding="0,6,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <!-- The card itself: rounded, padded, floating — the reference's proportions.
                         16px all round is what gives the grid room to breathe. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14" Padding="16"
                            Effect="{DynamicResource PopupShadow}">
                        <prim:CalendarItem x:Name="PART_CalendarItem"
                                           Style="{TemplateBinding CalendarItemStyle}"
                                           Background="{TemplateBinding Background}"
                                           BorderThickness="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar" BasedOn="{StaticResource AppCalendar}"/>


  <!-- ── Master data · card sections ──────────────────────────────────────────
       Each section is a panel: surface, hairline border, one corner radius, one
       padding. Before this the grids sat directly on the page background and ran
       into each other with nothing to say where one ended.                    -->
  <Style x:Key="MasterCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
    <Setter Property="Padding" Value="16,14,16,14"/>
  </Style>

  <Style x:Key="MasterTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>

  <Style x:Key="MasterHint" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,-6,0,10"/>
  </Style>

  <!-- Grids inside the cards: taller rows, horizontal rules only, and a full
       outer border so the table reads as bounded on all four sides. The Invoices
       grid stops at a hairline under the last row, which leaves the table
       looking unfinished at the bottom. -->
  <Style x:Key="MasterGrid" TargetType="DataGrid" BasedOn="{StaticResource AppDataGrid}">
    <Setter Property="RowHeight" Value="30"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="AlternationCount" Value="2"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource DeskBrush}"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <!-- Every add-action the same size, on the same baseline as the inputs beside
       it. They were three unstyled buttons at three different widths. -->
  <Style x:Key="MasterAction" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="104"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <!-- A DataGridCheckBoxColumn left-aligns its box under a centred header, so
       the tick floats away from the column it belongs to. -->
  <Style x:Key="CentredCheck" TargetType="CheckBox">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ── Tooltips that stay on the screen ────────────────────────────────────
       A tooltip is a Popup, so it was never CLIPPED by a card or a scroll viewer: popups render
       above every container by construction. What went wrong is simpler and worse: a tooltip
       carrying a long value laid its text out as ONE unwrapped line. stock_sheet_rates is a
       semicolon-separated sheet layout, so the tooltip measured a few thousand pixels wide and ran
       off both edges of the monitor, with the middle of the value the only part on screen.

       No placement logic can rescue that. WPF already flips and nudges a popup to keep it inside
       the monitor's work area; it just cannot fit something wider than the monitor. Bounding the
       width is what lets the built-in positioning do its job, which is why there is no custom
       placement code here and no offsets to maintain.

       MaxWidth alone would not have been enough: a TextBlock that does not wrap simply clips at the
       boundary, trading text that runs off screen for text that silently disappears. The width and
       the wrapping only work as a pair.

       IMPLICIT, so it covers every tooltip in the app rather than the three long-value ones that
       happened to be reported. The single tooltip whose content is a composed panel rather than a
       string opts out at its own declaration; see MainWindow.xaml. -->
  <Style TargetType="ToolTip">
    <!-- Wide enough for a long value to read in a few lines, narrow enough to sit beside the
         control it describes on a laptop screen rather than covering it. -->
    <Setter Property="MaxWidth" Value="520"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <!-- {Binding} is the tooltip's content, which for every tooltip using this template is
               the string itself. -->
          <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
