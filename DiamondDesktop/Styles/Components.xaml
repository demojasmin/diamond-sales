<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ═══════════════════════════════════════════════════════════════════════
       Component library · Stage 1

       Styles only. Nothing here has code-behind, so adding it cannot introduce
       a runtime failure the way a new Window can — everything is opt-in by key
       and no existing screen changes until a page asks for one of these.

       Merged AFTER AppOverrides.xaml, because several styles here derive from
       AppDataGrid / AppPrimaryButton and StaticResource only sees dictionaries
       already loaded.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Softer, larger radii than the existing tokens: 14 for panels, 10 for
       fields. The current RadiusCard stays where it is so nothing shifts. -->
  <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
  <CornerRadius x:Key="RadiusField">10</CornerRadius>
  <CornerRadius x:Key="RadiusBadge">999</CornerRadius>

  <!-- ── CardContainer ─────────────────────────────────────────────────────
       The one surface every section sits on. Shadow is deliberately faint:
       0.07 reads as a lifted sheet, anything heavier reads as a dialog.      -->
  <Style x:Key="CardContainer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
    <Setter Property="Padding" Value="20,18,20,18"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.07" Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Borderless: on a list card the outer rule fights the row separators, and the
       shadow already lifts it off the page. -->
  <Style x:Key="CardContainerSoft" TargetType="Border" BasedOn="{StaticResource CardContainer}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="18,16,18,16"/>
  </Style>

  <!-- A card with no padding, for when the table should meet the card edge. -->
  <Style x:Key="CardContainerFlush" TargetType="Border" BasedOn="{StaticResource CardContainer}">
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- ── Section headers ───────────────────────────────────────────────────── -->
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CardSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ── CountBadge · the "23" beside a section title ──────────────────────── -->
  <Style x:Key="CountBadge" TargetType="Border">
    <!-- DeskBrush is the dark navigation token; a muted grey number on it was unreadable. -->
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusBadge}"/>
    <Setter Property="Padding" Value="9,2,9,2"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CountBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ── StatusBadge · Active / Inactive pill ──────────────────────────────
       A DataTemplate rather than a style, so a DataGridTemplateColumn can use
       it directly against a bool. Read-only by design: nothing here writes
       grade.active, because no API does.                                     -->
  <DataTemplate x:Key="StatusBadgeTemplate">
    <Border CornerRadius="{StaticResource RadiusBadge}" Padding="10,2,10,3"
            HorizontalAlignment="Left" VerticalAlignment="Center">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Active}" Value="False">
              <Setter Property="Background" Value="{DynamicResource DeskBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock FontSize="11.5" FontWeight="SemiBold">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="Active"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Active}" Value="False">
                <Setter Property="Text" Value="Inactive"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>
  </DataTemplate>

  <!-- ── Party row · one line per buyer or broker ──────────────────────────
       A three-column grid in a 450px card squeezes every column and still grows
       its own scrollbars. A row list gives the name the space it needs and puts
       the figure and status where the eye already expects them.               -->
  <Style x:Key="PartyRow" TargetType="Border">
    <Setter Property="Padding" Value="12,10,12,11"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <!-- Hairline between rows only; the last one is trimmed by the card padding. -->
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PartyName" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PartyMeta" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="Margin" Value="0,3,10,0"/>
  </Style>

  <!-- ── SearchBar ─────────────────────────────────────────────────────────
       Watermark via a trigger on the control's own Text, so it needs no
       converter and no code-behind.                                          -->
  <Style x:Key="SearchBar" TargetType="TextBox">
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Shell" Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusField}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                         FontSize="13" Margin="11,0,7,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}"/>
              <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="0,0,30,0"
                            VerticalAlignment="Center"/>
              <TextBlock x:Name="Watermark" Grid.Column="1" Text="Search…" Margin="2,0,30,0"
                         VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── FilterDropdown ────────────────────────────────────────────────────
       Derives from the app's combo so the popup, item template and theme
       behaviour stay identical; only the metrics change.                     -->
  <Style x:Key="FilterDropdown" TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="140"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ── DataTable ─────────────────────────────────────────────────────────
       Roomier rows, horizontal rules only, a full outer border so the table is
       bounded on all four sides, and a hover row. EnableRowVirtualization stays
       on: these grids hold 1400+ rows elsewhere in the app.                   -->
  <Style x:Key="DataTable" TargetType="DataGrid" BasedOn="{StaticResource AppDataGrid}">
    <Setter Property="RowHeight" Value="38"/>
    <Setter Property="ColumnHeaderHeight" Value="38"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <!-- WPF's default grid-line brush is near-black. Left alone it draws a heavy rule under every
         row; this is the same hairline the rest of the app's tables use. -->
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
  </Style>

  <!-- Column headers: quieter, uppercase-weight, with a rule underneath. The
       header stays put while rows scroll — DataGrid pins it by default, which
       is the "sticky header" behaviour, provided the grid itself scrolls
       rather than sitting inside another ScrollViewer. -->
  <Style x:Key="TableHeader" TargetType="DataGridColumnHeader"
         BasedOn="{StaticResource AppColumnHeader}">
    <Setter Property="Height" Value="38"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <!-- Inherits SurfaceBrush from AppColumnHeader. DeskBrush is the dark navigation-panel
         token, which is what made the header render black in both themes. -->
  </Style>

  <!-- ── Tabs ──────────────────────────────────────────────────────────────
       Underline tabs rather than folder tabs: quieter, and it reads as a
       section switch instead of a second window.                             -->
  <Style x:Key="SectionTabs" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,14,0,0"/>
  </Style>

  <Style x:Key="SectionTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Shell" Background="Transparent" Padding="2,0,2,0" Margin="0,0,22,0">
            <StackPanel>
              <ContentPresenter ContentSource="Header" Margin="0,0,0,9"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border x:Name="Rule" Height="2" CornerRadius="1" Background="Transparent"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              <Setter TargetName="Rule" Property="Background" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Toast ─────────────────────────────────────────────────────────────
       A surface for a transient message. Shown and hidden by whichever page
       owns it; nothing here animates on its own.                             -->
  <Style x:Key="Toast" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
    <Setter Property="Padding" Value="14,10,16,10"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="0,0,22,22"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.16" Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToastSuccess" TargetType="Border" BasedOn="{StaticResource Toast}">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
  </Style>

  <Style x:Key="ToastDanger" TargetType="Border" BasedOn="{StaticResource Toast}">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
  </Style>

  <!-- ── Skeleton · placeholder bar while a read is in flight ──────────────── -->
  <Style x:Key="Skeleton" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource DeskBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusField}"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Opacity" Value="0.85"/>
  </Style>

  <!-- ── Form field · label above control, consistent metrics ─────────────── -->
  <Style x:Key="FormField" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <!-- Deliberately NOT BasedOn the window's "Lbl": that style lives in MainWindow.Resources, and an
       application-level dictionary cannot see a window-level key. Deriving from it threw
       XamlParseException the moment MainWindow was constructed. Same look, declared standalone. -->
  <Style x:Key="FormLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>

  <Style x:Key="FormInput" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="FormNumeric" TargetType="TextBox" BasedOn="{StaticResource AppNumericTextBox}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- ── Buttons · one height, one min width, everywhere ───────────────────── -->
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="112"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource AppButton}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <!-- ── Empty state · larger and calmer than the inline EmptyHint ─────────── -->
  <Style x:Key="EmptyStateTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <Style x:Key="EmptyStateBody" TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="MaxWidth" Value="320"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>

</ResourceDictionary>
