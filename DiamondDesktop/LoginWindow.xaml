<Window x:Class="DiamondDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{StaticResource AppIcon}" Title="Sign in" SizeToContent="Height" Width="440" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5" TextOptions.TextFormattingMode="Ideal">

  <Grid>
    <Grid.Background>
      <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.8" RadiusY="0.7">
        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource BgColor}" Offset="0.7"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Border Style="{StaticResource Card}" Margin="26" Padding="30">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
          <!-- The app's stone, not a square turned 45°. This window is the first thing anyone
               sees, and it was showing a different mark from every screen behind it. -->
          <Rectangle Width="20" Height="20" Fill="{StaticResource BrandStone}"/>
          <TextBlock Text="Solitaire Desk" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Text="Sign in" Style="{StaticResource H1Text}" Margin="0,0,0,4"/>
        <TextBlock Text="AUTH-001 · every action is attributed to you"
                   Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,22"/>

        <!-- No server field: the Supabase URL is fixed and the anon key ships in the binary by
             design. RLS is the security boundary, not the key. -->
        <TextBlock Text="EMAIL" Style="{StaticResource LabelCaps}" Margin="0,0,0,5"/>
        <TextBox x:Name="UserBox" Style="{StaticResource FieldTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="PASSWORD" Style="{StaticResource LabelCaps}" Margin="0,0,0,5"/>
        <!-- Nothing is pre-filled. These are real credentials to a live cloud database now, so a
             password in source would ship to every trading-floor machine. The UI tests supply
             SOLITAIRE_EMAIL / SOLITAIRE_PASSWORD instead. -->
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}"
                     Margin="0,0,0,20"/>

        <Button x:Name="SignIn" Content="Sign in" Style="{StaticResource PrimaryButton}"
                Height="38" IsDefault="True" Click="SignIn_Click"/>

        <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
