<Window x:Class="DiamondDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" SizeToContent="Height" Width="440" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5" TextOptions.TextFormattingMode="Ideal">

  <Grid>
    <Grid.Background>
      <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.8" RadiusY="0.7">
        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource BgColor}" Offset="0.7"/>
      </RadialGradientBrush>
    </Grid.Background>

    <Border Style="{StaticResource Card}" Margin="26" Padding="30">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
          <Rectangle Width="16" Height="16" Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2"
                     RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
          </Rectangle>
          <TextBlock Text="Solitaire Desk" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <TextBlock Text="Sign in" Style="{StaticResource H1Text}" Margin="0,0,0,4"/>
        <TextBlock Text="AUTH-001 · every action is attributed to you"
                   Style="{StaticResource MutedText}" FontSize="12.5" Margin="0,0,0,22"/>

        <TextBlock Text="SERVER" Style="{StaticResource LabelCaps}" Margin="0,0,0,5"/>
        <TextBox x:Name="ServerBox" Style="{StaticResource FieldTextBox}" Text="http://localhost:5000" Margin="0,0,0,14"/>

        <TextBlock Text="USERNAME" Style="{StaticResource LabelCaps}" Margin="0,0,0,5"/>
        <TextBox x:Name="UserBox" Style="{StaticResource FieldTextBox}" Text="owner" Margin="0,0,0,14"/>

        <TextBlock Text="PASSWORD" Style="{StaticResource LabelCaps}" Margin="0,0,0,5"/>
        <!-- ponytail: the seeded first-run password is pre-filled for local testing only.
             Delete this Password attribute before the app reaches a real server (D5). -->
        <PasswordBox x:Name="PasswordBox" Password="owner" Height="34" Padding="10,0"
                     VerticalContentAlignment="Center" Margin="0,0,0,20"
                     Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

        <Button x:Name="SignIn" Content="Sign in" Style="{StaticResource PrimaryButton}"
                Height="38" IsDefault="True" Click="SignIn_Click"/>

        <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
