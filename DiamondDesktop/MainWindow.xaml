<Window x:Class="DiamondDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiamondDesktop"
        xmlns:ui="clr-namespace:DiamondDesktop"
        Icon="{StaticResource AppIcon}" Title="Solitaire Desk — Diamond Sales &amp; Inventory" Height="880" Width="1440"
        MinHeight="700" MinWidth="1160" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5">

  <Window.Resources>
    <!-- Implicit styles: every control on every screen inherits the design system without
         each of the eleven views being rewritten. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGrid}"/>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}"/>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBox}"/>

    <!-- Left-aligned on request, headers and figures alike, across every grid in the app.
         The convention this replaces put numbers on the right so their decimal points line up in a
         column; noted, asked about, and decided otherwise. The mono/tabular figures are kept, so
         digits still occupy equal width. -->
    <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <!-- Money columns are capped so one freak figure cannot widen a table past its half of the
           page. The cap can only bite by trimming, so the full figure has to stay reachable. -->
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <!-- The in-grid editor gets the same keystroke guard as the header fields: a bad character in
         Weight or Price silently kept the previous value and recomputed Amount from it. -->
    <Style x:Key="NumEdit" TargetType="TextBox" BasedOn="{StaticResource CellNumericTextBox}">
      <Setter Property="local:NumericInput.IsNumeric" Value="True"/>
      <!-- The field style's 7px side padding costs 14px of a 29px cell, leaving 13px — one glyph.
           Typing "12.5" into Less 1 scrolled every character but the last out of sight, which
           reads as a field that will not accept input. Narrower padding buys 8px back in every
           numeric editor without moving a single column. -->
      <Setter Property="Padding" Value="3,0,3,0"/>
      <!-- Same edge as the display style above, or the figure jumps sideways the moment you
           start typing in the cell. -->
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <local:EmptyToVisibilityConverter x:Key="Empty"/>
    <!-- Money in short form: 125.00 K, 12.50 M, 1.25 B. Display only — the bound property keeps
         its decimal, sorting and filtering work on that decimal, and the CSV export reads the
         property rather than the cell, so nothing downstream changes. -->
    <local:ShortMoneyConverter x:Key="Money"/>
    <BooleanToVisibilityConverter x:Key="Bool"/>
    <!-- A DatePicker deals in DateTime?; a due date is a DateOnly, which is what the database
         stores and what Calc.DueDate returns. One converter rather than a shadow DateTime property
         on the line, so there is still exactly one due date. -->
    <local:DateOnlyConverter x:Key="DateOnly"/>

    <!-- A count and a noun that agrees with it: the Sales entry chip read "1 lines". -->
    <local:CountLabelConverter x:Key="CountLabel"/>

    <!-- "Nothing here yet", shared so every grid says it the same way. Sits over the grid body:
         a DataGrid with no rows is otherwise a header and a blank rectangle, which reads as a
         failure rather than as an empty result. Bind Visibility to the grid's Items.Count. -->
    <!-- Placeholder inside a grid cell. Not hit-testable, so it never intercepts the click that
         opens the drop-down behind it; padding matches the combo's so the text does not shift
         when a value replaces it. -->
    <!-- A cell holding a ComboBox has three things competing for its width: the standard 14px cell
         padding on each side, the combo's own 10/8 padding, and a 26px chevron. On a 90px Size
         column that left about 18px for the text, so "+11" rendered as "+1". These cells give the
         padding back — the combo supplies its own.
         No EventSetter here, unlike the grid's CellStyle: Cell_Down only acts on text columns, and
         these cells have CellCombo_Down on the ComboBox itself. -->
    <Style x:Key="ComboCell" TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
      <Setter Property="Padding" Value="4,0"/>
    </Style>

    <!-- Vertical rule between toolbar groups. The design package's Divider is the horizontal one;
         this is the same hairline stood on its end, so a toolbar reads as related clusters rather
         than one undifferentiated row of controls. -->
    <Style x:Key="ToolbarSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="4,0,14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- The header's own placeholder. CellPlaceholder is built for a 26px grid cell; these
         combos are the full 32px field height and sit left-aligned inside a Grid that stretches,
         so the hint needs its own left inset and must not centre itself across the field. -->
    <Style x:Key="FieldPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="CellPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="11,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Actions that operate on the selected row. They were always enabled, so clicking Print bill
         with nothing selected just printed "Select an invoice first" to the status bar — which
         reads as a broken button, not as a precondition. Disabled is the honest state. -->
    <Style x:Key="NeedsRowButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NeedsRowPrimary" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Same idea for the Stock page, whose action depends on a row in a different grid. -->
    <Style x:Key="NeedsStockRow" TargetType="Button" BasedOn="{StaticResource AppButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=StockGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NeedsRowDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,56,12,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <!-- Centred and unwrapped, a long line runs off both ends of a narrow panel: the movements
           drawer is 340px and showed "...thing has been taken in, sold or adjusted in this buck". -->
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- SizeCodeTemplate, GradeNameTemplate, GradeItemContainer and SizeItemContainer used to
         live here. They are in Styles/Catalogue.xaml now, with the GradePicker and SizePicker
         styles that bundle them. Window.Resources is a scope no other window can see, and
         UpdateInvoiceDialog referenced these four by name from outside it. -->
    <DataTemplate x:Key="NameTemplate">
      <TextBlock Text="{Binding Name}"/>
    </DataTemplate>

    <!-- The accessible name has to live on the CONTAINER. WPF's ComboBoxItemAutomationPeer names an
         item from the item itself, and with an ItemTemplate there is nothing to read, so it falls
         back to ToString() on the model — a database wire type. Every entry in the Grade list
         announced itself to a screen reader as "DiamondDesktop.Data.Grade", twenty-three times.
         Putting the name on the TextBlock inside the template does NOT fix it; the peer never
         looks there. Measured, not assumed. -->
    <Style x:Key="PartyItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Label + field, kept together so a wrap can never separate them. -->
    <Style x:Key="FieldPair" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>

    <!-- ItemHeight gives every wrapped row the same pitch: 32px control + 8px gutter. Without it
         a row containing the taller DatePicker sets its own height and the rows drift apart. -->
    <Style x:Key="FieldRowPanel" TargetType="WrapPanel">
      <Setter Property="ItemHeight" Value="40"/>
    </Style>
    <Style x:Key="Total" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
    <Style x:Key="Kpi" TargetType="TextBlock" BasedOn="{StaticResource MonoDisplay}"/>

    <!-- Icon + label, matching the design's NavButton. The header stays a plain string — it is the
         key Tabs_Changed and ScreenSubtitles look up — so the icon is picked from that string here
         rather than by rebuilding every header as a panel. -->
    <DataTemplate x:Key="NavHeader">
      <StackPanel Orientation="Horizontal">
        <Path x:Name="icon" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0"
              StrokeThickness="1.4" Fill="Transparent"
              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
              Data="M4,2.5 h12 v15 h-12 z M7,7.5 h6 M7,10.5 h6 M7,13.5 h4"/>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="Invoices">
          <Setter TargetName="icon" Property="Data" Value="M3,4.5 h14 M3,9 h14 M3,13.5 h14 M3,17.5 h8"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Receivables">
          <Setter TargetName="icon" Property="Data" Value="M10,2.8 A7.2,7.2 0 1,0 10,17.2 A7.2,7.2 0 1,0 10,2.8 M6.8,10.4 h6.4 M8.4,7.6 h3.2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Stock">
          <Setter TargetName="icon" Property="Data" Value="M2.5,2.5 h4 v4 h-4 z M8,2.5 h4 v4 h-4 z M13.5,2.5 h4 v4 h-4 z M2.5,8 h4 v4 h-4 z M8,8 h4 v4 h-4 z M13.5,8 h4 v4 h-4 z M2.5,13.5 h4 v4 h-4 z M8,13.5 h4 v4 h-4 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Intake &amp; movements">
          <Setter TargetName="icon" Property="Data" Value="M3,6 h9 M9,3 L12,6 L9,9 M17,14 h-9 M11,11 L8,14 L11,17"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Master data">
          <Setter TargetName="icon" Property="Data" Value="M2.8,4 h14.4 v4.4 h-14.4 z M2.8,11.6 h14.4 v4.4 h-14.4 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Dashboard">
          <Setter TargetName="icon" Property="Data" Value="M3,3 h6 v6 h-6 z M11,3 h6 v4 h-6 z M11,9 h6 v8 h-6 z M3,11 h6 v6 h-6 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Audit">
          <Setter TargetName="icon" Property="Data" Value="M10,3 A7,7 0 1,1 3,10 A7,7 0 0,1 10,3 M10,6 v4.6 l3.4,2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Users">
          <Setter TargetName="icon" Property="Data" Value="M10,3.6 A3.1,3.1 0 1,0 10,9.8 A3.1,3.1 0 1,0 10,3.6 M4,17 a6,6 0 0,1 12,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Settings">
          <Setter TargetName="icon" Property="Data" Value="M10,7 A3,3 0 1,0 10,13 A3,3 0 1,0 10,7 M10,3 A7,7 0 1,0 10,17 A7,7 0 1,0 10,3"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The tab strip becomes the nav rail, matching the design's NavButton.
         Selection colour goes on the header Border, NOT on the TabItem: a TabItem is the logical
         parent of its own page, so `Foreground` set here inherits straight into every unstyled
         TextBlock on that page and paints the whole screen accent-blue. -->
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HeaderTemplate" Value="{StaticResource NavHeader}"/>
      <!-- Load-bearing: a TabItem is the inheritance parent of its own page, so this is what every
           unstyled TextBlock on that page inherits. Drop it and they fall back to the property
           default — pure black — which is invisible on the dark theme. The accent for the selected
           nav item goes on the header Border below, never here, or it bleeds into the page. -->
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,1">
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,9,0,9"
                      CornerRadius="0,2,2,0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
              <Border x:Name="bd" CornerRadius="7" Background="Transparent" Padding="14,0" Margin="6,0,8,0"
                      TextElement.Foreground="{DynamicResource TextBrush}">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="bd" Property="TextElement.FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavTabs" TargetType="TabControl">
      <Setter Property="TabStripPlacement" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="4,14">
                  <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Style="{StaticResource LabelCaps}"
                             FontSize="10" Margin="20,6,0,10"/>
                  <TabPanel IsItemsHost="True" VerticalAlignment="Top"/>
                </DockPanel>
              </Border>
              <!-- The name is load-bearing, not decoration: TabItemAutomationPeer finds the selected
                   tab's content by looking up "PART_SelectedContentHost" on the TabControl. Unnamed,
                   every screen vanishes from the UIA tree — screen readers and UI automation see the
                   nav rail and nothing else. -->
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <DockPanel>
    <!-- top bar -->
    <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="ScreenTitle" Text="Sales entry" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="ScreenSub" Text="Keyboard-first invoice entry" FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Only visible when the outbox is holding something. A parked import that nothing on
               screen mentions cannot be told apart from one that was silently dropped. -->
          <Border x:Name="SyncPill" Height="26" CornerRadius="999" Visibility="Collapsed"
                  Background="{DynamicResource WarningSoftBrush}"
                  BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                  Padding="10,0" Margin="0,0,10,0"
                  ToolTip="Saved on this machine. Applied automatically when the connection returns.">
            <TextBlock x:Name="SyncPillText" FontSize="11.5" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
          </Border>
          <Border Height="26" CornerRadius="999" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="SyncText" Text="Connected" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </Border>
          <!-- The catalogue is read once at sign-in, so a grade or sieve added afterwards — by the
               office on another desk, or by an import that created one — stays invisible here until
               the session restarts. Restarting to see a new size is a poor trade, and it was the
               workaround actually being used. -->
          <Button x:Name="RefreshCatalogue" Content="Refresh" Click="RefreshCatalogue_Click"
                  Style="{StaticResource DashGoldButton}" Margin="0,0,10,0"
                  ToolTip="Reload grades, sizes, buyers and brokers from the database"
                  AutomationProperties.Name="Refresh the catalogue"/>
          <!-- Named for a reason: with no x:Name and no AutomationProperties.Name a screen reader
               announces this only as "button", and automation can't address it at all. -->
          <Button x:Name="ThemeToggle" Style="{StaticResource IconButton}" Click="ThemeToggle_Click"
                  ToolTip="Light / dark" AutomationProperties.Name="Toggle light or dark theme"
                  Margin="0,0,10,0">
            <Grid Width="14" Height="14">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
              <Path Data="M7,0 A7,7 0 0,1 7,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Grid>
          </Button>
          <!-- The brand mark rather than initials, matching the one every page header carries.
               Initials stays in the tree, collapsed: it is what the window sets on sign-in and what
               names this chip to a screen reader, so removing it would take the only spoken clue
               about who is signed in with it. -->
          <ContentControl Style="{StaticResource BrandMarkSmall}"
                          AutomationProperties.Name="{Binding Text, ElementName=Initials}"
                          ToolTip="{Binding Text, ElementName=WhoAmI}">
            <TextBlock x:Name="Initials" Text="?" Visibility="Collapsed"/>
          </ContentControl>
          <TextBlock x:Name="WhoAmI" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
          <!-- Next to who is signed in, because that is where somebody looks when they want to
               stop being that person. Two databases behind one build make this necessary rather
               than convenient: without it, changing account means closing the application. -->
          <Button x:Name="SignOut" Content="Sign out" Click="SignOut_Click"
                  Style="{StaticResource DashButton}" Margin="12,0,0,0"
                  ToolTip="Sign out and return to the login screen"
                  AutomationProperties.Name="Sign out"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
      <!-- Transparent, not unset: a TextBlock with no background is not hit-testable, and the
           click-to-dismiss wired in the constructor would never fire. -->
      <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}" TextWrapping="NoWrap"
                 Background="Transparent" ToolTipService.InitialShowDelay="400"/>
    </Border>

    <!-- Pages, with the loading veil over them. A 3px bar at the top of the window was too quiet
         to answer "is this screen broken or still fetching?" — the grid underneath was empty
         either way.

         The veil covers the workspace, and the nav sidebar with it: the sidebar is drawn by the
         TabControl's own template, so anything laid over the control covers both. That means no
         navigating away mid-load. The title bar, connection pill and status bar stay live, so the
         window still reads as responsive rather than hung.

         Every read funnels through Read<T>, which raises and lowers it — one place, all ten
         screens. -->
    <Grid>
      <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavTab}"
                  SelectionChanged="Tabs_Changed">

      <!-- ══ SALES-001/003 · sales entry ══════════════════════════════════ -->
      <TabItem Header="Sales entry" x:Name="SalesEntryTab">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">
          <!-- This card is the page header as well as the invoice's own fields: the page opens
               with it, so giving it a second header above would cost a keyboard-first entry screen
               70px of the room it types into. Same card, same mark, same title style as the rest. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <DockPanel>
              <!-- Everything below this line is the form exactly as it was: same fields, same
                   order, same bindings, same automation names. -->
              <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sales entry" Style="{StaticResource PageHeaderTitle}"/>
                    <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                      <!-- LineCount, not the grid's Items.Count. The grid always carries one row
                           to type into, so counting rows called an untouched screen "1 line" while
                           the hint underneath it said nothing had been typed yet. LineCount counts
                           RealLines, which is the same figure the totals and Confirm sale use. -->
                      <TextBlock Style="{StaticResource DashChipText}"
                                 Text="{Binding LineCount,
                                                Converter={StaticResource CountLabel}, ConverterParameter=line}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="Keyboard-first invoice entry · buyer, broker and terms, and the due date follows from the terms"
                             Style="{StaticResource DashSubheading}"/>
                </StackPanel>
              </Grid>

            <!-- ── Filters over the rows below ──────────────────────────────────
                 What is on the invoice never changes here: these narrow what the GRID SHOWS and
                 nothing else. Every total, the line count, Confirm sale and the payload all read
                 Lines, so a filtered screen still confirms the whole invoice, and a hidden row is
                 still sold. ShowingLabel says so in words beside the Clear button, because a grid
                 that has quietly dropped half its rows is otherwise indistinguishable from an
                 invoice that has lost them.

                 Empty means no opinion, so an untouched screen shows everything. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="DATE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                  <!-- THE SAME CONTROL THE INVOICES PAGE FILTERS BY: AppDatePicker, 150 wide, and
                       the same CalendarClosed handler that commits the pick and gives the focus
                       back. It was a bare DatePicker at 132 — a different height, a different
                       calendar button and no commit-on-close, so the one filter that exists on both
                       pages looked and behaved like two. -->
                  <DatePicker x:Name="LineFilterDate" Width="150" Height="34"
                              Style="{StaticResource AppDatePicker}"
                              SelectedDate="{Binding FilterDate, UpdateSourceTrigger=PropertyChanged}"
                              CalendarClosed="DatePicker_CalendarClosed"
                              AutomationProperties.Name="Filter lines by date"
                              AutomationProperties.HelpText="Shows the lines dealt on this date. Clear to show every date."/>
                </StackPanel>

                <!-- PLAIN COMBO BOXES, exactly as the Invoices page's buyer filter is.
                     PickerSearch.On was set on both of these and did nothing: it refuses to wrap a
                     control whose ItemsSource is data-bound, and these are bound to Buyers and
                     Brokers. What it DID do was make the box editable, so a name typed into it —
                     "raju" — was accepted, matched nothing, and was silently replaced by whatever
                     was selected before the moment focus left. -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                  <TextBlock Text="BUYER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="LineFilterBuyer" Width="160" Height="34"
                            ItemsSource="{Binding Buyers}" DisplayMemberPath="Name"
                            SelectedItem="{Binding FilterBuyer, UpdateSourceTrigger=PropertyChanged}"
                            PreviewMouseWheel="NoWheelChange"
                            AutomationProperties.Name="Filter lines by buyer"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                  <TextBlock Text="BROKER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="LineFilterBroker" Width="150" Height="34"
                            ItemsSource="{Binding Brokers}" DisplayMemberPath="Name"
                            SelectedItem="{Binding FilterBroker, UpdateSourceTrigger=PropertyChanged}"
                            PreviewMouseWheel="NoWheelChange"
                            AutomationProperties.Name="Filter lines by broker"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                  <TextBlock Text="TYPE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="LineFilterType" Width="130" Height="34"
                            ItemsSource="{Binding DocTypes}"
                            SelectedItem="{Binding FilterType, UpdateSourceTrigger=PropertyChanged}"
                            PreviewMouseWheel="NoWheelChange"
                            AutomationProperties.Name="Filter lines by type"/>
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding ShowingLabel}"
                           Style="{StaticResource DashSubheading}" Margin="16,0,12,0"
                           VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="5" x:Name="LineFilterClear" Click="LineFilterClear_Click"
                        Style="{StaticResource DashButton}" VerticalAlignment="Bottom"
                        ToolTip="Clear all four filters and show every row"
                        AutomationProperties.Name="Clear line filters">
                  <TextBlock Text="Clear"/>
                </Button>
              </Grid>
            </Border>
            <!-- THE HEADER HAS NO FIELDS LEFT.

                 Buyer, Broker, Broker %, Terms, Type and Due were six header fields that applied to
                 every row at once. They are the LINE's now: each row is sold under its own deal,
                 shown in the grid's Deal Details column and edited in the drawer beside it.

                 AND SO IS THE DATE, on request. It was the last one standing, and it was the SECOND
                 date box on the screen — one in the filter bar above narrowing what is shown, one
                 here setting what is written, four inches apart and impossible to tell apart. The
                 date a line is dealt on is in Deal Details with the rest of that line's deal.

                 The control itself stays, collapsed and untabbable, because it is the entry's
                 date underneath: InvoiceDate is what a new row's DealDate is seeded from, what the
                 Update modal reads, and what a reopened draft writes back. Same name, same binding,
                 same handlers — nothing that used it has to know it is off the screen.

                 The pickers are the same story: BuyerPicker and BrokerPicker live in the drawer
                 under the same names. The Update modal still edits an invoice through the header,
                 because an invoice that already exists IS one deal. -->
            <DatePicker x:Name="InvoiceDatePicker" SelectedDate="{Binding InvoiceDate}"
                        Visibility="Collapsed" IsTabStop="False" Width="0" Height="0" Margin="0"
                        AutomationProperties.Name="Invoice date"
                        CalendarOpened="InvoiceDatePicker_CalendarOpened"
                        CalendarClosed="DatePicker_CalendarClosed"/>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Style="{StaticResource DashCard}" Margin="0,12,0,0">
            <!-- Totals only. The actions moved up into the Invoice lines card, beside the work
                 they act on, where there is room for their full labels. -->
            <Grid>
              <!-- Label above figure, not beside it. Three label/value pairs on one line read as
                   six things; stacked they read as three. Same bindings and same names — the
                   figures themselves are untouched. -->
              <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,32,0">
                  <TextBlock Text="CARATS" Style="{StaticResource KpiLabel}"/>
                  <TextBlock x:Name="TotalCarats" Margin="0,2,0,0"
                             Text="{Binding TotalCarats, StringFormat=N2}" Style="{StaticResource Total}"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                  <TextBlock Text="AMOUNT" Style="{StaticResource KpiLabel}"/>
                  <TextBlock x:Name="TotalAmount" Margin="0,2,0,0"
                             Text="{Binding TotalAmount, Converter={StaticResource Money}}" Style="{StaticResource Total}"/>
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                  <TextBlock Text="BLENDED RATE / CT" Style="{StaticResource KpiLabel}"/>
                  <TextBlock x:Name="BlendedRate" Margin="0,2,0,0"
                             Text="{Binding BlendedRate, Converter={StaticResource Money}}" Style="{StaticResource Total}"/>
                </StackPanel>
              </WrapPanel>
            </Grid>
          </Border>

          <!-- ── the lines, and the deal drawer beside them ──────────────────────
               A column each, exactly as the Invoices and Stock pages already split a list from its
               detail. BESIDE and not over: the requirement is that the table stays visible while a
               row's deal is being edited, and an overlay would cover the very rows the desk is
               comparing against. The drawer's column is 0 wide until it opens, so the grid has the
               whole card to itself the rest of the time. -->
          <Grid x:Name="EntrySplit" SizeChanged="EntrySplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="DealDrawerGap" Width="0"/>
              <ColumnDefinition x:Name="DealDrawerCol" Width="0"/>
            </Grid.ColumnDefinitions>

          <!-- One layer stack: grid at the bottom, then the "type a line" hint, then the
               no-catalogue panel on top. These were siblings of the DockPanel before, which meant
               the panel inherited DockPanel's default Dock=Left and would have rendered as a strip
               down the left edge rather than centred over the grid. -->
          <Border Grid.Column="0" Style="{StaticResource DashCard}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <!-- TWO COLUMNS, and this is the whole fix. Both children sat in one cell with no
                     column definitions at all: the heading block filled the width, the buttons were
                     right-aligned on top of it, and the subtitle (a long sentence) ran underneath
                     them. The buttons were never behind anything; the TEXT was.
                     A z-order change would not have touched it, because the order was already
                     right. Giving the text a column of its own is what stops the two overlapping.
                     Auto on the right, so the buttons take exactly what they need and the sentence
                     gets the rest. -->
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Invoice lines" Style="{StaticResource DashHeading}"/>
                    <!-- What this entry is currently holding, in carats. Stock comes off as a line
                         is typed, not when the sale is confirmed — and until this chip existed the
                         only place that showed was the Stock page, which is a tab away. Written in
                         ShowHeldOnEntry; hidden entirely while nothing is held, because a chip
                         reading "0.0000 ct held" on a blank screen is noise. -->
                    <Border x:Name="HoldChip" Style="{StaticResource DashChip}" Margin="10,0,0,0"
                            Visibility="Collapsed"
                            ToolTip="These carats are reserved out of available stock while this invoice is being typed. Confirm sale turns the hold into a sale; Move to stock releases it and puts them back.">
                      <TextBlock x:Name="HoldChipText" Style="{StaticResource DashChipText}"/>
                    </Border>
                    <!-- Why Confirm sale is refusing, in the open.
                         The button became disabled rather than refusing on click, which is what was
                         asked for, but the only explanation left was a hover tooltip. Two ticked
                         rows and a dead button read as "multi-row is broken" when the actual answer
                         was "Buyer is required", four inches away and unsaid. A disabled control
                         that does not say why is worse than an enabled one that refuses.
                         Written in RefreshActionStates; hidden entirely while nothing blocks. -->
                    <Border x:Name="BlockChip" Style="{StaticResource DashChip}" Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningSoftBrush}"
                            ToolTip="Confirm sale stays disabled until this is fixed.">
                      <TextBlock x:Name="BlockChipText" Style="{StaticResource DashChipText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource DashSubheading}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="Enter adds a line · Rejection and Amount are calculated · each line holds its carats in stock as you type"
                             Text="Enter adds a line · Rejection and Amount are calculated · each line holds its carats in stock as you type"/>
                </StackPanel>
                <!-- ONE action area, beside the heading that already draws the eye. Everything
                     that acts on this invoice is here: nothing is per-row any more, which is what
                     kept the Action column cramped enough to cut its own buttons in half.

                     These carry the x:Names again, so Busy() greys the actual buttons during a
                     save or a post rather than a set of hidden anchors — the per-button feedback
                     that was lost while they lived inside a DataTemplate.

                     Icon then label, one style, one spacing, on every one of them. -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="AddLineButton" Click="AddLine_Click"
                          Style="{StaticResource DashButton}" Margin="0,0,8,0"
                          ToolTip="Add another line to this invoice  (Enter)"
                          AutomationProperties.Name="Add line">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconAdd}"/>
                      <TextBlock Text="Add line" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <!-- Only on screen while something is ticked. Its label carries the count,
                       so the text is set in code and only the icon is fixed here. -->
                  <Button x:Name="DeleteLines" Click="DeleteLines_Click" Visibility="Collapsed"
                          Style="{StaticResource DashButton}" Margin="0,0,8,0"
                          Foreground="{DynamicResource DangerBrush}"
                          ToolTip="Take the ticked lines off this invoice. Nothing is saved and no stock moves."
                          AutomationProperties.Name="Remove the ticked lines">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconRemove}"/>
                      <TextBlock x:Name="DeleteLinesLabel" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <!-- Print memo and Confirm sale appear only once a row is ticked, and act on the
                       ticked rows — the same rows Remove acts on. One meaning for a tick across all
                       three, so "Confirm sale · 2 lines" on a four-row entry sells two. -->
                  <Button x:Name="SaveDraft" Click="PrintMemo_Click" Visibility="Collapsed"
                          Style="{StaticResource DashButton}" Margin="0,0,8,0"
                          ToolTip="Print the memo for the TICKED lines  (Ctrl+P). Nothing is saved and no stock moves.&#10;&#10;One memo per deal. Unticked rows are not on it."
                          AutomationProperties.Name="Print memo">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconMemo}"/>
                      <TextBlock x:Name="SaveDraftLabel" Text="Print memo" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <!-- MOVE TO STOCK IS GONE from this page, on request.
                       The button is off the screen; the RELEASE it performed is not lost. Clear /
                       New invoice already calls DropEntryAsync before it resets, so an abandoned
                       entry still gives its carats back and no reservation can be stranded. What
                       has gone with the button is the shortcut it also did — opening the Stock
                       page already filtered to this entry's buckets.
                       Kept in the tree, collapsed and untabbable, because RefreshActionStates and
                       every Busy() scope on this screen name it. -->
                  <Button x:Name="MoveToStock" Click="MoveToStock_Click"
                          Visibility="Collapsed" IsTabStop="False" Width="0" Margin="0"
                          AutomationProperties.Name="Move to stock"/>
                  <Button x:Name="Post" Click="Post_Click" Visibility="Collapsed"
                          Style="{StaticResource DashGoldButton}" Margin="0,0,0,0"
                          ToolTip="Confirm the TICKED lines: post their invoice and take their carats out of stock, in one step.&#10;&#10;Unticked rows stay on this entry and keep their hold on stock."
                          AutomationProperties.Name="Confirm sale">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconConfirm}"/>
                      <TextBlock x:Name="PostLabel" Text="Confirm sale" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </Grid>


          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True">
          <DockPanel>

            <!-- ── Pages ────────────────────────────────────────────────────────
                 A STRIP OF ITS OWN under the table, not a panel floating over it. It used to be
                 laid on top of the grid at the bottom-right, which put it squarely on the
                 horizontal scrollbar: two controls in the same twenty pixels, and the bar
                 unreachable behind the buttons. Docked, the grid gets the room above and the pager
                 gets its own, so neither can cover the other at any window size.

                 Hidden entirely on a single page: a pager under a six-row invoice is furniture.
                 Paging changes only what is ON SCREEN, never what is on the invoice — every total,
                 the tick count, the payload and Confirm sale read Lines. -->
            <Border DockPanel.Dock="Bottom" Padding="12,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding HasPages, Converter={StaticResource Bool}}">
              <Border.Resources>
                <!-- A numbered chip: square, quiet, and filled when it is the page you are on.
                     Built on GhostButton so it carries the app's own hover and focus, and the
                     trigger swaps only the two brushes. -->
                <Style x:Key="PageChipButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="MinWidth" Value="30"/>
                  <Setter Property="Height" Value="30"/>
                  <Setter Property="Padding" Value="8,0"/>
                  <Setter Property="Margin" Value="2,0"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Current}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                      <Setter Property="Foreground" Value="White"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
                <Style x:Key="PageArrowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                  <Setter Property="Width" Value="30"/>
                  <Setter Property="Height" Value="30"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
              </Border.Resources>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- HOW MANY TO A PAGE, on the left, as the reference has it. The list is fixed
                     rather than a typed number: a box would be one more thing to validate and a
                     way to ask for one row a page. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Show on page by" Style="{StaticResource DashSubheading}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="LinePageSize" Width="72" Height="30"
                            ItemsSource="{Binding Source={x:Static local:InvoiceEntry.PageSizes}}"
                            SelectedItem="{Binding PageSize}"
                            PreviewMouseWheel="NoWheelChange"
                            ToolTip="How many rows the table shows at once"
                            AutomationProperties.Name="Rows per page"/>
                </StackPanel>

                <!-- The page label stays, in the middle, where it does not compete with either
                     end. It is the only thing on this row that says the TOTAL when the numbers
                     are a window onto a longer list. -->
                <TextBlock Grid.Column="1" Text="{Binding PageLabel}" Margin="16,0,16,0"
                           Style="{StaticResource DashSubheading}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="LinePagePrev" Click="LinePagePrev_Click"
                          Style="{StaticResource PageArrowButton}" Margin="0,0,4,0"
                          IsEnabled="{Binding CanPrevPage}"
                          ToolTip="Previous page"
                          AutomationProperties.Name="Previous page of lines">
                    <Path Data="M 6,0 L 0,5 L 6,10" Stretch="None" StrokeThickness="1.6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>

                  <!-- THE NUMBERS. A window of seven centred on the current page, so a long entry
                       cannot push the chevrons off the edge of the card. -->
                  <ItemsControl x:Name="LinePageNumbers" ItemsSource="{Binding PageNumbers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Number}" Tag="{Binding Number}"
                                Click="LinePage_Click" Style="{StaticResource PageChipButton}"
                                AutomationProperties.Name="{Binding Number, StringFormat='Page {0}'}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button x:Name="LinePageNext" Click="LinePageNext_Click"
                          Style="{StaticResource PageArrowButton}" Margin="4,0,0,0"
                          IsEnabled="{Binding CanNextPage}"
                          ToolTip="Next page"
                          AutomationProperties.Name="Next page of lines">
                    <Path Data="M 0,0 L 6,5 L 0,10" Stretch="None" StrokeThickness="1.6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

                        <!-- THE TABLE SCROLLS ITSELF, both ways, and both bars are Auto on the grid below.
               Sales entry opts into SlimScrollBar in its TabItem.Resources, which is the same
               style the Stock report sheet uses, so the horizontal bar here looks and behaves
               exactly like the one under that sheet.

               VerticalAlignment="Top" used to be on the grid, from when the rows scrolled in a
               ScrollViewer wrapped around it. That wrapper is gone and the attribute was left
               behind, which is what broke scrolling: content-height inside a fixed frame means
               the rows below the fold were CLIPPED rather than scrolled, so there was nothing for
               the wheel to move and no vertical bar to drag. Filling the frame gives the grid a
               real viewport, and a real viewport is what makes both scrollbars appear.

               Nothing about the columns changes: they keep their star widths and their content
               floors, so the horizontal bar shows up exactly when the floors (1244px) do not fit
               the window, at any size, and every right-hand field stays reachable. -->
          <Grid>
            <!-- CanUserAddRows is OFF: WPF's placeholder row carries a sentinel object, so the
                 per-row Size list (which depends on that row's grade) binds to nothing on it.
                 Enter appends a real line instead — which is what SALES-001 asks for anyway.
                 CanUserDeleteRows is OFF too: Delete is handled in code so a typed line cannot
                 vanish without being asked about. -->
            <!-- A FLOOR PER COLUMN, and each one is what that column's CONTENT needs — not what
                 is left over after the others have had their share.

                 Star columns divide the space that is free, so squeezing them is silent: they
                 shrink to whatever fits and the text inside is simply cut. That is what clipped
                 the Size and Grade dropdowns. With Action holding four buttons, 92* of Size came
                 out at about 68px, and 68 less 20 of cell padding less the ComboBox's own arrow
                 leaves under 30px for "−6.5". Trimming the floors to make everything fit at once
                 did not avoid that — it just moved the cutting from one column to eleven.

                 So the floors say what the content needs and the TABLE SCROLLS when the window
                 cannot give it that, rather than silently squeezing a column below its content.

                 They also have to leave HEADROOM, which is the other half of the same lesson. At
                 1072 the floors were within about ten pixels of the card, so the moment enough
                 lines arrived to raise the VERTICAL scrollbar, its eleven pixels came off the
                 viewport and tipped the table into needing a horizontal one too — a bar that
                 scrolled almost nothing and looked like a fault. The numeric columns gave up 72px
                 between them and the floors now total 1000.

                 Size and Grade were deliberately NOT touched. Those two hold ComboBoxes, and
                 shaving them is what clipped "-6.5" and "Unknown Grade" the last time the floors
                 were trimmed to make everything fit at once.

                 The STAR WEIGHTS were rebalanced separately, and they cost nothing: they only
                 decide how the spare width is shared, so moving weight between columns changes no
                 total. Remark was the widest column on the row at 168*, from when it was a single
                 line that could only show what fitted. It wraps now, so it does not need the width
                 — and Price/ct and Amount do: an invoice in crores runs to fourteen characters,
                 and both were cutting to "3,84,73,8...". Remark gave 52* to those two. Both keep
                 their tooltips for anything larger still. -->
            <!-- CanUserSortColumns="False", below. An invoice's lines are in the order they were
                 typed, and that is the order that prints and posts. A DataGrid sorts by default,
                 so one click on a header reordered the rows on screen without touching the
                 invoice — and Add line, which appends to the LIST, then landed somewhere
                 other than under the last line the person could see. -->
            <!-- VisibleLines, not Lines: the filtered page. The SAME SaleLine objects, so a cell
                 edited here edits the invoice; only which of them are on screen changes. -->
            <DataGrid x:Name="Grid" ItemsSource="{Binding VisibleLines}" IsReadOnly="False"
                    Visibility="{Binding Source={x:Static local:Catalogue.Grades}, Path=Count, Converter={StaticResource Empty}, ConverterParameter=Invert}"
                    CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                    CanUserSortColumns="False"
                    PreviewKeyDown="Grid_KeyDown" CurrentCellChanged="Grid_CurrentCellChanged"
                    ColumnHeaderHeight="40"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    BorderThickness="0" Background="Transparent">
            <!-- A cell takes the first click to become current and only edits on the second, so on
                 a fresh screen the first figure typed goes nowhere. On a keyboard-first entry
                 screen that is a silent data loss, not a nicety. -->
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Cell_Down"/>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
              <!-- Colour on HasConflict, not on Error. Every freshly started line has an Error
                   ("Weight must be greater than 0") from the moment a grade is picked, so keying
                   off Error painted the row you were currently typing into red. The tooltip still
                   carries every message, including the not-yet-typed ones. -->
              <Style TargetType="DataGridRow">
                <!-- MinHeight, not the grid's RowHeight. RowHeight PINS every row at 42 whatever is
                     in it, which is what stopped a wrapped remark from ever being visible in full.
                     A floor keeps the rows even while a line has a short remark, and lets the one
                     with a long one grow to fit it. -->
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ToolTip" Value="{Binding Error}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <!-- Ticking is for removing several lines at once, and nothing else: it changes no
                   figure and no total. The header box ticks and unticks the lot. -->
              <!-- Both boxes centred in the SAME 36px. AppColumnHeader is left-aligned with 10px
                   of padding while AppCell centres its content, so HorizontalAlignment="Center" on
                   the header box centred it inside a presenter that was itself pinned left — and
                   the header tick sat a few px left of every row tick under it. Zero the padding
                   on both and centre the header's content, and the one column has one centre. -->
              <DataGridTemplateColumn Width="36" MinWidth="36" CanUserResize="False">
                <DataGridTemplateColumn.HeaderStyle>
                  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource AppColumnHeader}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                  </Style>
                </DataGridTemplateColumn.HeaderStyle>
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
                    <Setter Property="Padding" Value="0"/>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.HeaderTemplate>
                  <DataTemplate>
                    <!-- IsThreeState stays FALSE on purpose: a click must toggle all-or-nothing,
                         never cycle the user into "some". The indeterminate look is set from code
                         when the rows disagree, which WPF allows whatever IsThreeState says.
                         Loaded, because a header inside a template cannot be reached by name. -->
                    <CheckBox x:Name="TickAllLines" Click="TickAllLines_Click" Loaded="TickAllLoaded"
                              IsThreeState="False"
                              Style="{StaticResource FieldCheckBox}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Tick every line"
                              AutomationProperties.Name="Tick every line"/>
                  </DataTemplate>
                </DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- No box at all on the empty row you type into: ticking it selected
                         nothing, because Remove only ever counted real lines. -->
                    <!-- On EVERY row, an empty one included. A line you have just added is the
                         one most likely to be a mistake, and hiding its tick until it had figures
                         in it meant the four blank rows you wanted rid of were the four you could
                         not select. Ticking is meaningful because Remove acts on whatever is
                         ticked, blank or not. -->
                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                              Click="TickLine_Click"
                              Style="{StaticResource FieldCheckBox}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              AutomationProperties.Name="Select this line"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- CellComboBox, not a bare ComboBox: the default field style is 32px and these sat a
                   visible 4px taller than every other control in a 36px row. Same defect the
                   Disposition dropdown had (docs/12 §3c). -->
              <!-- Two known inconsistencies here, left alone on purpose (docs/11 §Gaps):
                   1. Size comes before Grade; every other grid in the app reads Grade then Size,
                      and this page's own empty-state hint says "Pick a grade and size". Swapping
                      them changes the tab order on a keyboard-first entry screen, so it is a
                      workflow decision rather than a defect to fix quietly.
                   2. These headers are Title Case; every other grid uses UPPERCASE. Purely
                      visual, and equally a design decision.
                   Neither affects what is saved. -->
              <DataGridTemplateColumn Header="Size" Width="92*" MinWidth="88" CellStyle="{StaticResource ComboCell}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- ItemTemplate, not DisplayMemberPath. The design's combo template draws its
                         closed state from SelectionBoxItemTemplate, which DisplayMemberPath does
                         not populate — so the list showed "+6.5" while the box showed the type
                         name, clipped to "Di". An explicit template feeds both. -->
                    <!-- An unset combo draws nothing but a chevron, so a fresh line looked broken
                         rather than unfilled. The hint sits behind the drop-down and disappears
                         the moment a size is chosen. -->
                    <Grid>
                      <!-- SizeChoices, not AllowedSizes: the list narrows to what has been typed,
                           and it is PER LINE because WPF hands every combo bound to one collection
                           the same view, so a shared filter would narrow every row at once.
                           No CellCombo_Down here: that handler opens the list on first click, which
                           on an editable box steals the click that should place the caret. The
                           chevron opens it, and so does typing (Picker_Typed). -->
                      <ComboBox ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                                Text="{Binding SizeFilter, UpdateSourceTrigger=PropertyChanged}"
                                PreviewTextInput="Picker_Typed" LostFocus="Picker_LostFocus"
                                PreviewKeyDown="Picker_Enter"
                                ItemTemplate="{StaticResource SizeCodeTemplate}" ItemContainerStyle="{StaticResource SizeItemContainer}" Style="{StaticResource EditableCellComboBox}"
                                AutomationProperties.Name="Size"/>
                      <!-- SizePlaceholder, not Size: an editable box draws the typed text in the
                           same place, so keying off the selection alone left the hint sitting on
                           top of what was being typed. -->
                      <TextBlock Text="Size" Style="{StaticResource CellPlaceholder}"
                                 Visibility="{Binding SizePlaceholder, Converter={StaticResource Bool}}"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Grade" Width="120*" MinWidth="112" CellStyle="{StaticResource ComboCell}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <!-- SellableGrades, not Grades: ZZ TEST is test data, and Unknown Grade is
                           0039's landing place for a sheet row that printed no grade name. Neither
                           belongs one keystroke from a real invoice. Both keep their rows, their
                           stock and their place on every report; this changes only what can be
                           typed here. Intake & movements deliberately keeps the FULL catalogue,
                           because moving carats out of Unknown Grade with an ADJUST is the
                           correction path 0039 exists to provide.

                           TextSearch.TextPath so typing finds a grade. WPF's type-ahead was on all
                           along, but with no path it matched against the object rather than the
                           text on screen, so typing "NO 2" did nothing. -->
                      <ComboBox ItemsSource="{Binding GradeChoices}"
                                Text="{Binding GradeFilter, UpdateSourceTrigger=PropertyChanged}"
                                PreviewTextInput="Picker_Typed" LostFocus="Picker_LostFocus"
                                PreviewKeyDown="Picker_Enter"
                                SelectedItem="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                ItemTemplate="{StaticResource GradeNameTemplate}" ItemContainerStyle="{StaticResource GradeItemContainer}" Style="{StaticResource EditableCellComboBox}"
                                AutomationProperties.Name="Grade"/>
                      <TextBlock Text="Grade" Style="{StaticResource CellPlaceholder}"
                                 Visibility="{Binding GradePlaceholder, Converter={StaticResource Bool}}"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Weight ct" Width="80*" MinWidth="84" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding GrossWeightCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Selection" Width="88*" MinWidth="84" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding SelectionCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <!-- Read-only and never wider than "999.99", so it can afford the floor that the two
                   Less columns need. -->
              <DataGridTextColumn Header="Rejection" Width="88*" MinWidth="84" IsReadOnly="True" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding RejectionCt, StringFormat=N2, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
              <DataGridTextColumn Header="Price/ct" Width="128*" MinWidth="80" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding PricePerCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding PricePerCt, StringFormat=N2}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Ex Rate" Width="66*" MinWidth="72" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding ExRate, UpdateSourceTrigger=LostFocus}"/>
              <!-- 52*/46 gave the editor 13px of text room — one character — so a percentage like
                   12.5 scrolled out of sight as it was typed and the field looked dead. These two
                   hold the same shape of figure as Ex Rate and are sized to match it. -->
              <DataGridTextColumn Header="Less 1" Width="62*" MinWidth="62" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less1Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Less 2" Width="62*" MinWidth="62" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less2Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Amount" Width="144*" MinWidth="92" IsReadOnly="True" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding Amount, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Num}">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding Amount, StringFormat=N2}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <!-- MinWidth, because a star column with none is the column that pays for everything
                   else: below about a 1400px window the ten fixed columns took all the room and
                   this one was squeezed to 20px, showing "Rema" and no remark at all. With a floor
                   the grid scrolls instead, which keyboard entry is unaffected by — Tab still
                   walks the cells and the DataGrid scrolls the focused one into view. -->
              <!-- Free text that already trims to an ellipsis and carries its full value in a
                   tooltip, so it is the one column that can give room to Less 1 and Less 2. -->
              <!-- A TEMPLATE column, exactly as the disposition NOTE on Intake & movements is,
                   and built from the same two styles: CellTextBox for the box, CellPlaceholder for
                   the ghost text.

                   A DataGridTextColumn was not enough and EditingElementStyle did not close it.
                   That column has two states: a TextBlock at rest and a TextBox while editing. So
                   styling the editor fixed the white box that appeared once you clicked, and left
                   the resting state a bare line of text with no box at all, which is not what
                   Intake shows and was the difference being reported. A template column has one
                   state: the box is always there, the way every other cell in this grid and the
                   NOTE cell on Intake behave. -->
              <!-- WIDER, on request: 116* and a floor of 80 gave a box about eight characters
                   across at an ordinary window, so every remark wrapped onto three lines and took
                   the row's height with it. 200* and a floor of 150. The star weight only shares
                   out spare width, so it costs no other column anything; the floor adds 70px to
                   the table's total, which the horizontal scrollbar already handles. -->
              <DataGridTemplateColumn Header="Remark" Width="200*" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <!-- WRAPS, and the row grows with it (see the row style above). A
                           single-line box can only ever show one column's worth of a remark, so a
                           long one was cut whichever end you looked at: scrolled to its tail after
                           typing, and to its head after LostFocus sent it home. Neither is the
                           value. Wrapping shows all of it, at the cost of a taller row on the lines
                           that carry one — which is the honest trade, since the alternative is a
                           field that quietly hides what it holds.

                           AcceptsReturn stays FALSE: Enter belongs to the grid, where it adds the
                           next line. LostFocus still goes home, which now only matters for a remark
                           too long even to wrap inside the row. -->
                      <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource CellTextBox}"
                               TextWrapping="Wrap" AcceptsReturn="False"
                               Height="Auto" MinHeight="28" VerticalContentAlignment="Center"
                               LostFocus="RemarkBox_LostFocus"
                               AutomationProperties.Name="Remark"
                               ToolTip="{Binding Remark}"/>
                      <TextBlock Text="remark" Style="{StaticResource CellPlaceholder}"
                                 Visibility="{Binding Remark, Converter={StaticResource Empty}}"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- ── DEAL DETAILS ────────────────────────────────────────────────
                   Who this row is sold to and on what terms, as a summary rather than as six more
                   columns. Six would have taken 700px off a table that already has eleven, and the
                   deal is read far more often than it is changed.

                   READ-ONLY HERE, on purpose. Every field is edited in the drawer, so there is one
                   place the deal can be changed and one place to look when it is wrong — and a
                   half-typed buyer in a grid cell cannot leave a row sold to nobody.

                   The buyer line turns red and reads "No buyer" when there is none: sales_invoice
                   .buyer_id is NOT NULL, so that row cannot be written at all, and a blank cell
                   would have looked merely unfilled rather than blocking. -->
              <DataGridTemplateColumn Header="Deal Details" Width="176" MinWidth="168"
                                      CanUserResize="False" SortMemberPath="DealSummary">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
                    <Setter Property="Padding" Value="8,3"/>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- TWO LINES, not three. Buyer on top; broker and terms folded onto one line
                         under it. Three stacked lines wanted about 48px in a 42px row, so the
                         third was sliced through the middle and the deal became the one column on
                         this screen you could not read. The whole of it is still on the tooltip.

                         Every text block trims rather than clips, so a long buyer name ends in an
                         ellipsis you can hover instead of a letter cut in half. -->
                    <Grid ToolTip="{Binding DealSummary}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DealBuyerName}" FontWeight="SemiBold" FontSize="12"
                                   TextTrimming="CharacterEllipsis" LineHeight="15"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextBrush}"
                                   AutomationProperties.Name="Buyer on this line">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <!-- sales_invoice.buyer_id is NOT NULL, so a row without one
                                     cannot be written at all. Red, and named, rather than blank. -->
                                <DataTrigger Binding="{Binding HasBuyer}" Value="False">
                                  <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DealLine2}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" LineHeight="14"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                      </StackPanel>

                      <!-- Tag, not CommandParameter: these rows are a plain ObservableCollection
                           with no command surface, and Tag is what every other row action on this
                           grid already uses to say which line it belongs to. -->
                      <Button Grid.Column="1" Content="Edit" Tag="{Binding}"
                              Click="EditDeal_Click" VerticalAlignment="Center" Margin="6,0,0,0"
                              Padding="8,2" MinWidth="42" FontSize="11"
                              Style="{StaticResource GhostButton}"
                              AutomationProperties.Name="Edit deal details for this line"
                              ToolTip="Date, buyer, broker, terms and type for THIS line only"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- ACTION, last and next to Remark. Four icon buttons, no labels: Print memo,
                   Move to stock, Confirm sale, Remove. Same icons and the same ActionIcon style as
                   the header row above, so a glyph means the same thing in both places.

                   Icons rather than words because this repeats on every line. The same four as
                   text measured over 300px and made Action the widest column in the table, which
                   starved the star columns and clipped the Size and Grade dropdowns. At 26px each
                   the column is 136 and the table's floors come to 1072, inside the card at any
                   normal window.

                   ALL THREE ARE ABOUT THIS LINE. They share the header buttons' handlers, and what
                   separates them is Tag="{Binding}": ActOn() reads it and acts on that row, or
                   falls back to the ticked rows when there is none, which is what the header
                   buttons and Ctrl+P get. Print memo and Confirm sale used to ignore the row and
                   do the whole entry from here. The header keeps the worded copies. -->
              <DataGridTemplateColumn Header="Action" Width="108" MinWidth="108"
                                      CanUserResize="False">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
                    <Setter Property="Padding" Value="0"/>
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                      <!-- Tag="{Binding}" is what makes these THIS ROW's actions. Without it both
                           handlers fell through to the ticked rows, so a row icon did whatever the
                           ticks said and ignored the row it was sitting on. -->
                      <Button Click="PrintMemo_Click" Tag="{Binding}" Style="{StaticResource DashButton}"
                              Height="26" Width="28" MinWidth="0" Padding="0" Margin="2,0"
                              ToolTip="Print a memo for this line"
                              AutomationProperties.Name="Print memo for this line">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconMemo}"/>
                      </Button>
                      <!-- The row's Move to stock icon goes with the header button above. Three
                           actions per row now, not four, so the column is 108px rather than 136. -->
                      <Button Click="Post_Click" Tag="{Binding}" Style="{StaticResource DashGoldButton}"
                              Height="26" Width="28" MinWidth="0" Padding="0" Margin="2,0"
                              ToolTip="Confirm this line — posts it and takes the stock"
                              AutomationProperties.Name="Confirm this line">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconConfirm}"/>
                      </Button>
                      <!-- On EVERY row, with no gate at all. Removable hid it whenever a single
                           row was left, so the one row you most often want to clear was the one
                           row that offered no way to clear it. Taking the last line off is not a
                           special case: RemoveLine_Click puts a fresh blank row back, so the grid
                           still always has one to type into. -->
                      <!-- Icon AND the word, matching "Remove n lines" in the header: same
                           IconRemove, same DangerBrush. Removing a line is the one thing in this
                           column that cannot be undone, so it is the one that should not be left
                           to a glyph. The other three are reversible or write nothing, which is
                           why they stay icon-only and the column still fits. -->
                      <Button Click="RemoveLine_Click" Tag="{Binding}"
                              Style="{StaticResource DashButton}"
                              Height="26" Width="28" MinWidth="0" Padding="0" Margin="2,0"
                              Foreground="{DynamicResource DangerBrush}"
                              ToolTip="Remove this line"
                              AutomationProperties.Name="Remove this line">
                        <Path Style="{StaticResource ActionIcon}" Data="{StaticResource IconRemove}"/>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
                          </DataGrid.Columns>
            </DataGrid>

            <!-- Guidance while the invoice is still empty. INSIDE the table, in the blank area
                 under the row, layered over the grid — a third position, and the two it has
                 already had are why it is pinned the way it is:

                   * EmptyHint's own VerticalAlignment=Center with a 56px top margin centred it in
                     the whole table, dropping the sentence onto the row being typed into.
                   * Docked under the grid it landed BELOW the grid's horizontal scrollbar, so the
                     bar read as belonging to the sentence rather than to the rows.
                   * Docked outside the frame it sat below the table altogether.

                 Top-aligned with a fixed 96px inset instead: the 40px column header, one 42px row,
                 and a gap. That clears the row above it and stays well clear of the scrollbar at
                 the grid's bottom edge, at any window size. Safe as a fixed number because of what
                 EntriesStarted means — the moment a second row exists this is already hidden, so
                 there is never a row for it to cover.

                 Bound to EntriesStarted, not LineCount: a blank row is not a line, so keying off
                 LineCount left this sitting on top of nine empty rows once Enter had been pressed
                 nine times. Adding a row counts as starting, typed into or not.

                 IsHitTestVisible is false in the style, so it never eats a click meant for the
                 cell underneath it. -->
            <TextBlock Style="{StaticResource EmptyHint}"
                       VerticalAlignment="Top" Margin="12,96,12,0"
                       Visibility="{Binding EntriesStarted, Converter={StaticResource Empty}}"
                       Text="Pick a grade and size, then type the weight.&#10;Enter adds another line · Ctrl+S saves a memo."/>

            <!-- With no catalogue the Grade and Size dropdowns open onto nothing, which reads as
                 "this app is broken" rather than "it could not reach the database" — and a line can
                 never be completed, so the grid underneath is not worth showing. -->
            <Border Visibility="{Binding Source={x:Static local:Catalogue.Grades}, Path=Count, Converter={StaticResource Empty}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No grades loaded" HorizontalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Grades and sieve sizes come from the database. Without them a sale line cannot be completed."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                           Margin="0,6,0,14" Style="{StaticResource MutedText}"/>
                <Button Content="Retry" Click="ReloadCatalogue_Click" HorizontalAlignment="Center"
                        Style="{StaticResource AppPrimaryButton}"/>
              </StackPanel>
            </Border>
          </Grid>
          </DockPanel>
          </Border>
            </DockPanel>
          </Border>

            <!-- ══ DEAL DETAILS DRAWER ═══════════════════════════════════════════
                 One line's buyer, broker, percentage, terms, type and due date. 420px, which is
                 the width two of these fields need side by side and still leaves the eleven-column
                 table readable beside it.

                 IT EDITS A COPY. The fields bind to DealDraft, a scratch SaleLine, and nothing
                 reaches the row until Save Details — so Cancel is a real cancel, and a half-typed
                 buyer never puts a hold on stock or reddens a row that was fine a moment ago.

                 Pressing Edit on another row while it is open just re-points it at that row; the
                 title says which line, so there is no question which one is being changed. -->
            <Border x:Name="DealDrawer" Grid.Column="2" Style="{StaticResource DashCard}"
                    Visibility="Collapsed" DataContext="{Binding DealDraft, RelativeSource={RelativeSource AncestorType=Window}}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock x:Name="DealDrawerTitle" Text="Deal Details"
                               Style="{StaticResource DashHeading}"/>
                    <TextBlock Text="Applies to this line only. Lines sharing a deal are billed together."
                               Style="{StaticResource DashSubheading}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="DealDrawerClose" Click="CancelDeal_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="24" Height="24" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                          ToolTip="Close without saving" AutomationProperties.Name="Close deal details">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stretch="None"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>

                <!-- The buttons before the fields in markup so they dock to the floor and the
                     fields take what is left. Cancel first, Save last: the safe one is furthest
                     from the primary. -->
                <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DealCancel" Content="Cancel" Click="CancelDeal_Click"
                            MinWidth="92" Margin="0,0,8,0" IsCancel="True"
                            AutomationProperties.HelpText="Closes the drawer and leaves the line as it was"/>
                    <Button x:Name="DealSave" Content="Save Details" Click="SaveDeal_Click"
                            MinWidth="118" IsDefault="True"
                            Style="{StaticResource AppPrimaryButton}"
                            AutomationProperties.HelpText="Writes these values onto the selected line"/>
                  </StackPanel>
                </Border>

                <!-- Refuses to save, and says why, in the drawer rather than in the status bar at
                     the far bottom of the window. -->
                <Border x:Name="DealProblem" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        Background="{DynamicResource DangerSoftBrush}" CornerRadius="8"
                        Padding="10,8" Margin="0,12,0,0">
                  <TextBlock x:Name="DealProblemText" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource DangerBrush}"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                  <StackPanel>
                    <!-- DATE is part of the deal too, so it belongs in here with the rest of it.
                         sales_invoice.invoice_date is per invoice, so a row dated differently is
                         simply a different invoice — nothing had to change to express it. The
                         header's Date still seeds every new row, so an entry written on one day
                         goes on behaving as one date unless a line is deliberately moved. -->
                    <TextBlock Text="DATE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DealDatePicker" Height="34" Margin="0,0,0,12" TabIndex="0"
                                SelectedDate="{Binding DealDate}"
                                Style="{StaticResource AppDatePicker}"
                                CalendarClosed="DatePicker_CalendarClosed"
                                AutomationProperties.Name="Invoice date for this line"/>

                    <TextBlock Text="BUYER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                      <!-- ItemsSource is FILLED FROM CODE, in EditDeal_Click, like every other picker
                           in this app. It used to be bound to the window's entry — and
                           PickerSearch answers a first use by replacing ItemsSource with its own
                           filtered view, which OVERWRITES a binding permanently. The control was
                           then holding a view over the entry that existed when it was first
                           opened, while ResetEntry and LoadPartiesAsync went on clearing and
                           refilling a different one. Refreshing that stranded view is what threw
                           NullReferenceException out of ListCollectionView.InternalCount. -->
                      <ComboBox x:Name="BuyerPicker" Height="34"
                                SelectedItem="{Binding DealBuyer}"
                                ItemContainerStyle="{StaticResource PartyItemContainer}"
                                ui:PickerSearch.On="True" PreviewMouseWheel="NoWheelChange" TabIndex="1"
                                AutomationProperties.Name="Buyer"
                                AutomationProperties.HelpText="Required"/>
                      <!-- KEYED ON THE BOX'S TEXT, not on the line's buyer. These are EDITABLE
                           combos: the typed text is drawn in the same place as this hint, and a
                           search miss leaves SelectedItem null on purpose (see PickerSearch) — so
                           keying off DealBuyer meant "Select buyer" sat on top of "abc" while it
                           was being typed, and the two read as one smeared word. Text is the
                           honest question: is anything drawn in this box already?
                           The Size and Grade cells in the grid above solved the same thing with
                           SizePlaceholder / GradePlaceholder; this is that fix, for the drawer. -->
                      <TextBlock Text="Select buyer" Style="{StaticResource FieldPlaceholder}"
                                 Visibility="{Binding Text, ElementName=BuyerPicker,
                                                      Converter={StaticResource Empty}}"/>
                    </Grid>

                    <TextBlock Text="BROKER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,12">
                      <ComboBox x:Name="BrokerPicker" Height="34"
                                SelectedItem="{Binding DealBroker}"
                                ItemContainerStyle="{StaticResource PartyItemContainer}"
                                ui:PickerSearch.On="True" PreviewMouseWheel="NoWheelChange" TabIndex="2"
                                AutomationProperties.Name="Broker"/>
                      <TextBlock Text="Select broker" Style="{StaticResource FieldPlaceholder}"
                                 Visibility="{Binding Text, ElementName=BrokerPicker,
                                                      Converter={StaticResource Empty}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="BROKER %" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="BrokerPctBox" Height="34" TabIndex="3"
                                 Text="{Binding DealBrokerPct, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppNumericTextBox}"
                                 AutomationProperties.Name="Broker percent"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="TERMS (DAYS)" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TermsBox" Height="34" TabIndex="4"
                                 Text="{Binding DealTermsDays, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppNumericTextBox}"
                                 AutomationProperties.Name="Terms in days"/>
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="TYPE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="DocTypePicker" Height="34" Margin="0,0,0,12" TabIndex="5"
                              SelectedItem="{Binding DealDocType}"
                              PreviewMouseWheel="NoWheelChange"
                              AutomationProperties.Name="Document type"/>

                    <!-- Editable, and setting it writes TERMS — see SaleLine.DealDueDate. The two
                         are one fact, so a drawer that let them drift would be offering the desk a
                         way to disagree with itself. -->
                    <TextBlock Text="DUE DATE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DealDuePicker" Height="34" TabIndex="6"
                                SelectedDate="{Binding DealDueDate, Converter={StaticResource DateOnly}}"
                                Style="{StaticResource AppDatePicker}"
                                CalendarClosed="DatePicker_CalendarClosed"
                                AutomationProperties.Name="Due date"
                                AutomationProperties.HelpText="Follows from the terms; changing it changes the terms"/>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ SALES-002/004 · PAY-001/003 · invoices & receipts ═══════════ -->
      <TabItem Header="Invoices">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ─────────────────────────────────────────────────────
               Refresh and Export are here because neither depends on a selected row. Everything
               that acts on one invoice lives in the drawer beside that invoice instead. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Invoices" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="InvoiceChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="InvoiceSubtitle" Style="{StaticResource DashSubheading}"
                           Text="Search, edit, post, receipts"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportInvoices" Content="Export CSV" Click="ExportInvoices_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Filters · client-side over the rows already fetched ───────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="130"/>
                <ColumnDefinition Width="1.4*" MinWidth="170"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="DATE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- DATE, not STATUS, on request.

                     What has gone with it: Sale / Cancelled, and the three payment states (Paid,
                     Pending, Overdue) that were derived from what is outstanding and when it fell
                     due. Those questions have no other control on this page now — the STATUS
                     column still SHOWS the answer per row, but there is no way to narrow by it.
                     Receivables is where the payment states are asked properly.

                     Ranges rather than a from/to pair, so the control is the same shape and width
                     as the one it replaces and the filter row does not reflow. Every range is
                     measured against invoice_date, the same column the DATE column shows. -->
<!-- The SAME control Sales entry uses for its date: AppDatePicker, a calendar,
                     not a list of ranges. One date field in the app, one way to pick a date.
                     Empty means every date, which is what Clear puts it back to. -->
                <DatePicker x:Name="InvoiceDateFilter" Width="150" Height="34"
                            SelectedDateChanged="InvoiceFilter_Changed"
                            Style="{StaticResource AppDatePicker}"
                            CalendarClosed="DatePicker_CalendarClosed"
                            AutomationProperties.Name="Filter by date"
                            AutomationProperties.HelpText="Shows the sales written on this date. Clear to show every date."/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="BUYER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- Built from the invoices that came back, so it can only offer buyers present. -->
                <ComboBox x:Name="InvoiceBuyer" Height="34" SelectionChanged="InvoiceFilter_Changed"
                          AutomationProperties.Name="Filter by buyer"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <Grid>
                  <TextBox x:Name="InvoiceSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by invoice no or buyer"
                           ToolTip="Filters the invoices already loaded. Matches invoice number, buyer name and amount."
                           TextChanged="InvoiceFilter_Changed"
                           AutomationProperties.Name="Search invoices"/>
                  <Button x:Name="InvoiceSearchClear" Click="ClearInvoiceSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearInvoiceFilters_Click"
                        Style="{StaticResource DashButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── List and detail ────────────────────────────────────────────── -->
          <Grid x:Name="InvoiceSplit" SizeChanged="InvoiceSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <!-- 420, not the 560 the room test uses. A MinWidth here is a floor on the GRID, so
                   the split reports itself 916px wide in an 788px page and the drawer then looks
                   affordable — the constraint has to live in the test, not in the column. -->
              <ColumnDefinition Width="*" MinWidth="420"/>
              <ColumnDefinition x:Name="InvoiceDetailGap" Width="0"/>
              <ColumnDefinition x:Name="InvoiceDetailCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashCard}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Invoice list" Style="{StaticResource DashHeading}"/>
                  <!-- The count and the outstanding total are in the page header, where every
                       other page keeps its totals. Repeating them here pushed a row of the table
                       off the bottom for no new information. -->
                  <TextBlock x:Name="InvoiceCount" Style="{StaticResource DashSubheading}"
                             Text="Select an invoice to record a receipt, print or cancel it"/>
                </StackPanel>

                <Grid>
                  <!-- Named for the same reason the buttons are: without it a screen reader reaches
                       this table and announces "table", with no clue which of the app's eleven it
                       landed on. The name is also what the NeedsRow* styles watch. -->
                  <!-- No HorizontalScrollBarVisibility="Disabled" here. It stops the star column
                       recomputing when the grid narrows, so opening the drawer left the buyer
                       column at its old width and the figures ran off the edge. Auto lets the
                       columns re-share the space, and shows a bar only if they truly cannot. -->
                  <DataGrid x:Name="InvoiceGrid"
                            SelectionChanged="InvoiceRow_Selected"
                            PreviewMouseWheel="InnerWheel"
                            AutomationProperties.Name="Invoices"
                            AutomationProperties.HelpText="Select an invoice to record a receipt, print or cancel it">
                    <DataGrid.Columns>
                      <!-- Every fixed column carries a floor. Without one the DataGrid keeps the star column's
                           MinWidth and takes the shortfall out of these instead: with the drawer open at a
                           1010px page the date column fell to 56px, which cannot show dd-MM-yyyy at all.
                           With floors the grid scrolls horizontally instead of shrinking anything. -->
                      <DataGridTextColumn Header="NO" Binding="{Binding InvoiceNo}" Width="130" MinWidth="130"/>
                      <DataGridTextColumn Header="DATE" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}" Width="95" MinWidth="95"/>
                      <!-- Buyer takes the slack, not Due. A date is a fixed 10 characters, so giving
                           it the star width left a wide empty gutter while long buyer names were
                           clipped. -->
                      <DataGridTextColumn x:Name="ColBuyer" Header="BUYER" Binding="{Binding BuyerName}" Width="*" MinWidth="160"/>
                      <!-- ClipboardContentBinding is what CSV export reads. Without it the column
                           is skipped and a CANCELLED invoice exports as though it were POSTED. -->
                      <DataGridTemplateColumn Header="STATUS" Width="110" MinWidth="110" SortMemberPath="Outstanding"
                                              ClipboardContentBinding="{Binding Status}"
                                              CellTemplate="{StaticResource StatusChip}"/>
                      <!-- How many lines are on it (0046). The drawer beside this list shows WHAT
                           they are; this says HOW MANY without a click, because the drawer opens
                           on selection and stands down on a narrow window. An invoice of two used
                           to read exactly like an invoice of one from here. -->
                      <DataGridTextColumn Header="LINES" Binding="{Binding LineCount}" Width="70" MinWidth="70"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountTotal, Converter={StaticResource Money}}" Width="135" MinWidth="135" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn x:Name="ColOutstanding" Header="OUTSTANDING" Binding="{Binding Outstanding, Converter={StaticResource Money}}" Width="135" MinWidth="135" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn x:Name="ColDue" Header="DUE" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="95" MinWidth="95"/>
                    </DataGrid.Columns>
                  </DataGrid>

                  <TextBlock Style="{StaticResource EmptyHint}"
                             Visibility="{Binding ItemsSource, ElementName=InvoiceGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}"
                             Text="No invoices match these filters.&#10;Clear the filters, or press Refresh."/>
                </Grid>
              </DockPanel>
            </Border>

            <!-- ── Detail drawer ────────────────────────────────────────────
                 Opens on selection. Every figure here is already on the row — no read happens when
                 a row is picked. The actions live here rather than in a toolbar because each one
                 acts on this invoice, and a disabled button floating above a list says less than
                 a live one beside the thing it will change. -->
            <Border x:Name="InvoiceDetailCard" Grid.Column="2" Style="{StaticResource DashCard}"
                    Visibility="Collapsed">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Invoice detail" Style="{StaticResource DashHeading}"/>
                    <TextBlock Text="{Binding InvoiceNo}" Style="{StaticResource DashSubheading}"/>
                  </StackPanel>
                  <Button x:Name="InvoiceDetailClose" Click="CloseInvoiceDetail_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="24" Height="24" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                          ToolTip="Close" AutomationProperties.Name="Close detail">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stretch="None"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>

                <!-- EVERYTHING BELOW THE HEADING SCROLLS.

                     The drawer used to be a DockPanel of Top-docked cards with the receipt block
                     docked Bottom and the facts filling what was left. A DockPanel hands each
                     child its DESIRED size in order and then simply runs out: on any window
                     shorter than the sum of the cards, the fill child got zero height — so
                     Amount, Received, Outstanding, Due and every receipt line vanished entirely —
                     and the Bottom-docked block was clipped mid-button. Nothing said so; the
                     content was just not there.

                     One ScrollViewer as the DockPanel's fill child answers both. It takes whatever
                     height is left after the heading, however much that is, and scrolls when the
                     cards want more. No card has a fixed height, so a tall window shows the lot
                     with no bar and a short one shows the same content on a bar.

                     HorizontalScrollBarVisibility Disabled, not Auto: the cards are meant to take
                     the drawer's width, and Auto would let a long buyer name widen the content and
                     put a horizontal bar under columns that fit perfectly well. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,2,0">
                  <StackPanel>

                <Border Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="{Binding BuyerName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <ContentPresenter Content="{Binding}"
                                        ContentTemplate="{StaticResource StatusChip}"/>
                      <TextBlock Text="{Binding InvoiceDate, StringFormat=dd MMM yyyy}"
                                 Style="{StaticResource TimelineMeta}" Margin="10,0,0,0"
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- ── The lines on this invoice ───────────────────────────────────
                     Reported as "only one row is saved" after confirming two. Both rows WERE
                     saved (the list's own AMOUNT column proved it, reading 4.00 K for a 1,000 and
                     a 3,000 line) but the Invoices page had no way to show them. It listed
                     invoices and, on selecting one, a header: buyer, status, date, receipts. The
                     lines were never on this screen at all, so an invoice of two looked exactly
                     like an invoice of one and there was no way to tell from here that anything
                     had been kept.

                     Filled by InvoiceRow_Selected. Not part of the invoice list query: lines are
                     read for the invoice actually being looked at, which is one round trip on a
                     click rather than a join across every invoice on the page. -->
                <Border Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="InvoiceLinesHeading" Text="LINES"
                               Style="{StaticResource KpiLabel}"/>
                    <!-- NO MaxHeight, and no scrollbar of its own. The cap was 220px, which is
                         five rows: a six-line invoice put a second scrollbar inside the drawer's
                         scrollbar and the two of them fought over the wheel. The drawer scrolls
                         now, so every line is simply drawn and the one bar carries the lot —
                         which is also what makes "the page shows fewer lines than I typed"
                         impossible to produce by scrolling.

                         CanContentScroll=False so the outer bar moves by pixel rather than by
                         row, and cannot stop half a line short of the bottom. -->
                    <DataGrid x:Name="InvoiceLinesGrid" Margin="0,8,0,0"
                              BorderThickness="0" Background="Transparent"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Lines on this invoice">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="GRADE" Binding="{Binding GradeShort}" Width="Auto" MinWidth="58"
                                            ElementStyle="{StaticResource GradeCellText}"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding SizeShort}" Width="Auto" MinWidth="52"
                                            ElementStyle="{StaticResource SizeCellText}"/>
                        <DataGridTextColumn Header="WT" Width="Auto" MinWidth="52"
                                            Binding="{Binding GrossWeightCt, StringFormat=N2}"
                                            ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="SEL" Width="Auto" MinWidth="52"
                                            Binding="{Binding SelectionCt, StringFormat=N2}"
                                            ElementStyle="{StaticResource Num}"/>
                        <DataGridTextColumn Header="AMOUNT" Width="*" MinWidth="72"
                                            Binding="{Binding Amount, Converter={StaticResource Money}}"
                                            ElementStyle="{StaticResource Num}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>

                <!-- ── Receipt · the same controls, the same handler, the same tab order,
                         now beside the invoice they apply to. -->
                <!-- Amount, Received, Outstanding, Due, and a row per receipt. It carried a
                     ScrollViewer of its own and was the DockPanel's FILL child, which is exactly
                     why it disappeared: fill gets whatever is left, and on a short window that was
                     nothing at all. Plain content inside the drawer's own scroller now, in the
                     place it already occupied on screen. -->
                <ItemsControl x:Name="InvoiceFacts" ItemTemplate="{StaticResource DetailFactRow}"
                              Margin="0,0,0,12"/>

                <!-- COLLAPSED, card and all. Hiding only the contents left the card itself
                     drawing: a Surface2 panel with a border, 24px of padding and nothing in it,
                     sitting under the facts as an empty box. A container whose every child is
                     hidden must go with them. -->
                <Border Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12" Margin="0,0,0,0">
                  <StackPanel>
                    <!-- RECORD A RECEIPT WAS HERE, and is gone on request.
                         Its controls stay in the tree, collapsed and out of the tab order, because
                         they are the only route in this app for booking cash against an invoice —
                         Receipt_Click, the receipt table, the Received and Outstanding figures on
                         every screen and the whole Receivables page all hang off them. Deleting the
                         controls would have meant deleting that path; hiding them takes the card off
                         this drawer and leaves the receipt to be given a home of its own.
                         Height 0 as well as Collapsed, so nothing here can claim layout. -->
                    <Grid Visibility="Collapsed" Height="0">
                      <TextBox x:Name="ReceiptAmount" IsTabStop="False"
                               AutomationProperties.Name="Receipt amount"/>
                      <ComboBox x:Name="ReceiptMethod" SelectedIndex="0" IsTabStop="False"
                                AutomationProperties.Name="Receipt method">
                        <ComboBoxItem>CASH</ComboBoxItem><ComboBoxItem>RTGS</ComboBoxItem><ComboBoxItem>CHEQUE</ComboBoxItem>
                      </ComboBox>
                      <Button x:Name="RecordReceipt" Content="Record receipt" Click="Receipt_Click"
                              IsTabStop="False"/>
                    </Grid>

                    <!-- A WrapPanel, not a horizontal StackPanel. The drawer's width is shared with
                         the invoice list and changes as the window does, and a StackPanel answers
                         "we do not fit" by running off the edge — which is how Cancel invoice lost
                         its right-hand half the moment a third button joined the row. Wrapping puts
                         the overflow on a second line instead. The bottom margin is on the buttons
                         rather than the panel so a wrapped row does not sit against the one above.
                         Same reasoning as the Sales entry header (docs/12). -->
<!-- UPDATE INVOICE, PRINT BILL and CANCEL INVOICE are off this drawer on request,
                         along with the receipt card above. The drawer is a read-only summary now:
                         who, when, what it came to, and the lines on it.

                         Kept in the tree, collapsed and untabbable, because their handlers are the
                         only routes to correcting a posted invoice, printing a bill and reversing
                         a sale's stock — and every Busy() scope on this page names all three. The
                         buttons are gone; the paths are intact and can be given a home. -->
                    <WrapPanel Visibility="Collapsed" Height="0">
                      <Button x:Name="EditDraftButton" Content="Edit memo" Click="EditDraft_Click"
                              IsEnabled="False" IsTabStop="False"/>
                      <Button x:Name="PrintBill" Content="Print bill" Click="PrintInvoice_Click"
                              IsTabStop="False"/>
                      <Button x:Name="CancelInvoiceButton" Content="Cancel invoice"
                              Click="CancelInvoice_Click" IsTabStop="False"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ PAY-002 · receivables ageing ════════════════════════════════ -->
      <TabItem Header="Receivables">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ───────────────────────────────────────────────────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Receivables" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="ReceivablesChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <!-- Keeps its name: the load handler writes the totals here, and on an empty run it
                     deliberately writes nothing rather than leaving a stale figure on screen. -->
                <TextBlock x:Name="ReceivablesSummary" Style="{StaticResource DashSubheading}"
                           Text="Ageing and collections"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ReceivablesExport" Content="Export CSV" Click="ExportReceivables_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Filters · client-side over the rows already fetched ───────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="130"/>
                <ColumnDefinition Width="1.4*" MinWidth="170"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="AGE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- Filled from the buckets that came back, so it can only offer ages present. -->
                <ComboBox x:Name="ReceivablesBucket" Width="140" Height="34"
                          SelectionChanged="ReceivablesFilter_Changed"
                          AutomationProperties.Name="Filter by age bucket"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="BUYER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="ReceivablesBuyer" Height="34" SelectionChanged="ReceivablesFilter_Changed"
                          AutomationProperties.Name="Filter by buyer"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <Grid>
                  <TextBox x:Name="ReceivablesSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by invoice no or buyer"
                           ToolTip="Filters the receivables already loaded. Matches the invoice number and the buyer name."
                           TextChanged="ReceivablesFilter_Changed"
                           AutomationProperties.Name="Search receivables"/>
                  <Button x:Name="ReceivablesSearchClear" Click="ClearReceivablesSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearReceivablesFilters_Click"
                        Style="{StaticResource DashButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Ageing · the run-on summary line, as five readable tiles ──────
               "Not due" is its own tile because it is its own fact: money that is not late at
               all used to sit inside "0 – 30 days", where the whole figure read as overdue on a
               page headed "Ageing and collections". Green stops at the due date now. -->
          <UniformGrid x:Name="ReceivablesKpiRow" DockPanel.Dock="Top" Columns="5" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Not due" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="RecKpiNotDue" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="RecKpiNotDueCount" Style="{StaticResource KpiCaption}" Text=""/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="1 – 30 days" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="RecKpiFresh" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="RecKpiFreshCount" Style="{StaticResource KpiCaption}" Text=""/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="31 – 60 days" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="RecKpi3060" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="RecKpi3060Count" Style="{StaticResource KpiCaption}" Text=""/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="61 – 90 days" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="RecKpi6190" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="RecKpi6190Count" Style="{StaticResource KpiCaption}" Text=""/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="90+ days" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="RecKpi90" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="RecKpi90Count" Style="{StaticResource KpiCaption}" Text=""/>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>

          <!-- ── List and buyer exposure ────────────────────────────────────── -->
          <Grid x:Name="ReceivablesSplit" SizeChanged="ReceivablesSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <!-- 420, not the 560 the room test uses. A MinWidth here is a floor on the GRID, so
                   the split reports itself 916px wide in an 788px page and the drawer then looks
                   affordable — the constraint has to live in the test, not in the column. -->
              <ColumnDefinition Width="*" MinWidth="420"/>
              <ColumnDefinition x:Name="ReceivablesDetailGap" Width="0"/>
              <ColumnDefinition x:Name="ReceivablesDetailCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashCard}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Outstanding invoices" Style="{StaticResource DashHeading}"/>
                  <TextBlock x:Name="ReceivablesCount" Style="{StaticResource DashSubheading}"
                             Text="Oldest first · select a row to see the buyer's position"/>
                </StackPanel>

                <Grid>
                  <DataGrid x:Name="ReceivablesGrid"
                            SelectionChanged="ReceivablesRow_Selected"
                            PreviewMouseWheel="InnerWheel"
                            AutomationProperties.Name="Receivables"
                            AutomationProperties.HelpText="Outstanding invoices by age">
                    <DataGrid.Columns>
                      <!-- Floors on every fixed column. Without them the grid takes the shortfall out of
                           these instead of scrolling, and a drawer opening beside the list shrinks the
                           date and the figures until they cannot be read. -->
                      <DataGridTextColumn Header="NO" Binding="{Binding InvoiceNo}" Width="130" MinWidth="130"/>
                      <!-- Buyer takes the slack; the ageing chip is a fixed-width badge and looked
                           stranded in a star column. -->
                      <DataGridTextColumn x:Name="RecColBuyer" Header="BUYER" Binding="{Binding BuyerName}"
                                          Width="*" MinWidth="150"/>
                      <DataGridTextColumn Header="DUE" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="95" MinWidth="95"/>
                      <DataGridTextColumn Header="OUTSTANDING" Binding="{Binding Outstanding, Converter={StaticResource Money}}" Width="140" MinWidth="140" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="DAYS OVERDUE" Binding="{Binding DaysOverdue}" Width="110" MinWidth="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTemplateColumn Header="BUCKET" Width="120" MinWidth="120" SortMemberPath="DaysOverdue"
                                              ClipboardContentBinding="{Binding AgeBucket}"
                                              CellTemplate="{StaticResource BucketChip}"/>
                    </DataGrid.Columns>
                  </DataGrid>

                  <TextBlock Style="{StaticResource EmptyHint}"
                             Visibility="{Binding ItemsSource, ElementName=ReceivablesGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}"
                             Text="Nothing outstanding.&#10;Either every invoice is settled, or none has been posted yet."/>
                </Grid>
              </DockPanel>
            </Border>

            <!-- ── Buyer exposure ───────────────────────────────────────────
                 One row on its own says little that the row does not already show. What a
                 collections call needs is the buyer's whole position — every unpaid invoice, the
                 oldest of them, and how it splits by age. All of it is grouped from the rows
                 already in memory; nothing is fetched when a row is picked. -->
            <Border x:Name="ReceivablesDetailCard" Grid.Column="2" Style="{StaticResource DashCard}"
                    Visibility="Collapsed">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Buyer position" Style="{StaticResource DashHeading}"/>
                    <TextBlock x:Name="ReceivablesDetailName" Style="{StaticResource DashSubheading}"/>
                  </StackPanel>
                  <Button x:Name="ReceivablesDetailClose" Click="CloseReceivablesDetail_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="24" Height="24" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                          ToolTip="Close" AutomationProperties.Name="Close detail">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stretch="None"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="TOTAL OUTSTANDING" Style="{StaticResource KpiLabel}"/>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="26" Margin="0,4,0,0">
                      <TextBlock x:Name="ReceivablesDetailTotal" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock x:Name="ReceivablesDetailMeta" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ReceivablesFacts" ItemTemplate="{StaticResource DetailFactRow}"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-002/003 · stock position ════════════════════════════════ -->
      <TabItem Header="Stock">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ───────────────────────────────────────────────────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Stock" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="StockChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <!-- Keeps its name: the load handler writes the totals here, and deliberately
                     writes nothing on an empty run rather than leaving a stale figure up. -->
                <TextBlock x:Name="StockSummary" Style="{StaticResource DashSubheading}"
                           Text="Grade × sieve-size position"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RunInvariants" Content="Run invariants" Click="Invariants_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"
                        AutomationProperties.HelpText="Checks that stock moved out matches stock invoiced"/>
                <Button x:Name="StockExport" Content="Export CSV" Click="ExportStock_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Filters · client-side over the rows already fetched ───────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="GRADE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="StockGradeFilter" ui:PickerSearch.On="True" Width="150" Height="34"
                          SelectionChanged="StockFilter_Changed"
                          AutomationProperties.Name="Filter by grade"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="SIZE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="StockSizeFilter" ui:PickerSearch.On="True" Width="120" Height="34"
                          SelectionChanged="StockFilter_Changed"
                          AutomationProperties.Name="Filter by size"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <Grid>
                  <TextBox x:Name="StockSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by grade code, grade name or size"
                           ToolTip="Filters the buckets already loaded. Matches grade code, grade name and size code."
                           TextChanged="StockFilter_Changed"
                           AutomationProperties.Name="Search stock"/>
                  <Button x:Name="StockSearchClear" Click="ClearStockSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,12,0">
                <!-- Most grade x size combinations have never been traded: 64 of 92 here. Showing
                     them all buries the 28 that matter and makes "Show movements" look broken,
                     because most rows a user lands on genuinely have no ledger. -->
                <!-- The stock WPF CheckBox template pins its foreground to the system control
                     text colour, which stays black whatever the app theme says, so the label was
                     unreadable in dark mode. FieldCheckBox is the app's themed one; its muted
                     default only reaches 2.98:1 on the dark surface, so this label takes the
                     primary ink — it labels a control, not a caption. -->
                <CheckBox x:Name="HideEmptyBuckets" Content="Hide empty buckets" IsChecked="True"
                          Style="{StaticResource FieldCheckBox}"
                          Foreground="{DynamicResource TextBrush}"
                          VerticalAlignment="Center" Height="34"
                          Checked="HideEmpty_Changed" Unchecked="HideEmpty_Changed"
                          AutomationProperties.HelpText="Hides grade and size combinations with no stock and no movements"/>
              </StackPanel>

              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearStockFilters_Click"
                        Style="{StaticResource DashButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Inventory summary ─────────────────────────────────────────── -->
          <UniformGrid x:Name="StockKpiRow" DockPanel.Dock="Top" Columns="5" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10"
                    ToolTip="What is left to sell: the ledger position less whatever sales entries are currently holding.">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <!-- "Carats held" said the opposite of what this figure is. It is what remains
                       AVAILABLE once the holds beside it are taken off, and the two tiles were
                       being read as the same word. -->
                  <TextBlock Text="Available carats" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="StockKpiCarats" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="StockKpiCaratsNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- Beside the available figure, not on the other side of the row: the two are one
                 sentence: what is left, and what is spoken for. Warning ink rather than danger,
                 because a hold is not a fault; it is stock somebody is in the middle of selling. -->
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10"
                    ToolTip="Carats a sales entry is holding: taken out of available stock the moment a line is typed, and not yet sold.&#10;&#10;Confirming the sale turns the hold into a sale. Move to stock releases it and the carats return to available stock.">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Reserved carats" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="StockKpiReserved" Style="{StaticResource KpiValue}" Margin="0"
                               Foreground="{DynamicResource WarningBrush}"/>
                  </Viewbox>
                  <TextBlock x:Name="StockKpiReservedNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Stock value" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="StockKpiValue" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="StockKpiValueNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Buckets in stock" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="StockKpiActive" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="StockKpiActiveNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Negative balances" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="StockKpiNegative" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="StockKpiNegativeNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>

          <!-- ── Stock breakdown ──────────────────────────────────────────────
               Held carats beside rejected carats. Deliberately its own card and not
               a fifth KPI tile: a tile in that row would read as another slice of
               what is in stock, and rejected carats are the opposite — they have
               already left. The card says so in words rather than relying on the
               reader to know.

               Both figures follow the GRADE / SIZE / SEARCH filters above, so the
               card always describes the same set as the list underneath it. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashCard}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- The tooltip carries the long form. The caption underneath has to work at a
                   glance; anyone who wants the whole explanation hovers. -->
              <StackPanel Grid.Column="0" Margin="0,0,28,0"
                          ToolTip="Total Stock is the position right now.&#10;&#10;The workbook figure is the position at the moment of the last import. Every sale, rejection, intake and adjustment recorded since then has moved it, so the two differ by exactly that trading.&#10;&#10;Re-import the workbook to bring them back together.">
                <TextBlock Text="TOTAL STOCK" Style="{StaticResource KpiLabel}"/>
                <TextBlock x:Name="StockBreakdownTotal" Style="{StaticResource KpiValue}"
                           Margin="0,4,0,0" Text="—"/>
                <TextBlock x:Name="StockBreakdownTotalNote" Style="{StaticResource KpiCaption}"
                           Text="Carats on hand"/>
              </StackPanel>

              <!-- A rule, not a plus sign: the two numbers do not add up to anything. -->
              <Border Grid.Column="1" Width="1" Margin="0,2,28,2"
                      Background="{DynamicResource BorderBrush}"/>

              <StackPanel Grid.Column="2">
                <TextBlock Text="REJECTION" Style="{StaticResource KpiLabel}"/>
                <TextBlock x:Name="StockBreakdownRejection" Style="{StaticResource KpiValue}"
                           Margin="0,4,0,0" Text="—"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock x:Name="StockBreakdownRejectionNote" Style="{StaticResource KpiCaption}"
                           Text="Carats rejected to date · already out of stock"/>
              </StackPanel>

              <TextBlock Grid.Column="3" x:Name="StockBreakdownScope"
                         Style="{StaticResource DashSubheading}"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         TextAlignment="Right"/>
            </Grid>
          </Border>

          <!-- ── Position and its ledger ────────────────────────────────────── -->
          <Grid x:Name="StockSplit" SizeChanged="StockSplit_SizeChanged">
            <!-- List and drawer, the same shape as Invoices and Receivables. Two tables side by
                 side never fitted: the position table wants 579px and the ledger 525px, and a
                 price per carat has no bounded width, so one of them always lost a column off the
                 edge. Stacking them fixed that and cost the list its height instead — four rows of
                 twenty-seven. The ledger belongs to one row of the list, so it opens beside that
                 row and closes again, and the list has the whole page the rest of the time. -->
            <Grid.ColumnDefinitions>
              <!-- 420, not the 560 the room test uses. A MinWidth here is a floor on the GRID, so
                   the split reports itself 916px wide in an 788px page and the drawer then looks
                   affordable — the constraint has to live in the test, not in the column. -->
              <ColumnDefinition Width="*" MinWidth="420"/>
              <ColumnDefinition x:Name="StockDetailGap" Width="0"/>
              <ColumnDefinition x:Name="StockDetailCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="StockPosCard" Grid.Column="0" Style="{StaticResource DashCard}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Stock position" Style="{StaticResource DashHeading}"/>
                    <TextBlock x:Name="StockCount" Style="{StaticResource DashSubheading}"
                               Text="Balance and value by grade and size"/>
                    <!-- Says which of two numbers this page is. A stock import replaces only the
                         movements it created, so on a book that has traded these totals are NOT
                         the workbook's — and the import dialog's figures were being read as the
                         position. Stated where the totals are read, not in a dialog that has
                         already been dismissed. -->
                    <TextBlock Style="{StaticResource DashSubheading}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Opacity="0.85"
                               Text="Current stock includes all movements after the last import. Workbook totals and bucket counts may differ."/>
                    <!-- The rule the whole page turns on, stated once where the numbers are read.
                         Available falling the moment a line is typed looked like stock going
                         missing, because nothing on this page named the hold that took it. -->
                    <TextBlock Style="{StaticResource DashSubheading}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Opacity="0.85"
                               Text="Available is what is left to sell: reserved carats are held by a sales entry from the moment its line is typed, until that sale is confirmed or the entry is moved back to stock."/>
                  </StackPanel>
                  <!-- The action moved here with the list it acts on: it is the selected row's
                       ledger it loads, and it was sitting in a panel that said nothing until it
                       had been pressed. -->
                  <Button Grid.Column="1" x:Name="ShowMovements" Content="Show movements"
                          Click="Movements_Click" VerticalAlignment="Center"
                          AutomationProperties.HelpText="Lists every movement for the selected grade and size"
                          Style="{StaticResource NeedsStockRow}"/>
                </Grid>

                <Grid>
                  <!-- The two identity columns stay put. Auto columns grow with the data, and one
                       intake at 4,00,00,37,500/ct widened VALUE enough to push the table past its
                       half of the page — at which point the grade and size a row belongs to were
                       the first things to scroll out of sight. -->
                  <DataGrid x:Name="StockGrid" FrozenColumnCount="2"
                            SelectionChanged="StockRow_Selected"
                            SizeChanged="SnapGridHeight"
                            VerticalAlignment="Top"
                            PreviewMouseWheel="InnerWheel"
                            AutomationProperties.Name="Stock position"
                            AutomationProperties.HelpText="Balance and value by grade and size">
                    <DataGrid.Columns>
                      <!-- Auto, not fixed pixels. This grid lives in half of the content area, and
                           the content area is the window minus the 210px rail — at 1400px that is
                           ~540px against 635px of fixed columns, so every cell was clipped: the
                           badge read "In stoc" and the sieve size "-6.". Auto sizes each column to
                           its own widest cell, and the star column takes whatever is left. -->
                      <!-- Star weights, not one star column and five fixed ones. VALUE used to absorb every
                           spare pixel — 1,376px of it on a wide window — and a left-aligned figure in a
                           column that wide reads as an empty table. Sharing the slack keeps the columns
                           spread across the card the way the Invoice list is, and the MinWidths below
                           still force a scrollbar rather than a squeeze when the room runs out. -->
                      <!-- The mark, matching the filter above and every other picker in the app.
                           The code and the full name are on the tooltip, so nothing is lost. -->
                      <DataGridTextColumn Header="GRADE" Binding="{Binding GradeShort}" Width="0.9*" MinWidth="66"
                                          ElementStyle="{StaticResource GradeCellText}"/>
                      <!-- The sieve as the sheet writes it, matching the filter above it. The
                           stored code is on the tooltip. -->
                      <DataGridTextColumn Header="SIZE" Binding="{Binding SizeShort}" Width="0.7*" MinWidth="54"
                                          ElementStyle="{StaticResource SizeCellText}"/>
                      <DataGridTemplateColumn Header="STATUS" Width="0.9*" MinWidth="90" SortMemberPath="BalanceCt"
                                              ClipboardContentBinding="{Binding BalanceCt, Converter={StaticResource StockState}}"
                                              CellTemplate="{StaticResource StockStatusBadge}"/>
                      <!-- AVAILABLE, not BALANCE. The figure has been net of reservations since
                           0043, and a column called BALANCE beside a bucket somebody is mid-sale on
                           reads as the ledger disagreeing with itself. RESERVED sits next to it so
                           the difference is on the row rather than only in the tiles above. -->
                      <DataGridTextColumn Header="AVAILABLE CT" Binding="{Binding BalanceCt, StringFormat=N4}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="RESERVED CT" Binding="{Binding ReservedCt, StringFormat=N4}" Width="1.1*" MinWidth="100" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="AVG COST" Binding="{Binding AvgCost, Converter={StaticResource Money}}" Width="1.1*" MinWidth="105" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn x:Name="StockColValue" Header="VALUE" Binding="{Binding StockValue, Converter={StaticResource Money}}" Width="1.3*" MinWidth="150" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <!-- Text is rewritten in ApplyStockFilter: "nothing loaded" and "everything
                       filtered out" are both an empty grid, and one message for both leaves a
                       working filter looking like a failed load. -->
                  <TextBlock x:Name="StockHint" Style="{StaticResource EmptyHint}"
                             Visibility="{Binding ItemsSource, ElementName=StockGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}"
                             Text="No stock positions.&#10;Press Refresh, or record an intake first."/>
                </Grid>
              </DockPanel>
            </Border>

            <!-- The drawer. DataContext is the selected bucket, set in StockRow_Selected. -->
            <Border x:Name="StockMoveCard" Grid.Column="2" Style="{StaticResource DashCard}"
                    Visibility="Collapsed">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Movements" Style="{StaticResource DashHeading}"/>
                    <!-- Names the bucket the ledger belongs to. -->
                    <TextBlock x:Name="MovementSubtitle" Style="{StaticResource DashSubheading}"
                               Text="Select a bucket in the list"/>
                  </StackPanel>
                  <Button x:Name="StockDetailClose" Click="CloseStockDetail_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="24" Height="24" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                          ToolTip="Close" AutomationProperties.Name="Close movements">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stretch="None"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>

                <!-- What the bucket holds, so the ledger has something to be read against. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel>
                    <ContentPresenter Content="{Binding}" HorizontalAlignment="Left"
                                      ContentTemplate="{StaticResource StockStatusBadge}"/>
                    <TextBlock Text="{Binding BalanceCt, StringFormat={}{0:N4} ct}"
                               Style="{StaticResource Num}" FontSize="15" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StockValue, StringFormat={}at {0:N2}}"
                               Style="{StaticResource TimelineMeta}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>

                <Grid>
                  <!-- Entries, not a five-column table. A 380px drawer cannot seat DATE, TYPE,
                       WEIGHT, PRICE and SOURCE side by side — a price per carat alone wants 137px
                       — and the table only ever held a handful of rows anyway. Stacked, every
                       figure is shown whole at any drawer width. -->
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                PreviewMouseWheel="InnerWheel">
                    <ItemsControl x:Name="MovementList"
                                  AutomationProperties.Name="Movements"
                                  AutomationProperties.HelpText="Ledger entries for the selected grade and size">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                  CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                              <Grid>
                                <TextBlock Text="{Binding MovementDate, StringFormat=dd MMM yyyy}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding MovementType}" HorizontalAlignment="Right"
                                           Style="{StaticResource TimelineMeta}"/>
                              </Grid>
                              <TextBlock Text="{Binding WeightCt, StringFormat={}{0:N4} ct}"
                                         Style="{StaticResource Num}" Margin="0,6,0,0"/>
                              <TextBlock Text="{Binding PricePerCt, Converter={StaticResource Money}, StringFormat={}{0} per ct}"
                                         Style="{StaticResource Num}" Margin="0,2,0,0"/>
                              <TextBlock Text="{Binding RefType}" Style="{StaticResource TimelineMeta}"
                                         Margin="0,4,0,0"/>
                              <!-- Mandatory on an adjustment and previously shown nowhere at all,
                                   so a correction could never be explained after the fact.
                                   Collapsed on the movement types that carry no reason. -->
                              <TextBlock Text="{Binding Reason}" Style="{StaticResource TimelineMeta}"
                                         TextWrapping="Wrap" Margin="0,4,0,0"
                                         Visibility="{Binding Reason, Converter={StaticResource Empty}, ConverterParameter=Invert}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <!-- Text is rewritten in Movements_Click: "nothing loaded yet" and "loaded, and
                       this bucket has no movements" are both empty, and saying the same thing for
                       each makes a finished load look like a button that did nothing. -->
                  <TextBlock x:Name="MovementHint" Style="{StaticResource EmptyHint}"
                             Visibility="{Binding ItemsSource, ElementName=MovementList, Converter={StaticResource Empty}}"
                             Text="Press Show movements&#10;to load this bucket's ledger."/>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ RPT · the client's own stock sheet, on screen ═══════════════════
           A deliberate copy of the workbook page the office already reads: grade
           down the side (twice, as they print it), each sieve size a WEIGHT and a
           RATE column, totals detached below the box.

           Built as a Grid of Borders in code rather than a DataGrid. The header
           has to span each column pair, the rules are heavier between size groups
           than between Weight and Rate, and the row label repeats on both flanks —
           none of which a DataGrid gives without fighting it. The Stock tab next
           door remains the sortable, filterable view; this one is the client's
           format, unchanged.

           Reads v_stock_position through Repo.StockAsync(), the same call the Stock
           page makes. Nothing is recomputed here: the only arithmetic is summing
           figures Postgres already produced, which is what the KPI tiles do too. -->
      <TabItem Header="Stock report">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Stock report" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="ReportChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="ReportSubtitle" Style="{StaticResource DashSubheading}"
                           Text="Grade × sieve, in the format the office already uses"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Which sizes, which rows ──────────────────────────────────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <!-- Two ROWS, not two columns.

                 The sieves sat beside the mode controls, which meant their line could only ever be
                 part of the toolbar however the split was weighted — and twelve checkboxes do not
                 fit in part of it. Widening their share moved the wrap from "1/3" to "+23" and no
                 further: the row stayed short by roughly the width of the controls next to it, so
                 the last box always fell off. Ratios were the wrong tool.

                 Given the whole width there is nothing to wrap. The controls keep the top line
                 beside the caption, where they have always had room; the sieves get a line of their
                 own spanning both columns. Column 1 stays star-sized so those controls still wrap
                 rather than clip on a narrow window, which is a separate defect this file has
                 already had once. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Row 0 · the caption and Reset on the left, the mode controls on the right -->
              <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,16,6">
                <!-- Reset sits with the caption, directly above the boxes it clears. It used to be
                     last in the row of mode controls on the far side of the toolbar, which put a
                     button nowhere near the thing it acts on and, once that row wrapped, alone on a
                     line of its own.

                     It is bordered rather than a bare ghost: with no outline "Reset" read as a
                     caption beside "SIZES" rather than as something to press. Secondary rather
                     than Primary keeps it from competing with Refresh. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <TextBlock Text="SIZES" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                  <Button x:Name="ReportReset" Content="Reset" Click="ResetStockReport_Click"
                          Style="{StaticResource AppButton}" Margin="12,0,0,0" Padding="12,2"
                          FontSize="11" MinHeight="24" Height="24" VerticalAlignment="Center"
                          AutomationProperties.Name="Reset the sieve selection and filters"
                          ToolTip="Put the sieve selection, Hide grades with no stock, and Show zero values back to their defaults."/>
                </StackPanel>
              </Grid>

              <!-- Centre, not Bottom: the block beside this is a caption over a WrapPanel, so its
                   height changes with the number of sieves and a bottom-aligned toolbar drifted
                   down the moment the sizes wrapped to a second line.

                   A WrapPanel, so that on a narrow window the controls drop to a second line rather
                   than run off the edge. The mode chip changes width with its own text — "Read
                   only" is half the length of "Edit mode · click a weight to correct it" — so this
                   row is not a fixed width even before the window is resized. -->
              <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <!-- Read only is the default and the safe state. Edit mode is hidden entirely from
                     anyone who could not save the change anyway: offering a switch that ends in a
                     refusal is worse than not offering it. -->
                <Border x:Name="ReportModeChip" Style="{StaticResource DashChip}"
                        Margin="0,0,12,4" VerticalAlignment="Center">
                  <TextBlock x:Name="ReportModeText" Style="{StaticResource DashChipText}"
                             Text="Read only"/>
                </Border>
                <CheckBox x:Name="ReportEditMode" Content="Edit mode" Click="ReportEditMode_Click"
                          Style="{StaticResource FieldCheckBox}" Foreground="{DynamicResource TextBrush}"
                          Margin="0,0,12,4" VerticalAlignment="Center"
                          ToolTip="Type a corrected weight into a cell. The difference is recorded as an adjustment on the stock ledger, with a reason — the calculated balance is never overwritten."/>
                <CheckBox x:Name="ReportHideEmpty" Content="Hide grades with no stock"
                          Style="{StaticResource FieldCheckBox}" Foreground="{DynamicResource TextBrush}"
                          Click="LoadStockReport_Click" Margin="0,0,12,4" VerticalAlignment="Center"/>
                <!-- ON by default, which is a reversal. The argument for off was that 297 cells of
                     0.00 bury the figures that mean something — true of a screen read on its own,
                     and wrong for the job this screen actually does. It exists to be held against
                     the client's printed sheet, and that sheet prints 0.00 in every empty cell.
                     A blank where the paper says 0.00 reads as a figure that failed to import,
                     which is exactly the report we got. Untick it for the sparse view. -->
                <CheckBox x:Name="ReportShowZeros" Content="Show zero values" IsChecked="True"
                          Style="{StaticResource FieldCheckBox}" Foreground="{DynamicResource TextBrush}"
                          Click="LoadStockReport_Click" Margin="0,0,12,4" VerticalAlignment="Center"
                          ToolTip="Print 0.00 in buckets holding nothing, the way the stock sheet does. Untick to leave an untraded bucket blank."/>
              </WrapPanel>

              <!-- Row 1 · every sieve, across the FULL width of the toolbar -->
                <!-- Filled from the catalogue on load, ticked for the ones the client's
                     sheet carries. Anything else in the Size Master can be added here
                     without the report needing to know about it in advance. -->
                <ItemsControl x:Name="ReportSizes" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
          </Border>

          <!-- ── The sheet ────────────────────────────────────────── -->
          <!-- Vertical only. The sheet does its own horizontal scrolling, one level in. -->
          <!-- Total Stock . Sales . On Hand, above the sheet they describe.
               The arithmetic holds by construction: Total is On hand plus Sales, so the row cannot
               disagree with itself whatever the sieve boxes and grade filters are set to.

               Rejections are deliberately NOT in this split. A rejection is carats that left as
               rejected rather than sold; folding them into Sales would say a parcel was sold when
               it was thrown back, and adding them to Total would break the identity. The Stock page
               carries the rejection figure. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashCard}" Margin="0,0,0,12"
                  Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,24,0"
                          ToolTip="Everything these grades and sieves held before their sales came out of them: what is on hand now, plus every carat sold out of them to date.">
                <TextBlock Text="TOTAL STOCK" Style="{StaticResource KpiLabel}"/>
                <TextBlock x:Name="ReportTotalStock" Style="{StaticResource KpiValue}"
                           Margin="0,4,0,0" Text="—"/>
                <TextBlock x:Name="ReportTotalStockNote" Style="{StaticResource KpiCaption}"
                           Text="On hand plus everything sold"/>
              </StackPanel>

              <TextBlock Grid.Column="1" Text="−" VerticalAlignment="Center" Margin="0,0,24,14"
                         FontSize="20" Foreground="{DynamicResource TextMutedBrush}"/>

              <StackPanel Grid.Column="2" Margin="0,0,24,0"
                          ToolTip="Carats that have left these buckets as SALE movements. The same rows the ledger and the reconciliation report read. Rejections are counted separately, on the Stock page.">
                <TextBlock Text="SALES" Style="{StaticResource KpiLabel}"/>
                <TextBlock x:Name="ReportSales" Style="{StaticResource KpiValue}"
                           Margin="0,4,0,0" Text="—"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock x:Name="ReportSalesNote" Style="{StaticResource KpiCaption}"
                           Text="Carats sold to date"/>
              </StackPanel>

              <TextBlock Grid.Column="3" Text="=" VerticalAlignment="Center" Margin="0,0,24,14"
                         FontSize="20" Foreground="{DynamicResource TextMutedBrush}"/>

              <StackPanel Grid.Column="4"
                          ToolTip="The position right now: the same figure the sheet below totals.">
                <TextBlock Text="ON HAND STOCK" Style="{StaticResource KpiLabel}"/>
                <TextBlock x:Name="ReportOnHand" Style="{StaticResource KpiValue}"
                           Margin="0,4,0,0" Text="—"
                           Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock x:Name="ReportOnHandNote" Style="{StaticResource KpiCaption}"
                           Text="Carats on hand"/>
              </StackPanel>

              <TextBlock Grid.Column="5" x:Name="ReportBandScope"
                         Style="{StaticResource DashSubheading}"
                         VerticalAlignment="Bottom" HorizontalAlignment="Right"
                         TextAlignment="Right"/>
            </Grid>
          </Border>

          <ScrollViewer x:Name="ReportScroll" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,4,0,24">

              <!-- The boxed title the printed sheet carries at the top. -->
              <Border x:Name="ReportTitleBox" BorderThickness="2" Padding="40,6"
                      BorderBrush="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                      Margin="0,0,0,18">
                <TextBlock x:Name="ReportTitle" Text="BKC" FontWeight="Bold" FontSize="15"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
              </Border>

              <!-- Rows and columns are built in code: the number of size pairs is not
                   known until the catalogue loads. -->
              <!-- The totals rows are drawn into THIS grid, not a second one beside it. Two grids
                   meant two sets of Auto columns sized to two different contents, and the totals
                   line came out offset from the columns it was totalling. -->
              <!-- The sheet gets its OWN horizontal scroller, and this is the whole point of it
                   being here rather than on the page outside: with vertical scrolling disabled it
                   is exactly as tall as the table, so its scrollbar sits immediately under the
                   last row instead of at the foot of a viewport that runs to the bottom of the
                   window. A scrollbar three hundred pixels below the thing it scrolls is a
                   scrollbar nobody finds.

                   Centred when it fits, by way of the outer Grid: content inside a horizontally
                   scrolling ScrollViewer is arranged at its own desired width, so a bare
                   HorizontalAlignment on the sheet does nothing and it sits against the left
                   margin. The wrapper's MinWidth is pinned to the viewport, so it is never
                   narrower than the window and never narrower than the sheet, so a sheet that fits
                   is centred inside it, and one that does not sets the extent and scrolls. -->
              <ScrollViewer x:Name="ReportSheetScroll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="ReportSheet_PreviewMouseWheel">
                <Grid MinWidth="{Binding ViewportWidth, ElementName=ReportSheetScroll}">
                  <Grid x:Name="ReportTable" HorizontalAlignment="Center"/>
                </Grid>
              </ScrollViewer>

              <TextBlock x:Name="ReportEmpty" Style="{StaticResource EmptyHint}"
                         Visibility="Collapsed" Margin="0,24,0,0"
                         Text="No stock in the selected sizes.&#10;Tick more sizes, or import the stock workbook."/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-001/004/005/006 · movements in ══════════════════════ -->
      <TabItem Header="Intake &amp; movements">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
          <!-- Every operation card is the same object: a titled panel with a one-line explanation
               of what pressing its button will do to stock. -->
          <Style x:Key="OpCard" TargetType="Border" BasedOn="{StaticResource DashCard}">
            <Setter Property="Margin" Value="0,0,0,14"/>
          </Style>
          <Style x:Key="OpField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,0"/>
          </Style>
          <Style x:Key="OpLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
          </Style>
        </TabItem.Resources>

        <!-- IsSharedSizeScope is what keeps the forms honest: the field columns size to the widest
             entry across ALL of them, so the four operations line up instead of each one starting
             wherever its own labels happen to end. -->
        <DockPanel Margin="16,14,16,14" Grid.IsSharedSizeScope="True">

          <!-- ── Header ──────────────────────────────────────────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Intake &amp; movements" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="MoveChip" Style="{StaticResource DashChipText}" Text="4 operations"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="MoveSummary" Style="{StaticResource DashSubheading}"
                           Text="Everything that puts carats into stock, moves them between buckets, or takes them out"/>
              </StackPanel>

              <!-- Reloads the catalogue behind the pickers and re-reads the bucket ledger on the
                   right. The session counters are deliberately left alone: they report what THIS
                   session recorded, and a refresh that zeroed them would erase the only trace. -->
            </Grid>
          </Border>

          <!-- ── What this session has recorded ──────────────────────────────
               Counts of what has been posted since the app opened, not a query — this page writes,
               it does not report, and a figure that looked like a total would be read as one. -->
          <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,-10,2"
                       SizeChanged="KpiRow_SizeChanged">
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Intakes" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="OpKpiIntake" Style="{StaticResource KpiValue}" Margin="0" Text="0"/>
                  </Viewbox>
                  <TextBlock x:Name="OpKpiIntakeNote" Style="{StaticResource KpiCaption}" Text="Recorded this session"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Conversions" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="OpKpiConvert" Style="{StaticResource KpiValue}" Margin="0" Text="0"/>
                  </Viewbox>
                  <TextBlock x:Name="OpKpiConvertNote" Style="{StaticResource KpiCaption}" Text="Carats moved, none created"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Rejections" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="OpKpiReject" Style="{StaticResource KpiValue}" Margin="0" Text="0"/>
                  </Viewbox>
                  <TextBlock x:Name="OpKpiRejectNote" Style="{StaticResource KpiCaption}" Text="Recorded this session"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}" Background="{DynamicResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Adjustments" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="OpKpiAdjust" Style="{StaticResource KpiValue}" Margin="0" Text="0"/>
                  </Viewbox>
                  <TextBlock x:Name="OpKpiAdjustNote" Style="{StaticResource KpiCaption}" Text="Always visible, never silent"/>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>

          <!-- ── Operations, and the ledger they write to ───────────────────────── -->
          <Grid x:Name="IntakeSplit" SizeChanged="IntakeSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition x:Name="IntakeGapCol" Width="16"/>
              <ColumnDefinition x:Name="IntakeLedgerCol" Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition x:Name="IntakeStackGap" Height="0"/>
              <RowDefinition x:Name="IntakeStackRow" Height="0"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
              <StackPanel>

                <!-- ── Rough intake ──────────────────────────────────── -->
                <Border Style="{StaticResource OpCard}">
                  <StackPanel>
                    <TextBlock Text="Rough intake" Style="{StaticResource DashHeading}"/>
                    <TextBlock Style="{StaticResource DashSubheading}" Margin="0,0,0,12"
                               Text="Puts a parcel into a grade × size bucket at the cost you paid for it · INV-001"/>
                    <WrapPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="GRADE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="IntakeGrade" Style="{StaticResource GradePicker}" Width="150" SelectionChanged="IntakeGrade_Changed"
                                  AutomationProperties.Name="Intake grade"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="SIZE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="IntakeSize" Style="{StaticResource SizePicker}" Width="110"
                                  AutomationProperties.Name="Intake size"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="WEIGHT CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="IntakeWeight" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 AutomationProperties.Name="Intake weight in carats"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="PRICE/CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="IntakePrice" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 ToolTip="Sets this parcel's cost basis. Zero is allowed, but it has to be typed."
                                 AutomationProperties.Name="Intake price per carat"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text=" " Style="{StaticResource OpLabel}"/>
                        <Button x:Name="IntakeButton" Content="Add intake" Click="Intake_Click" Height="34" MinWidth="120"
                                Style="{StaticResource AppPrimaryButton}"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- ── Conversion ────────────────────────────────────── -->
                <Border Style="{StaticResource OpCard}">
                  <StackPanel>
                    <TextBlock Text="Grade-to-grade conversion" Style="{StaticResource DashHeading}"/>
                    <TextBlock Style="{StaticResource DashSubheading}" Margin="0,0,0,12"
                               Text="&quot;Avelu&quot; · moves carats from one bucket to another. Total carats held do not change · INV-004"/>
                    <WrapPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="FROM GRADE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="ConvFromGrade" Style="{StaticResource GradePicker}" Width="150" SelectionChanged="ConvFromGrade_Changed"
                                  AutomationProperties.Name="Convert from grade"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="FROM SIZE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="ConvFromSize" Style="{StaticResource SizePicker}" Width="110"
                                  AutomationProperties.Name="Convert from size"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="TO GRADE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="ConvToGrade" Style="{StaticResource GradePicker}" Width="150" SelectionChanged="ConvToGrade_Changed"
                                  AutomationProperties.Name="Convert to grade"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="TO SIZE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="ConvToSize" Style="{StaticResource SizePicker}" Width="110"
                                  AutomationProperties.Name="Convert to size"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="WEIGHT CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="ConvWeight" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 AutomationProperties.Name="Conversion weight in carats"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="PRICE/CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="ConvPrice" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 ToolTip="Optional. Leave blank to carry the bucket's own cost across."
                                 AutomationProperties.Name="Conversion price per carat"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text=" " Style="{StaticResource OpLabel}"/>
                        <Button x:Name="ConvertButton" Content="Convert" Click="Convert_Click" Height="34" MinWidth="120"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- ── Rejection ─────────────────────────────────────── -->
                <Border Style="{StaticResource OpCard}">
                  <StackPanel>
                    <TextBlock Text="Rejection with dispositions" Style="{StaticResource DashHeading}"/>
                    <TextBlock Style="{StaticResource DashSubheading}" Margin="0,0,0,12"
                               Text="Takes carats out of a bucket and records what happened to them · INV-005/006"/>
                    <WrapPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="GRADE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="RejGrade" Style="{StaticResource GradePicker}" Width="150" SelectionChanged="RejGrade_Changed"
                                  AutomationProperties.Name="Rejection grade"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="SIZE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="RejSize" Style="{StaticResource SizePicker}" Width="110"
                                  AutomationProperties.Name="Rejection size"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="WEIGHT CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="RejWeight" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 AutomationProperties.Name="Rejection weight in carats"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="PRICE/CT" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="RejPrice" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 ToolTip="Optional. Leave blank to carry the bucket's own cost across."
                                 AutomationProperties.Name="Rejection price per carat"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text=" " Style="{StaticResource OpLabel}"/>
                        <Button x:Name="RejectButton" Content="Record rejection" Click="Reject_Click" Height="34" MinWidth="140"/>
                      </StackPanel>
                    </WrapPanel>

                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,10" Margin="0,14,0,0">
                      <StackPanel>
                        <TextBlock Text="DISPOSITIONS" Style="{StaticResource OpLabel}"/>
                        <TextBlock Style="{StaticResource DashSubheading}" Margin="0,0,0,8"
                                   Text="Weights must sum to the rejection (docs/04 §2.5). Leave empty to record a plain rejection."/>
                        <!-- Stored since 0018: record_rejection writes these to rejection_disposition
                             in the same transaction as the movement they describe. -->
                        <DataGrid x:Name="DispositionGrid" Height="132" IsReadOnly="False" CanUserAddRows="False"
                                  AutomationProperties.Name="Dispositions">
                          <DataGrid.Columns>
                            <!-- Template columns, not text columns. A DataGridTextColumn rests as a
                                 TextBlock and only becomes a box once clicked, so beside OUTCOME —
                                 whose ElementStyle IS a ComboBox and therefore always looks live —
                                 three of the four cells read as dead space. Always-visible editors
                                 make the whole row look like what it is: four fields to fill in.
                                 UpdateSourceTrigger=PropertyChanged so a value counts the moment it
                                 is typed, without needing the row to be committed first. -->
                            <DataGridTemplateColumn Header="WEIGHT CT" Width="Auto" MinWidth="110"
                                                    HeaderStyle="{StaticResource AppNumericHeader}">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBox Text="{Binding WeightCt, StringFormat=N4, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource NumEdit}" local:NumericInput.IsNumeric="True"
                                           AutomationProperties.Name="Disposition weight"/>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Without these it falls back to WPF's own combo chrome and renders 20px tall
                                 against the 32px every other input uses. -->
                            <DataGridComboBoxColumn Header="OUTCOME" SelectedValueBinding="{Binding Outcome}" Width="Auto" MinWidth="130"
                                                    ElementStyle="{StaticResource AppComboBox}"
                                                    EditingElementStyle="{StaticResource AppComboBox}">
                              <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                  <sys:String>RESELECT</sys:String><sys:String>REPAIR</sys:String><sys:String>REGRADE</sys:String>
                                  <sys:String>CULET</sys:String><sys:String>OTHER</sys:String>
                                </x:Array>
                              </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <!-- A list, not free text. The handler resolves this back to a grade_id by
                                 CODE, and an unrecognised one becomes null silently — so a typo used
                                 to record a REGRADE that regraded to nowhere. Choosing from the
                                 catalogue makes that impossible. -->
                            <DataGridTemplateColumn Header="TO GRADE (REGRADE ONLY)" Width="Auto" MinWidth="180">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <!-- ItemTemplate, not DisplayMemberPath — the same trap the Size and
                                       Grade columns on Sales entry document. This design's combo
                                       draws its closed state from SelectionBoxItemTemplate, which
                                       DisplayMemberPath does not populate, so the box fell back to
                                       ToString() and read "DiamondDesktop.Data.Grade". -->
                                  <ComboBox ItemsSource="{Binding Source={x:Static local:Catalogue.Grades}}"
                                            ItemTemplate="{StaticResource GradeNameTemplate}"
                                            ItemContainerStyle="{StaticResource GradeItemContainer}"
                                            SelectedValuePath="Code"
                                            SelectedValue="{Binding ToGradeCode, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource AppComboBox}"
                                            AutomationProperties.Name="Regrade to"/>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="NOTE" Width="*" MinWidth="120">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <!-- Placeholder over the box, the same idiom the Sales entry Size
                                       and Grade cells use: the border says a value can be typed,
                                       and this says what. Both, because an empty bordered box in a
                                       column headed NOTE still leaves the reader guessing whether
                                       it wants a code or a sentence. -->
                                  <Grid>
                                    <TextBox x:Name="DispositionNote"
                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CellTextBox}"
                                             AutomationProperties.Name="Disposition note"/>
                                    <TextBlock Text="why, in a few words" Style="{StaticResource CellPlaceholder}"
                                               Visibility="{Binding Note, Converter={StaticResource Empty}}"/>
                                  </Grid>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                          </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- ── Adjustment ────────────────────────────────────── -->
                <Border Style="{StaticResource OpCard}" Margin="0">
                  <StackPanel>
                    <TextBlock Text="Stock adjustment" Style="{StaticResource DashHeading}"/>
                    <TextBlock Style="{StaticResource DashSubheading}" Margin="0,0,0,12"
                               Text="Corrects a bucket up or down. Always visible, never silent — the reason is written to the ledger"/>
                    <WrapPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="GRADE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="AdjGrade" Style="{StaticResource GradePicker}" Width="150" SelectionChanged="AdjGrade_Changed"
                                  AutomationProperties.Name="Adjustment grade"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="SIZE" Style="{StaticResource OpLabel}"/>
                        <ComboBox x:Name="AdjSize" Style="{StaticResource SizePicker}" Width="110"
                                  AutomationProperties.Name="Adjustment size"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="WEIGHT CT (±)" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="AdjWeight" Width="110" Height="34"
                                 Style="{StaticResource AppNumericTextBox}"
                                 ToolTip="Negative takes carats out, positive puts them back."
                                 AutomationProperties.Name="Adjustment weight in carats"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text="REASON" Style="{StaticResource OpLabel}"/>
                        <TextBox x:Name="AdjReason" Width="240" Height="34"
                                 AutomationProperties.Name="Adjustment reason"/>
                      </StackPanel>
                      <StackPanel Style="{StaticResource OpField}">
                        <TextBlock Text=" " Style="{StaticResource OpLabel}"/>
                        <Button x:Name="AdjustButton" Content="Adjust" Click="Adjust_Click" Height="34" MinWidth="120"/>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>

            <!-- ── The ledger these operations write to ─────────────────────────
                 Same query the Stock page uses, for one bucket at a time — there is no
                 all-movements read, and this page is not the place to add one. -->
            <Border x:Name="IntakeLedgerCard" Grid.Column="2" Style="{StaticResource DashCard}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <TextBlock Text="Bucket ledger" Style="{StaticResource DashHeading}"/>
                  <TextBlock x:Name="LedgerSubtitle" Style="{StaticResource DashSubheading}"
                             Text="Pick a bucket to see what has moved through it"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="GRADE" Style="{StaticResource OpLabel}"/>
                    <ComboBox x:Name="LedgerGrade" Style="{StaticResource GradePicker}" SelectionChanged="LedgerGrade_Changed"
                              AutomationProperties.Name="Ledger grade"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="SIZE" Style="{StaticResource OpLabel}"/>
                    <ComboBox x:Name="LedgerSize" Style="{StaticResource SizePicker}" Width="92"
                              AutomationProperties.Name="Ledger size"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text=" " Style="{StaticResource OpLabel}"/>
                    <Button x:Name="LedgerLoad" Content="Load" Click="LedgerLoad_Click" Height="34" MinWidth="76"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                PreviewMouseWheel="InnerWheel">
                    <ItemsControl x:Name="LedgerList"
                                  AutomationProperties.Name="Bucket ledger"
                                  AutomationProperties.HelpText="Movements for the selected grade and size">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource SurfaceBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                  CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                              <Grid>
                                <ContentPresenter Content="{Binding}" HorizontalAlignment="Left"
                                                  ContentTemplate="{StaticResource MovementTypeBadge}"/>
                                <TextBlock Text="{Binding MovementDate, StringFormat=dd MMM yyyy}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource TimelineMeta}"/>
                              </Grid>
                              <TextBlock Text="{Binding WeightCt, StringFormat={}{0:N4} ct}"
                                         Style="{StaticResource Num}" Margin="0,8,0,0"/>
                              <TextBlock Text="{Binding PricePerCt, Converter={StaticResource Money}, StringFormat={}{0} per ct}"
                                         Style="{StaticResource Num}" Margin="0,2,0,0"/>
                              <TextBlock Text="{Binding RefType}" Style="{StaticResource TimelineMeta}"
                                         Margin="0,4,0,0"/>
                              <!-- Mandatory on an adjustment and previously shown nowhere at all,
                                   so a correction could never be explained after the fact.
                                   Collapsed on the movement types that carry no reason. -->
                              <TextBlock Text="{Binding Reason}" Style="{StaticResource TimelineMeta}"
                                         TextWrapping="Wrap" Margin="0,4,0,0"
                                         Visibility="{Binding Reason, Converter={StaticResource Empty}, ConverterParameter=Invert}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <!-- Rewritten in LedgerLoad_Click: "not asked for yet" and "asked for, and this
                       bucket has never moved" are both an empty list. -->
                  <TextBlock x:Name="LedgerHint" Style="{StaticResource EmptyHint}"
                             Visibility="{Binding ItemsSource, ElementName=LedgerList, Converter={StaticResource Empty}}"
                             Text="Pick a grade and size,&#10;then press Load."/>
                </Grid>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ MDM-001/002/004 · master data ═══════════════════════════════ -->
      <TabItem Header="Master data">
        <!-- Scrollbars for this page only. The previous attempt was an application-level
             implicit style, so it replaced every scrollbar in the app — and its Track had no
             bindings for Value/Minimum/Maximum/ViewportSize, which is what a Track needs to
             size and move its thumb. Both faults are fixed here. -->
        <TabItem.Resources>
          <!-- Opt in to the shared slim scrollbar. Keyed in Components.xaml and applied per
               page: as an application-level implicit style it would replace every scrollbar in
               the app, including the ones inside DataGrids. -->
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <!-- 16,14 like every other page. This one sat at 22,18, so its header and cards started
             six pixels further in than the page you switched from. -->
        <Grid Margin="16,14,16,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ── Header ─────────────────────────────────────────────────────
               The same object every other page opens with: mark, name, count
               chip, one line of purpose. This page had a bare title and no card,
               which is why it read as a different application. The window chrome
               already carries the connection pill and profile chip, so nothing
               here repeats them. -->
          <Border Grid.Row="0" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Master data" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="MasterChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource DashSubheading}"
                           Text="Diamond grades, buyers, brokers and pricing configuration"/>
              </StackPanel>

              <!-- The catalogue changes from other screens too — an import creates buyers and
                   brokers — so this page needs the same way back to the database as the rest. -->
            </Grid>
          </Border>

          <!-- ── Main · Grades 68% / sidebar 32%, stacking when narrow ──────── -->
          <Grid Grid.Row="1" x:Name="MasterSplit" SizeChanged="MasterSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="MainCol" Width="68*"/>
              <ColumnDefinition x:Name="GapCol" Width="18"/>
              <ColumnDefinition x:Name="SideCol" Width="32*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition x:Name="StackGap" Height="0"/>
              <RowDefinition x:Name="StackRow" Height="0"/>
            </Grid.RowDefinitions>

            <Border x:Name="GradesCard" Grid.Column="0" Style="{StaticResource CardContainer}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Grades" Style="{StaticResource CardTitle}"/>
                    <Border Style="{StaticResource CountBadge}">
                      <TextBlock x:Name="GradeCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                  </StackPanel>
                  <!-- Overlaid rather than templated: a Button inside the TextBox
                       ControlTemplate cannot carry a Click handler. -->
                  <StackPanel Grid.Column="2" Width="300" Margin="0,0,10,0">
                   <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                   <Grid>
                    <TextBox x:Name="GradeSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                             Tag="Search by grade code, name or alias"
                             TextChanged="GradeFilter_Changed"
                             AutomationProperties.Name="Search grades"/>
                    <!-- GhostButton, not a hand-rolled transparent Button: the default
                         ButtonBase template still draws a 1px border and WPF adds a focus
                         adorner on top, which is the box that appeared around the x. -->
                    <!-- A drawn cross, not a text glyph: "&#215;" sits wherever the font's
                         baseline puts it, which is why it kept landing low in the box. A Path is
                         centred by geometry. -->
                    <Button x:Name="GradeSearchClear" Click="ClearGradeSearch_Click"
                            Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                            Focusable="False" Width="20" Height="20" Padding="0"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                            Visibility="Collapsed" Cursor="Hand"
                            ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                      <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                            Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                   </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                   <TextBlock Text="STATUS" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="GradeStatusFilter" SelectedIndex="0"
                            Style="{StaticResource FilterDropdown}"
                            SelectionChanged="GradeStatus_Changed" PreviewMouseWheel="NoWheelChange"
                            AutomationProperties.Name="Filter grades by status">
                    <ComboBoxItem>All statuses</ComboBoxItem>
                    <ComboBoxItem>Active</ComboBoxItem>
                    <ComboBoxItem>Inactive</ComboBoxItem>
                  </ComboBox>
                  </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CardSubtitle}" Margin="2,10,0,0"
                           Text="Aliases are the spellings a workbook may use for a grade, separated by ; — an import resolves through them. Double-click a cell to edit. Code, name and order are read-only: they are referenced by imported invoices."/>


                <!-- SizeChanged, because the alias column draws a real input box and a table
                     that ends mid-row therefore ends mid-BOX. Every other grid in the app shows
                     plain text, where a clipped last row reads as "there is more below"; here it
                     read as a broken field. GradeArea_SizeChanged caps the grid at a whole number
                     of rows so the bottom edge always lands between them. -->
                <Grid x:Name="GradeArea" SizeChanged="GradeArea_SizeChanged">
                  <!-- WHOLE ROWS ONLY. The viewport is whatever the card has left over, and it is
                       not a multiple of the 42px row — so WPF draws the next row into the leftover
                       strip and cuts it wherever the strip ends. Every cell in ALIASES is a
                       bordered box, so a cut row reads as an input field with no bottom border
                       rather than as a row that is merely half on screen.
                       SnapRows below trims the grid to a whole number of rows. See the handler. -->
                  <DataGrid x:Name="GradeGrid" BorderThickness="0" VerticalAlignment="Top"
                            SizeChanged="GradeGrid_SizeChanged"
                            IsReadOnly="False" CellEditEnding="GradeAlias_Committed"
                            AutomationProperties.Name="Grades">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="110" IsReadOnly="True"/>
                      <!-- The mark the printed sheet uses, which is what every picker in the app now
                           shows. Listed beside the other two names rather than replacing either:
                           this grid is the catalogue itself, and it is the one place all three
                           spellings of a grade should be visible at once. -->
                      <DataGridTextColumn Header="ON THE SHEET" Binding="{Binding ShortName}" Width="110" IsReadOnly="True"/>
                      <DataGridTextColumn Header="GRADE NAME" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                      <!-- The one editable column here, and the only one with a floor under it.
                           Every other column is a fixed width, so the star column is the single
                           one that gives when the grid is narrow — and with nothing to stop it, it
                           gave all of it: rendered at 721px the field measured EIGHT pixels wide,
                           a sliver between GRADE NAME and ORDER with the aliases invisible inside
                           it. A field that can be squeezed to nothing is not a field.
                           "1BB;1 BB;NO1BB;NO 1BB" needs about 220. Past the floor the grid scrolls,
                           which is the right way to run out of room.

                           CellStyle, not ElementStyle: the frame changes, the binding and the
                           stored value do not. -->
                      <DataGridTextColumn Header="ALIASES" Binding="{Binding Aliases}"
                                          Width="*" MinWidth="240"
                                          CellStyle="{StaticResource EditableCell}"/>
                      <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="70" IsReadOnly="True"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTemplateColumn Header="STATUS" Width="100" IsReadOnly="True"
                                              CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                              Visibility="{Binding ItemsSource, ElementName=GradeGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}">
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No grades match"/>
                    <TextBlock Style="{StaticResource EmptyStateBody}"
                               Text="Clear the search box or change the status filter to see the full catalogue."/>
                  </StackPanel>
                </Grid>
              </DockPanel>
            </Border>

            <!-- ── Sidebar · one card, two tabs ────────────────────────────────
                 Two stacked cards each got half the height and both started
                 scrolling after two rows. Tabs give the visible list all of it. -->
            <Border x:Name="SidebarCard" Grid.Column="2" Style="{StaticResource CardContainerSoft}">
              <TabControl x:Name="PartyTabs" Style="{StaticResource SectionTabs}" Padding="0,4,0,0">
              <TabItem Style="{StaticResource SectionTabItem}">
                <!-- Count lives in the tab label, beside the word it counts. -->
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Buyers" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource CountBadge}" Margin="8,0,0,0" Padding="7,1,7,2">
                      <TextBlock x:Name="BuyerCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                  </StackPanel>
                </TabItem.Header>
                <!-- FocusedElement points at the list: without it the tab hands focus to the
                     first focusable child, the Add button, whose template then draws its focus
                     ring and makes the button look pressed the moment you open the tab. -->
                <DockPanel Margin="0,6,0,0" FocusManager.FocusedElement="{Binding ElementName=BuyerScroll}">
                  <Button DockPanel.Dock="Top" Margin="0,2,2,10" FocusVisualStyle="{x:Null}" Content="Add buyer" Click="AddBuyer_Click" HorizontalAlignment="Right"
                          Style="{StaticResource SecondaryAction}" MinWidth="104"/>
                  <ScrollViewer x:Name="BuyerScroll" VerticalScrollBarVisibility="Auto"
                                Focusable="True" PanningMode="VerticalOnly"
                                AutomationProperties.Name="Buyers">
                    <ItemsControl x:Name="BuyerGrid">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource PartyRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PartyName}"/>
                                <TextBlock Style="{StaticResource PartyMeta}"
                                           Text="{Binding DefaultTermsDays, StringFormat={}Payment terms · {0} days}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- A typo in a buyer name used to be permanent from inside the
                                     app: add was the only operation this page had. -->
                                <Button Content="Edit" Click="EditBuyer_Click" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryAction}" MinWidth="64"
                                        AutomationProperties.HelpText="Rename this buyer, change its terms, or deactivate it"/>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center"
                                                ContentTemplate="{StaticResource StatusBadgeTemplate}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              <TabItem Style="{StaticResource SectionTabItem}">
                <!-- Count lives in the tab label, beside the word it counts. -->
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Brokers" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource CountBadge}" Margin="8,0,0,0" Padding="7,1,7,2">
                      <TextBlock x:Name="BrokerCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                  </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="0,6,0,0" FocusManager.FocusedElement="{Binding ElementName=BrokerScroll}">
                  <Button DockPanel.Dock="Top" Margin="0,2,2,10" FocusVisualStyle="{x:Null}" Content="Add broker" Click="AddBroker_Click" HorizontalAlignment="Right"
                          Style="{StaticResource SecondaryAction}" MinWidth="104"/>
                  <ScrollViewer x:Name="BrokerScroll" VerticalScrollBarVisibility="Auto"
                                Focusable="True" PanningMode="VerticalOnly"
                                AutomationProperties.Name="Brokers">
                    <ItemsControl x:Name="BrokerGrid">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource PartyRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PartyName}"/>
                                <TextBlock Style="{StaticResource PartyMeta}"
                                           Text="{Binding DefaultBrokerPct, StringFormat={}Commission · {0:N2}%}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Edit" Click="EditBroker_Click" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryAction}" MinWidth="64"
                                        AutomationProperties.HelpText="Rename this broker, change its commission, or deactivate it"/>
                                <ContentControl Content="{Binding}" VerticalAlignment="Center"
                                                ContentTemplate="{StaticResource StatusBadgeTemplate}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              </TabControl>
            </Border>
          </Grid>

          <!-- ── Bottom tabs ────────────────────────────────────────────────── -->
          <Border Grid.Row="2" Style="{StaticResource CardContainer}" Margin="0,16,0,0" Height="286">
            <TabControl Style="{StaticResource SectionTabs}">
              <TabItem Header="Sieve Sizes" Style="{StaticResource SectionTabItem}">
                <Grid Margin="0,4,0,0">
                  <!-- Left-aligned and bounded: a star-width last column stretched four narrow
                       columns across the full card and left a field of empty table. -->
                  <DataGrid x:Name="SizeGrid" BorderThickness="0"
                            AutomationProperties.Name="Sieve sizes">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="*"/>
                      <!-- What the printed sheet calls it, which is what every picker in the app
                           now shows. Beside the code, never instead of it. -->
                      <DataGridTextColumn Header="ON THE SHEET" Binding="{Binding ShortName}" Width="*"/>
                      <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="*"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <!-- 0.2 and 0.25 are corrupt cells from the sales workbook (docs/04 §4.1),
                           kept in size_bucket only so the importer can resolve 46 lines. No grade
                           trades them. Listing them beside real sieve sizes with nothing to say so
                           is how someone eventually pairs one to a grade. -->
                      <DataGridTextColumn Header="SELLABLE" Binding="{Binding Code, Converter={StaticResource SellableSize}}"
                                          Width="*"/>
                      <!-- LOWER MM / UPPER MM are not shown. They are null for every size and have
                           been since the schema was written: docs/03 Q6 (sieve mm definitions) is
                           still unanswered, and nothing in the app reads them. Two permanently
                           blank columns read as missing data rather than as an open question.
                           The nullable columns stay in size_bucket — when Q6 is answered the data
                           has somewhere to land and these two lines come back. -->
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                              Visibility="{Binding ItemsSource, ElementName=SizeGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}">
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No sieve sizes"/>
                    <TextBlock Style="{StaticResource EmptyStateBody}" Text="Press Refresh to load the catalogue."/>
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Price Configuration" Style="{StaticResource SectionTabItem}">
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Left · what the price applies to. Right · the price itself. -->
                  <!-- Two columns: stacked in one, PRICE PER CARAT and Save fell off the
                       bottom of the card and could not be reached at all. -->
                  <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                      <TextBlock Text="GRADE" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceGradePicker" Style="{StaticResource GradePicker}" SelectionChanged="PriceGrade_Changed"
                                PreviewMouseWheel="NoWheelChange"
                                AutomationProperties.Name="Price list grade"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                      <TextBlock Text="SIZE" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceSizePicker" Style="{StaticResource SizePicker}" PreviewMouseWheel="NoWheelChange"
                                AutomationProperties.Name="Price list size"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                      <TextBlock Text="CONTEXT" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceContext" Height="34" SelectedIndex="0"
                                PreviewMouseWheel="NoWheelChange">
                        <ComboBoxItem>SALE</ComboBoxItem><ComboBoxItem>STOCK</ComboBoxItem><ComboBoxItem>REJECTION</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                      <TextBlock Text="PRICE PER CARAT" Style="{StaticResource FormLabel}"/>
                      <TextBox x:Name="PriceValue" MaxLength="12" Style="{StaticResource FormNumeric}"/>
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Save price"
                            Click="AddPrice_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="2,6,0,2" FocusVisualStyle="{x:Null}"
                            Style="{StaticResource PrimaryAction}"/>
                  </Grid>

                  <Grid Grid.Column="1">
                    <DataGrid x:Name="PriceGrid" BorderThickness="0"
                              AutomationProperties.Name="Price list">
                      <DataGrid.Columns>
                        <!-- Proportional, not one star column: a single * absorbed every spare
                             pixel, which is why the gap before FROM was always the widest. -->
                        <!-- The same mark as every other grid and every picker in the app, with
                             the stored code and the full name on the tooltip. This column used to
                             bind the raw code, so the price editor was the one page that called a
                             fifth of a carat "0.2" while the sheet, the stock table and its own
                             picker above all called it "1/5". -->
                        <DataGridTextColumn Header="GRADE" Binding="{Binding GradeShort}" Width="*"
                                            ElementStyle="{StaticResource GradeCellText}"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding SizeShort}" Width="*"
                                            ElementStyle="{StaticResource SizeCellText}"/>
                        <DataGridTextColumn Header="CONTEXT" Binding="{Binding Context}" Width="*"/>
                        <DataGridTextColumn Header="PRICE/CT" Binding="{Binding PricePerCt, Converter={StaticResource Money}}" Width="*"
                                            ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                        <DataGridTextColumn Header="FROM" Binding="{Binding EffectiveFrom, StringFormat=dd-MM-yy}" Width="*"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding ItemsSource, ElementName=PriceGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}">
                      <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No prices configured"/>
                      <TextBlock Style="{StaticResource EmptyStateBody}"
                                 Text="Choose a grade, size and context on the left, enter a price per carat, then press Save price."/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </TabItem>

      <!-- ══ PHASE 4 · owner dashboard · W1…W15 ══════════════════════════ -->
      <TabItem Header="Dashboard">
      <TabItem.Resources>
        <!-- Same scrollbars as Master Data, from the same keyed style. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
      </TabItem.Resources>
      <!-- The page scrolls. Every section above docks to the top and the breakdown is the last
           child, so it was handed whatever height was left over — which on a laptop screen is
           nothing. It was not hidden by a rule or a filter, it was squeezed to zero with no way
           to reach it. -->
      <ScrollViewer x:Name="DashScroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ─────────────────────────────────────────────────────
               Branding, who is signed in, what the connection is doing, and
               the three screens someone leaves the Dashboard for. The quick
               actions select tabs that already exist — none of them is a new
               command. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Solitaire Desk" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="DashSyncChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="DashGreeting" Style="{StaticResource DashSubheading}"
                           Text="Trading position at a glance"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DashCatalogue" Style="{StaticResource KpiCaption}"
                           Margin="0,0,16,0" VerticalAlignment="Center"/>
                <Button Content="New sale" Tag="Sales entry" Click="DashGo_Click"
                        Style="{StaticResource DashGoldButton}" Margin="0,0,8,0"/>
                <Button Content="Invoices" Tag="Invoices" Click="DashGo_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"/>
                <Button Content="Add stock" Tag="Intake &amp; movements" Click="DashGo_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"/>
                <!-- Filters now re-scope the page from cached rows, so nothing on screen refetches
                     by itself. This is the way to pull the position again after posting or an
                     intake — every other page already had one. -->
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Filters ────────────────────────────────────────────────────
               Same four filters and the same two handlers as before; only the
               arrangement and the labels changed. Search is client-side over
               the drill-down already in memory, so it costs no query. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <!-- One row, seven columns. A WrapPanel put Apply and Clear on a line of their own as
                 soon as the fixed widths outgrew the card. The three date controls keep a fixed
                 width because a date needs a known amount of room; Buyer, Grade and Search take
                 star widths so the row absorbs the window instead of wrapping. Search carries the
                 largest star, so it gives up space first when the window narrows. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <!-- The search column takes the larger share: its placeholder names four fields
                     and the two dropdowns beside it only have to show a buyer or a grade. -->
                <ColumnDefinition Width="*" MinWidth="104"/>
                <ColumnDefinition Width="0.85*" MinWidth="92"/>
                <ColumnDefinition Width="3.2*" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="RANGE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- No fixed width: at 118 "Financial year" read "Financial yea", and a guessed
                     number just moves the problem — 150 fitted the combo and starved the search box
                     beside it. Auto sizes to the longest entry and takes nothing it does not need. -->
                <ComboBox x:Name="RangePicker" Height="34" SelectedIndex="2"
                          SelectionChanged="Range_Changed">
                  <ComboBoxItem Tag="TODAY">Today</ComboBoxItem>
                  <ComboBoxItem Tag="WEEK">This week</ComboBoxItem>
                  <ComboBoxItem Tag="MONTH">This month</ComboBoxItem>
                  <ComboBoxItem Tag="QUARTER">This quarter</ComboBoxItem>
                  <ComboBoxItem Tag="FY">Financial year</ComboBoxItem>
                  <ComboBoxItem Tag="ALL">All time</ComboBoxItem>
                  <ComboBoxItem Tag="CUSTOM">Custom…</ComboBoxItem>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,6,0">
                <TextBlock Text="FROM" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <DatePicker x:Name="FromDate" Style="{StaticResource AppDatePicker}" Width="120"
                            Height="34" SelectedDateChanged="CustomDate_Changed"
                            CalendarClosed="DatePicker_CalendarClosed"
                            AutomationProperties.Name="Range from"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="TO" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <DatePicker x:Name="ToDate" Style="{StaticResource AppDatePicker}" Width="120"
                            Height="34" SelectedDateChanged="CustomDate_Changed"
                            CalendarClosed="DatePicker_CalendarClosed"
                            AutomationProperties.Name="Range to"/>
              </StackPanel>
              <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="BUYER" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="FilterBuyer" Height="34"
                          ItemTemplate="{StaticResource NameTemplate}"
                          ItemContainerStyle="{StaticResource PartyItemContainer}"
                          SelectionChanged="DashFilter_Changed"
                          AutomationProperties.Name="Filter by buyer"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Margin="0,0,8,0">
                <TextBlock Text="GRADE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="FilterGrade" Style="{StaticResource GradePicker}" SelectionChanged="DashFilter_Changed"
                          AutomationProperties.Name="Filter by grade"/>
              </StackPanel>
              <StackPanel Grid.Column="5" Margin="0,0,8,0">
                <!-- "SEARCH", not "SEARCH DRILL-DOWN": the label was the widest thing in this
                     column and would have held it open past what the row can spare. The box itself
                     now says what it searches. -->
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- Same construction as the Master Data search: the clear button is overlaid rather
                     than templated, because a Button inside the TextBox ControlTemplate cannot carry
                     a Click handler. -->
                <Grid>
                  <!-- Three fields in the placeholder, not the four it matches: this row also
                       carries a range, two dates, a buyer, a grade and two buttons, and the fourth
                       would not fit without starving the dropdowns. The tooltip has the full list. -->
                  <TextBox x:Name="DrillSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by invoice no, buyer or status"
                           ToolTip="Filters the invoices already listed below. Matches the invoice number, the buyer name and the status (paid, pending, overdue)."
                           TextChanged="DrillSearch_Changed"
                           AutomationProperties.Name="Search the drill-down list"/>
                  <Button x:Name="DrillSearchClear" Click="ClearDrillSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>
              <!-- Bottom-aligned rather than padded with a blank label: the buttons are 34 high,
                   the same as the inputs, so their baselines line up on their own. -->
              <!-- No Apply button. Every control in this row now applies itself the moment it
                   changes, so the button offered a second way to do what had already happened.
                   Worse, until it was pressed the range could read "Custom..." while the figures
                   below still described the previous period. Clear stays: resetting six controls
                   at once is worth one press. -->
              <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearFilters_Click"
                        Style="{StaticResource DashButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- W15 · alerts strip -->
          <Border DockPanel.Dock="Top" x:Name="AlertStrip" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="AlertText" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
          </Border>

          <!-- W1,W2,W3,W7,W9,W11,W14 · KPI tiles, grouped
               Same eleven elements and bindings as before; only the grouping and the
               chrome changed. No tile was added for a figure the RPC does not return. -->
          <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
            <TextBlock Text="Sales" Style="{StaticResource DashHeading}"/>
            <!-- Date range only. These four read dashboard_summary(p_from, p_to), an RPC that takes no
                 buyer or grade, so claiming they follow those filters was simply untrue — it is why
                 the tiles can say 13 invoices while the table below shows 1. -->
            <TextBlock Text="For the selected date range" Style="{StaticResource DashSubheading}"/>
            <!-- Shown only while a buyer or grade is set — see LoadDashboard_Click. -->
            <TextBlock x:Name="SalesScopeNote" Visibility="Collapsed" Margin="0,3,0,0"
                       FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="Grade is applied to sales through the invoice lines: every sales figure here is that grade's share of the invoices it appears on, not the whole of those invoices."/>
          </StackPanel>
          <!-- Columns follow the width (see KpiRow_SizeChanged): a fixed count clips when narrow,
               and a fixed tile width leaves the row short of the card edge when wide. -->
          <UniformGrid x:Name="KpiSalesRow" DockPanel.Dock="Top" Columns="4" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W1 · Total sales" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiSales" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock x:Name="KpiSalesDelta" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xF158;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W2 · Carats sold" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiCarats" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W3 · Blended rate / ct" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiRate" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W14 · Broker cost" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiBroker" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                  </StackPanel>
                </Grid>
              </Border>
          </UniformGrid>
          <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
            <TextBlock Text="Inventory" Style="{StaticResource DashHeading}"/>
            <TextBlock Text="Position as it stands now, not for the range above" Style="{StaticResource DashSubheading}"/>
          </StackPanel>
          <UniformGrid x:Name="KpiStockRow" DockPanel.Dock="Top" Columns="4" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W11 · Inventory value" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiInventory" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock x:Name="KpiInventoryCt" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W7 · Margin" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiMargin" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock x:Name="KpiMarginBasis" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="W9 · Outstanding" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiOutstanding" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock Text="Receivable across all posted invoices" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                  <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>
                      <TextBlock Text="Confirmed sales" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                             MaxHeight="27" Margin="0,6,0,0">
                      <TextBlock x:Name="KpiCount" Style="{StaticResource KpiValue}" Margin="0"/>
                    </Viewbox>
                    <TextBlock Text="In the selected range" Style="{StaticResource KpiCaption}"/>
                  </StackPanel>
                </Grid>
              </Border>
          </UniformGrid>
          <!-- Sales trend · drawn from the invoices already fetched for the drill-down.
               A fixed 100x40 canvas inside a Viewbox, so the points are computed once in chart
               space and the Viewbox does the scaling — no dependency on ActualWidth being
               settled, which is where hand-laid charts usually go wrong. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashCard}" Margin="0,0,0,12">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="Sales trend" Style="{StaticResource DashHeading}"/>
                  <TextBlock x:Name="TrendCaption" Style="{StaticResource DashSubheading}"/>
                </StackPanel>
                <TextBlock x:Name="TrendPeak" Style="{StaticResource ChartRowMeta}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource TrendSurface}" Height="180">
                <Grid>
                  <!-- No Viewbox. It scaled the stroke along with the geometry, and because the two
                       axes scale by very different factors the line rendered as a wedge. The canvas
                       fills the surface and RenderTrend plots into its real size. -->
                  <!-- Background="Transparent" is load-bearing: a Canvas with no brush is not
                       hit-testable in its empty areas, so only the 9px markers answered the mouse
                       and hovering anywhere between them did nothing at all. -->
                  <Canvas x:Name="TrendCanvas" ClipToBounds="True" Background="Transparent"
                          SizeChanged="TrendCanvas_SizeChanged"
                          MouseMove="TrendCanvas_MouseMove"
                          MouseLeave="TrendCanvas_MouseLeave">
                    <Polyline x:Name="TrendFill" Fill="{DynamicResource AccentSoftBrush}"
                              Stroke="{x:Null}"/>
                    <Polyline x:Name="TrendPath" Style="{StaticResource TrendLine}"/>

                    <!-- Drawn above every plotted point, so the nearest one reads as picked out
                         rather than merely pointed at. -->
                    <Line x:Name="TrendRule" Visibility="Collapsed" StrokeThickness="1"
                          Stroke="{DynamicResource BorderBrush}" StrokeDashArray="3 3"
                          Panel.ZIndex="90"/>
                    <Ellipse x:Name="TrendHighlight" Width="13" Height="13" Visibility="Collapsed"
                             Panel.ZIndex="91" IsHitTestVisible="False"
                             Fill="{DynamicResource AccentBrush}"
                             Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="2.5"/>
                    <!-- The card lives inside the Canvas, not in a Popup. A Popup is a separate
                         window: it needs a live PresentationSource to open, which makes it both
                         untestable offscreen and prone to z-order and clipping surprises. A Border
                         positioned on the canvas always renders and always clips with the chart. -->
                    <Border x:Name="TrendTip" Visibility="Collapsed" Panel.ZIndex="99"
                            IsHitTestVisible="False" CornerRadius="7" Padding="10,7"
                            Background="{DynamicResource TextBrush}">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="#000000"/>
                      </Border.Effect>
                      <StackPanel>
                        <TextBlock x:Name="TipWhen" FontSize="11"
                                   Foreground="{DynamicResource SurfaceBrush}" Opacity="0.75"/>
                        <TextBlock x:Name="TipValue" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SurfaceBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TipShare" FontSize="11"
                                   Foreground="{DynamicResource SurfaceBrush}" Opacity="0.75"/>
                      </StackPanel>
                    </Border>
                  </Canvas>

                  <TextBlock x:Name="TrendEmpty" Style="{StaticResource DashSubheading}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed"
                             Text="No invoices in this range to plot."/>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <!-- W4,W5,W6,W8,W10,W12,W13 · one bar list, seven breakdowns -->
          <!-- MinHeight because this is now the last child of a DockPanel inside a ScrollViewer:
               it is measured against infinite height, and the bar list's own ScrollViewer has no
               natural height of its own, so without a floor the whole section measures to zero. -->
          <Grid x:Name="DashSplit" Height="460" SizeChanged="DashSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="DashChartCol" Width="*"/>
              <ColumnDefinition x:Name="DashGapCol" Width="18"/>
              <ColumnDefinition x:Name="DashDrillCol" Width="470"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition x:Name="DashStackGap" Height="0"/>
              <RowDefinition x:Name="DashStackRow" Height="0"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="DashChartPanel" Grid.Column="0" Margin="0,8,8,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Revenue contribution" Style="{StaticResource DashHeading}"
                           Margin="0,0,12,0"/>
                <ComboBox x:Name="BreakdownPicker" Width="260" SelectedIndex="0" SelectionChanged="Breakdown_Changed">
                  <ComboBoxItem Tag="period">W4 · Sales by period</ComboBoxItem>
                  <ComboBoxItem Tag="salesperson">W5 · Sales by salesperson</ComboBoxItem>
                  <ComboBoxItem Tag="buyer">W6 · Sales by buyer</ComboBoxItem>
                  <ComboBoxItem Tag="ageing">W10 · Receivables ageing</ComboBoxItem>
                  <ComboBoxItem Tag="inventory">W11 · Inventory value by grade</ComboBoxItem>
                  <ComboBoxItem Tag="inventory-aging">W12 · Inventory aging</ComboBoxItem>
                  <ComboBoxItem Tag="broker-cost">W14 · Broker cost</ComboBoxItem>
                </ComboBox>
                <!-- Only "Sales by period" has a time axis to bucket, so this group collapses for
                     every other breakdown rather than leaving a hole in the header. The caption
                     goes with it: an unlabelled "day" beside a widget picker reads as a second
                     widget, which is what made it look like it came and went at random. -->
                <StackPanel x:Name="PeriodBucketGroup" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="grouped by" Style="{StaticResource DashSubheading}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="PeriodBucket" Width="90" SelectedIndex="0"
                            SelectionChanged="Breakdown_Changed"
                            AutomationProperties.Name="Group sales by day, week or month">
                    <ComboBoxItem>day</ComboBoxItem><ComboBoxItem>week</ComboBoxItem><ComboBoxItem>month</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="InnerWheel">
                <ItemsControl x:Name="BarList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- Same four bindings as before. The track behind the bar is what turns
                           a ragged row of blocks into a chart: a short bar now reads against the
                           full scale instead of floating on its own. -->
                      <Grid Margin="0,3" Height="30">
                        <!-- The row's own figures, not a restatement of the label. -->
                        <Grid.ToolTip>
                          <!-- ContentTemplate cleared: this is the one tooltip in the app whose
                               content is a composed panel rather than a string, and the implicit
                               ToolTip style in AppOverrides renders its content as wrapped TEXT.
                               Left alone it would print the StackPanel's type name. Opting out
                               here keeps that fix global without a template selector. -->
                          <ToolTip ContentTemplate="{x:Null}">
                            <StackPanel>
                              <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding ValueText}" Margin="0,3,0,0"/>
                              <TextBlock Text="{Binding Secondary}"
                                         Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                          </ToolTip>
                        </Grid.ToolTip>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   Style="{StaticResource ChartRowLabel}" Margin="0,0,12,0"/>
                        <!-- Star widths, not a pixel width. The bar used to be scaled to a fixed
                             420px inside a track that takes whatever width is going, so the
                             largest value filled about two thirds of its track and read as a
                             fraction of itself. Two star columns make the bar an exact share of
                             the track at any window size. -->
                        <Grid Grid.Column="1" Margin="0,0,12,0">
                          <Border Style="{StaticResource ChartTrack}"/>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding BarStar}"/>
                              <ColumnDefinition Width="{Binding RestStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ChartBar}"
                                    HorizontalAlignment="Stretch"/>
                          </Grid>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DeltaText}" FontSize="11" Margin="0,0,10,0"
                                     Foreground="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Secondary}" Style="{StaticResource ChartRowMeta}"
                                     Margin="0,0,10,0"/>
                          <TextBlock Text="{Binding ValueText}" Style="{StaticResource ChartRowValue}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- drill-down: the invoices behind whatever is filtered -->
            <Border x:Name="DashDrillCard" Grid.Column="2" Style="{StaticResource DashCard}" Margin="0,12,0,0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Invoices in this view" Style="{StaticResource DashHeading}"/>
                    <TextBlock x:Name="DrillCount" Style="{StaticResource DashSubheading}"/>
                  </StackPanel>
                </Grid>
                <!-- Sorting is the DataGrid's own: every column below binds a real property, and
                     the status column declares SortMemberPath so a template column sorts too. -->
                <DataGrid x:Name="DrillGrid" BorderThickness="0" CanUserSortColumns="True"
                          PreviewMouseWheel="InnerWheel">
                  <DataGrid.Columns>
                    <!-- Auto, not 118. "INV-2026-00004" is fourteen characters, which at this
                         font comes to about 101px, and the cell charges 10px of padding on each
                         side: 121. At 118 the last digit was cut off, so every invoice on the
                         card read as INV-2026-0000 and two of them looked like the same invoice.
                         Auto measures the real values, so it stays right when the year rolls over
                         or the numbering passes five digits. MinWidth keeps the header from
                         setting the floor on an empty card. -->
                    <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNo}"
                                        Width="Auto" MinWidth="132">
                      <DataGridTextColumn.ElementStyle>
                        <!-- Only for a value genuinely longer than Auto can place: it ellipsises
                             rather than cutting mid-character, and the whole number is on hover.
                             With Auto this should never fire; it is here so that if it ever does,
                             it reads as truncated rather than as a different invoice. -->
                        <Style TargetType="TextBlock">
                          <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Setter Property="ToolTip" Value="{Binding InvoiceNo}"/>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="BUYER" Binding="{Binding BuyerName}" Width="*"/>
                    <!-- ScopedAmount, not AmountTotal: with a grade filter set this is that
                         grade's share of the invoice, so the column adds up to the tile above it.
                         Without one it is the invoice total, unchanged. -->
                    <DataGridTextColumn Header="AMOUNT" Width="120"
                                        Binding="{Binding ScopedAmount, Converter={StaticResource Money}}"
                                        ElementStyle="{StaticResource Num}"
                                        HeaderStyle="{StaticResource AppNumericHeader}"/>
                    <DataGridTextColumn Header="DATE" Width="96"
                                        Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}"/>
                    <DataGridTemplateColumn Header="STATUS" Width="104"
                                            SortMemberPath="Outstanding"
                                            CellTemplate="{StaticResource DrillStatusTemplate}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </ScrollViewer>
    </TabItem>

      <!-- ══ AUD-001 · audit, AUTH-002 · users, CFG · settings ═══════════ -->
      <TabItem Header="Audit">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ─────────────────────────────────────────────────────
               Summary and the one action this screen has. Refresh is the only
               command that existed and the only one here: nothing was invented
               to fill the space. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Audit trail" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="AuditChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="AuditSpan" Style="{StaticResource DashSubheading}"
                           Text="Every change, who and when"/>
              </StackPanel>

            </Grid>
          </Border>

          <!-- ── Filters · client-side over the rows already fetched ─────────
               Repo.AuditAsync is untouched and still returns the same 500 rows.
               Everything below narrows what is shown, not what is asked for. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="1.5*" MinWidth="170"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="ACTION" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="AuditAction" Width="132" Height="34" SelectedIndex="0"
                          SelectionChanged="AuditFilter_Changed"
                          AutomationProperties.Name="Filter by action">
                  <ComboBoxItem Tag="">All actions</ComboBoxItem>
                  <ComboBoxItem Tag="INSERT">Insert</ComboBoxItem>
                  <ComboBoxItem Tag="UPDATE">Update</ComboBoxItem>
                  <ComboBoxItem Tag="DELETE">Delete</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="ENTITY" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- Filled from the rows that came back, so it can only ever offer entities that
                     are actually present. -->
                <ComboBox x:Name="AuditEntity" Height="34" SelectionChanged="AuditFilter_Changed"
                          AutomationProperties.Name="Filter by entity"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <Grid>
                  <TextBox x:Name="AuditSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by entity, action, record or who"
                           ToolTip="Filters the entries already loaded. Matches the entity, the action and the record id — not the field values."
                           TextChanged="AuditFilter_Changed"
                           AutomationProperties.Name="Search the audit trail"/>
                  <Button x:Name="AuditSearchClear" Click="ClearAuditSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearAuditFilters_Click"
                        Style="{StaticResource DashButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Activity summary · counted from the loaded rows ───────────── -->
          <UniformGrid x:Name="AuditKpiRow" DockPanel.Dock="Top" Columns="4" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Events shown" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="AuditKpiTotal" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="AuditKpiTotalNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"
                        Background="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Inserts" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="AuditKpiInsert" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <!-- Rewritten in ApplyAuditFilter when the 500-row window is full: a zero here
                       means "none in this window", never "none ever". -->
                  <TextBlock x:Name="AuditKpiInsertNote" Text="Rows created" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"
                        Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Updates" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="AuditKpiUpdate" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="AuditKpiUpdateNote" Text="Rows amended" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"
                        Background="{DynamicResource DangerBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Deletes" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="AuditKpiDelete" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="AuditKpiDeleteNote" Text="Rows removed" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>

          <!-- ── Timeline + table ───────────────────────────────────────────── -->
          <Grid x:Name="AuditSplit" SizeChanged="AuditSplit_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="AuditTimelineCol" Width="300"/>
              <ColumnDefinition x:Name="AuditGapCol" Width="16"/>
              <ColumnDefinition Width="*" MinWidth="360"/>
              <ColumnDefinition x:Name="AuditDetailGap" Width="0"/>
              <ColumnDefinition x:Name="AuditDetailCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AuditTimelineCard" Grid.Column="0" Style="{StaticResource DashCard}"
                    Margin="0,8,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <TextBlock Text="Recent activity" Style="{StaticResource DashHeading}"/>
                  <TextBlock Text="Newest first" Style="{StaticResource DashSubheading}"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="AuditTimeline">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid MinHeight="46">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <!-- Rail behind, dot in front: the thread stays unbroken between rows
                               whatever height each one takes. -->
                          <Border Grid.Column="0" Style="{StaticResource TimelineRail}"/>
                          <Border Grid.Column="0" Style="{StaticResource TimelineDot}"/>
                          <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="{Binding Time}" Style="{StaticResource TimelineTime}"/>
                            <TextBlock Text="{Binding Entity}" Style="{StaticResource TimelineTitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                              <ContentPresenter Content="{Binding}"
                                                ContentTemplate="{StaticResource AuditActionBadge}"/>
                              <TextBlock Text="{Binding Record}" Style="{StaticResource TimelineMeta}"
                                         Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource TimelineMeta}"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashCard}" Margin="0,8,0,0">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Change log" Style="{StaticResource DashHeading}"/>
                    <TextBlock x:Name="AuditCount" Style="{StaticResource DashSubheading}"
                               Text="Select a row to see the fields that changed"/>
                  </StackPanel>
                </Grid>
                <!-- RowDetails, not two columns of flattened text. The old Before/After columns
                     held "k=v, k=v, …" that ran off the edge and could not be read; the same
                     values are now a field-by-field table under the selected row. -->
                <!-- Selecting a row opens the drawer beside the table rather than pushing the
                     rows apart. In-row details also fought AppRow, which pins DataGridRow to a
                     fixed 42px and clipped the panel to a sliver. -->
                <!-- No horizontal scrollbar: CHANGES is a star column, so the table always fits its
                     own width. The bar that appeared was the vertical scrollbar stealing a few
                     pixels and pushing the total over by that much. -->
                <!-- RowHeight="NaN" is Auto: AppDataGrid PINS it at 42, which clips a wrapped
                     cell to its first line and makes the wrapping above look like it did nothing.
                     MinRowHeight keeps 42 as the floor, so a one-line entry is unchanged. -->
                <DataGrid x:Name="AuditGrid" BorderThickness="0" CanUserSortColumns="True"
                          RowHeight="NaN" MinRowHeight="42"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="AuditRow_Selected"
                          PreviewMouseWheel="InnerWheel">
                  <DataGrid.Columns>
                    <!-- Widths trimmed to what each column actually needs. WHAT HAPPENED is the
                         star column, so it gets only what the fixed five leave — and at 642px
                         of them it was left about 150, which cut "Sale confirmed, stock moved out"
                         to "Sale confirmed - stock r". Every figure below is measured against its
                         own longest real value: a timestamp, "Stock reservation", the widest
                         badge, "#1030", and a login name. -->
                    <!-- Local, not UTC: see AuditRow.LocalAt. The desk reads this against the
                         clock on its own wall. -->
                    <!-- Auto, not a figure I measured by eye. 132 cut "31-08-2026 15:18:29" to
                         "...15:18:2" and 118 cut "Stock reservation" to "Stock reservatior". That
                         is the second time trimming these by hand has been wrong. Auto sizes to the real
                         values, so a longer login name or a new entity name cannot cut either.
                         Affordable now only because WHAT HAPPENED wraps: it no longer needs to win
                         the width these give up. -->
                    <DataGridTextColumn Header="WHEN" Binding="{Binding When}" Width="Auto" MinWidth="132"/>
                    <DataGridTextColumn Header="ENTITY" Binding="{Binding EntityName}" Width="Auto" MinWidth="118"/>
                    <DataGridTemplateColumn Header="ACTION" Width="94"
                                            SortMemberPath="Action"
                                            CellTemplate="{StaticResource AuditActionBadge}"/>
                    <!-- 74, not 62. Trimming to the widest VALUE ("#1030") left the column too
                         narrow for its own HEADING, which rendered as "RECORE". -->
                    <DataGridTextColumn Header="RECORD" Binding="{Binding Record}" Width="74"/>
                    <!-- The page is titled "Every change, who and when" and showed only the when.
                         changed_by was captured and mapped all along; nothing bound it. -->
                    <DataGridTextColumn Header="WHO" Binding="{Binding By}" Width="Auto" MinWidth="90"/>
                    <!-- What happened, not which columns moved. Summary is still the field list
                         and still carries the detail drawer; this column answers the question the
                         page is opened with.

                         MinWidth so a narrow window steals from the others rather than from this;
                         ellipsis and a tooltip so that when it IS cut the reader can see that it
                         was, and read the rest without opening the drawer. It was clipping bare,
                         which reads as a value that ends there. -->
                    <DataGridTextColumn Header="WHAT HAPPENED" Binding="{Binding What}"
                                        Width="*" MinWidth="240">
                      <DataGridTextColumn.ElementStyle>
                        <!-- No BasedOn: a DataGridTextColumn's ElementStyle overrides the grid's
                             own cell text, so inheriting from a named style here would drop the
                             alignment and padding the other columns get from the cell. These two
                             setters are all this column needs on top of that. -->
                        <!-- WRAPS. Widening was the wrong fix and twice was enough: this card
                             shares its row with Recent activity and the detail drawer, so there is
                             no width to win and the description was still cut at "Reservation
                             released, 2 ct, confirmed, retu...". Wrapping ends the argument: a
                             row grows to fit its own sentence, whatever the window is doing. The
                             grid's RowHeight is released to Auto below so the taller row can
                             actually draw, with MinRowHeight keeping the old 42 as the floor so
                             single-line rows look exactly as they did. -->
                        <Style TargetType="TextBlock">
                          <Setter Property="TextWrapping" Value="Wrap"/>
                          <Setter Property="VerticalAlignment" Value="Center"/>
                          <Setter Property="Margin" Value="0,7"/>
                          <Setter Property="ToolTip" Value="{Binding What}"/>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>

                </DataGrid>
              </DockPanel>
            </Border>
            <!-- Detail drawer. Opens on selection, closes with the row. Its DataContext is the
                 selected AuditRow, set in AuditRow_Selected: no query runs, the entry is already
                 in memory. -->
            <Border x:Name="AuditDetailCard" Grid.Column="4" Style="{StaticResource DashCard}"
                    Margin="0,8,0,0" Visibility="Collapsed">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Entry detail" Style="{StaticResource DashHeading}"/>
                    <TextBlock Text="{Binding When}" Style="{StaticResource DashSubheading}"/>
                  </StackPanel>
                  <Button x:Name="AuditDetailClose" Click="CloseAuditDetail_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="24" Height="24" Padding="0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                          ToolTip="Close" AutomationProperties.Name="Close detail">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stretch="None"
                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>

                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Entity}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <ContentPresenter Content="{Binding}"
                                        ContentTemplate="{StaticResource AuditActionBadge}"/>
                      <TextBlock Text="{Binding Record}" Style="{StaticResource TimelineMeta}"
                                 Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Says once what an insert has no previous values, so the rows below can
                         drop the empty half without anything going unsaid. -->
                    <TextBlock Text="{Binding Nature}" Style="{StaticResource TimelineMeta}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="AuditDetailFields" ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource AuditFieldRow}">
                          <StackPanel>
                            <TextBlock x:Name="FieldName" Text="{Binding Name}"
                                       Style="{StaticResource AuditFieldName}"/>

                            <!-- One side only — an insert's new value, a delete's last value.
                                 Labelling it BEFORE/AFTER when there is nothing to compare it
                                 with adds a word and a dash per row and no information. -->
                            <TextBlock x:Name="SingleValue" Text="{Binding OnlyValue}"
                                       Style="{StaticResource AuditFieldAfter}" Margin="0,2,0,0"/>

                            <!-- Both sides — the comparison the labels exist for. Stacked rather
                                 than side by side: at drawer width two columns leave each about
                                 80px, which truncates every value worth reading. -->
                            <Grid x:Name="BothSides" Margin="0,3,0,0" Visibility="Collapsed">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/><ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Grid.Column="0" Text="BEFORE"
                                         Style="{StaticResource AuditDetailHeader}" Margin="0,0,8,2"/>
                              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BeforeText}"
                                         Style="{StaticResource AuditFieldBefore}" Margin="0,0,0,2"/>
                              <TextBlock Grid.Row="1" Grid.Column="0" Text="AFTER"
                                         Style="{StaticResource AuditDetailHeader}" Margin="0,0,8,0"/>
                              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AfterValue"
                                         Text="{Binding AfterText}"
                                         Style="{StaticResource AuditFieldAfter}"/>
                            </Grid>
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding HasBoth}" Value="True">
                            <Setter TargetName="SingleValue" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BothSides" Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Changed}" Value="True">
                            <Setter TargetName="FieldName" Property="Foreground"
                                    Value="{DynamicResource AccentStrongBrush}"/>
                            <Setter TargetName="AfterValue" Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource EmptyHint}"
                     Visibility="{Binding ItemsSource, ElementName=AuditGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}"
                     Text="No audit entries match these filters.&#10;Clear the filters, or press Refresh."/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Users" x:Name="UsersTab">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ─────────────────────────────────────────────────────
               Read-only by design: creating or disabling a Supabase account needs the service_role
               key, which must never ship in a desktop binary. That work happens in the Supabase
               dashboard, which is why Refresh is the only command here. -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Users" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="UserChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="UserSubtitle" Style="{StaticResource DashSubheading}"
                           Text="Accounts and roles · managed in Supabase"/>
              </StackPanel>

            </Grid>
          </Border>

          <!-- ── Filters · client-side over the rows already fetched ───────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource DashToolbar}" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="ROLE" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <!-- Filled from the roles that came back, so it can only offer roles that exist. -->
                <ComboBox x:Name="UserRole" Width="150" Height="34"
                          SelectionChanged="UserFilter_Changed"
                          AutomationProperties.Name="Filter by role"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="STATUS" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <ComboBox x:Name="UserStatus" Width="140" Height="34" SelectedIndex="0"
                          SelectionChanged="UserFilter_Changed"
                          AutomationProperties.Name="Filter by status">
                  <ComboBoxItem Tag="">All statuses</ComboBoxItem>
                  <ComboBoxItem Tag="ACTIVE">Active</ComboBoxItem>
                  <ComboBoxItem Tag="INACTIVE">Inactive</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="SEARCH" Style="{StaticResource KpiLabel}" Margin="0,0,0,5"/>
                <Grid>
                  <TextBox x:Name="UserSearch" Style="{StaticResource SearchBar}"
                           PreviewKeyDown="Search_KeyDown"
                           Tag="Search by name, role or account id"
                           ToolTip="Filters the accounts already loaded. Matches full name, role and account id."
                           TextChanged="UserFilter_Changed"
                           AutomationProperties.Name="Search users"/>
                  <Button x:Name="UserSearchClear" Click="ClearUserSearch_Click"
                          Style="{StaticResource GhostButton}" FocusVisualStyle="{x:Null}"
                          Focusable="False" Width="20" Height="20" Padding="0"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Visibility="Collapsed" Cursor="Hand"
                          ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search">
                    <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stretch="None"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Clear" Click="ClearUserFilters_Click"
                        Style="{StaticResource DashButton}"/>
                <!-- Owner only, gated in ApplyRolePermissions. The button being enabled is a
                     courtesy; admin-users checks the caller's role server-side regardless. -->
                <Button x:Name="NewUserButton" Content="New user…" Click="NewUser_Click"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Summary · counted from the loaded accounts ────────────────── -->
          <UniformGrid x:Name="UserKpiRow" DockPanel.Dock="Top" Columns="4" Margin="0,0,-10,4"
                       SizeChanged="KpiRow_SizeChanged">
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Total accounts" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="UserKpiTotal" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock x:Name="UserKpiTotalNote" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"
                        Background="{DynamicResource SuccessBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Active" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="UserKpiActive" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock Text="Can sign in" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Owners" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="UserKpiOwners" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock Text="Full access" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource KpiTile}" Margin="0,0,10,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiAccentEdge}"
                        Background="{DynamicResource WarningBrush}"/>
                <StackPanel Grid.Column="1" Style="{StaticResource KpiBody}">
                  <TextBlock Text="Staff" Style="{StaticResource KpiLabel}"/>
                  <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly"
                           MaxHeight="27" Margin="0,6,0,0">
                    <TextBlock x:Name="UserKpiStaff" Style="{StaticResource KpiValue}" Margin="0"/>
                  </Viewbox>
                  <TextBlock Text="Every non-owner account" Style="{StaticResource KpiCaption}"/>
                </StackPanel>
              </Grid>
            </Border>
          </UniformGrid>

          <!-- ── The list ───────────────────────────────────────────────────── -->
          <Border Style="{StaticResource DashCard}" Margin="0,8,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Accounts" Style="{StaticResource DashHeading}"/>
                <TextBlock x:Name="UserCount" Style="{StaticResource DashSubheading}"/>
              </StackPanel>

              <DataGrid x:Name="UserGrid" BorderThickness="0" CanUserSortColumns="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="InnerWheel">
                <DataGrid.Columns>
                  <!-- Two star columns, not fixed ones. HorizontalScrollBarVisibility="Disabled"
                       hides the scrollbar but does not make a fixed column yield, so the action
                       column was being clipped off the right edge. Stars share what is left. -->
                  <DataGridTemplateColumn Header="USER" Width="2*" MinWidth="170" SortMemberPath="FullName"
                                          CellTemplate="{StaticResource UserAvatarName}"/>
                  <DataGridTemplateColumn Header="ROLE" Width="150" SortMemberPath="Role"
                                          CellTemplate="{StaticResource UserRoleBadge}"/>
                  <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Active"
                                          CellTemplate="{StaticResource UserStatusBadge}"/>
                  <!-- The account id is what an administrator needs when creating the matching
                       profile row in Supabase, so it is on the row rather than hidden. -->
                  <DataGridTextColumn Header="ACCOUNT ID" Binding="{Binding Id}" Width="*" MinWidth="150"
                                      FontFamily="{StaticResource MonoFont}" FontSize="11">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <!-- Trimmed on screen, whole on hover, and whole again from Copy id: an
                             account id is only useful complete. -->
                        <Setter Property="ToolTip" Value="{Binding Id}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <!-- Auto, not a fixed width: star columns are sized against the viewport before the
                       vertical scrollbar claims its 11px, so a fixed last column ends up hanging
                       over the edge. Auto lets it take exactly the button and no more. -->
                  <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <!-- Manage exists now: the service_role key it needs lives in the
                             admin-users Edge Function, not in this app, so the button reaches a
                             server that can actually carry the change out. Copy id stays — it is
                             still the quickest way to reference an account elsewhere. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Button Content="Copy id" Click="CopyUserId_Click"
                                  Style="{StaticResource DashButton}" Height="26" Padding="10,0"
                                  FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                                  ToolTip="Copy this account id to the clipboard"/>
                          <Button Content="Manage…" Click="ManageUser_Click"
                                  Style="{StaticResource DashButton}" Height="26" Padding="10,0"
                                  FontSize="11" Cursor="Hand" Margin="0,0,14,0"
                                  Tag="{Binding}"
                                  ToolTip="Change role, activate or deactivate, or set a new password"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <TextBlock Style="{StaticResource EmptyHint}"
                     Visibility="{Binding ItemsSource, ElementName=UserGrid, Converter={StaticResource Empty}, ConverterParameter=Loaded}"
                     Text="No accounts match these filters.&#10;Clear the filters, or press Refresh."/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <TabItem.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </TabItem.Resources>
        <DockPanel Margin="16,14,16,14">

          <!-- ── Header ───────────────────────────────────────────────────── -->
          <Border DockPanel.Dock="Top" Style="{StaticResource PageHeaderCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ContentControl Grid.Column="0" Style="{StaticResource BrandMark}"/>

              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Configuration" Style="{StaticResource PageHeaderTitle}"/>
                  <Border Style="{StaticResource DashChip}" Margin="10,0,0,0">
                    <TextBlock x:Name="SettingChip" Style="{StaticResource DashChipText}"
                               Text="Not loaded yet"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="SettingSubtitle" Style="{StaticResource DashSubheading}"
                           Text="Policies and thresholds · owner only"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Beside the buttons that act on it, not in a card of its own: it is blank until
                     something is edited, and a card that is empty most of the time reads as a
                     rendering fault. -->
                <TextBlock x:Name="SettingDirty" Style="{StaticResource DashSubheading}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <!-- Label kept from the original button: the database refuses this for anyone but
                     an owner, and saying so before the attempt is kinder than after. -->
                <Button Content="Discard changes" Click="DiscardSettings_Click"
                        Style="{StaticResource DashButton}" Margin="0,0,8,0"
                        AutomationProperties.HelpText="Puts every edited setting back to its saved value"/>
                <Button x:Name="SaveSettings" Content="Save (Owner)" Click="SaveSetting_Click"
                        Style="{StaticResource DashGoldButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- No toolbar. Nine settings across four cards fit in one short scroll, so there is
               nothing to search or filter, and the unsaved-changes count moved up beside Save. -->

          <!-- ── The cards ────────────────────────────────────────────────────
               One card per category, each hidden when its list is empty, so a database with
               nothing in a category shows no empty frame. Import is last because it is an action,
               not a policy. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False" Padding="0,0,4,0">
            <StackPanel>

              <ItemsControl x:Name="SettingCards">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource DashCard}" Margin="0,0,0,12">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource DashHeading}"/>
                          <TextBlock Text="{Binding Caption}" Style="{StaticResource DashSubheading}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource SettingRow}"/>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Import · an action, kept on this page for the reason it always was: it replaces a
                   whole dataset, which is administration rather than day-to-day entry. -->
              <Border x:Name="ImportCard" Style="{StaticResource DashCard}" Margin="0,0,0,12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Import" Style="{StaticResource DashHeading}"/>
                    <TextBlock Style="{StaticResource DashSubheading}"
                               Text="Each import replaces only what it imported before — sales and stock are separate"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ImportExcel" Content="Import sales from Excel…"
                            Click="ImportExcel_Click" Style="{StaticResource DashButton}"
                            AutomationProperties.HelpText="Validates a sale workbook, then replaces all previously imported sales with it"/>
                    <!-- A separate button, not a mode on the first: the two read different
                         workbooks and write to different tables, and one silently doing the other's
                         job is how a stock file ends up deleting a year of invoices. -->
                    <Button x:Name="ImportStock" Content="Import stock from Excel…"
                            Click="ImportStock_Click" Style="{StaticResource DashButton}"
                            Margin="10,0,0,0"
                            AutomationProperties.HelpText="Validates a KAPNA ADD stock workbook, then replaces the previously imported opening stock with it"/>
                    <!-- The printed sheet, as a PDF. A third button rather than a file-type filter
                         on the second, for the reason the second is not a mode on the first: the
                         two read different documents, and this one can also ADD to the position
                         instead of replacing it. That difference has to be visible before the file
                         picker opens, not discovered afterwards. -->
                    <Button x:Name="ImportStockPdf" Content="Import stock from PDF…"
                            Click="ImportStockPdf_Click" Style="{StaticResource DashButton}"
                            Margin="10,0,0,0"
                            AutomationProperties.HelpText="Reads a printed stock sheet, shows every figure for checking, then either replaces the imported stock or adds to it"/>
                    <TextBlock x:Name="ImportStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- No backup panel: Supabase takes and keeps the backups now. -->
              <!-- "Nothing matched" belonged to the search. What is left is the only empty this
                   page can now have: app_config came back with no rows at all. -->
              <TextBlock x:Name="SettingEmpty" Style="{StaticResource EmptyHint}"
                         Visibility="Collapsed" Margin="0,24,0,0"
                         Text="No settings found.&#10;Press Refresh, or check that app_config has rows."/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      </TabControl>

      <!-- Not hit-test transparent: while a page is fetching, its own controls should not accept
           a second click that would start the same read again. -->
      <Border x:Name="BusyVeil" Visibility="Collapsed" Opacity="0"
              Background="{DynamicResource BgBrush}">
        <local:BrandLoader ShowWordmark="False"/>
      </Border>
    </Grid>
    </DockPanel>
  </Grid>
</Window>
