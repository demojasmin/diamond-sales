<Window x:Class="DiamondDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiamondDesktop"
        Title="Solitaire Desk — Diamond Sales &amp; Inventory" Height="880" Width="1440"
        MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5">

  <Window.Resources>
    <!-- Implicit styles: every control on every screen inherits the design system without
         each of the eleven views being rewritten. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGrid}"/>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}"/>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}"/>
    <Style x:Key="NumEdit" TargetType="TextBox" BasedOn="{StaticResource CellNumericTextBox}"/>
    <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Total" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
    <Style x:Key="Kpi" TargetType="TextBlock" BasedOn="{StaticResource MonoDisplay}"/>

    <!-- The tab strip becomes the nav rail, matching the design's NavButton. -->
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,1">
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,9,0,9"
                      CornerRadius="0,2,2,0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
              <Border x:Name="bd" CornerRadius="7" Background="Transparent" Padding="14,0" Margin="6,0,8,0">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavTabs" TargetType="TabControl">
      <Setter Property="TabStripPlacement" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="4,14">
                  <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Style="{StaticResource LabelCaps}"
                             FontSize="10" Margin="20,6,0,10"/>
                  <TabPanel IsItemsHost="True" VerticalAlignment="Top"/>
                </DockPanel>
              </Border>
              <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- top bar -->
    <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="ScreenTitle" Text="Sales entry" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="ScreenSub" Text="Keyboard-first invoice entry" FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="26" CornerRadius="999" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="SyncText" Text="Connected" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource IconButton}" Click="ThemeToggle_Click" ToolTip="Light / dark" Margin="0,0,10,0">
            <Grid Width="14" Height="14">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
              <Path Data="M7,0 A7,7 0 0,1 7,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Grid>
          </Button>
          <Border Width="28" Height="28" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,9,0">
            <TextBlock x:Name="Initials" Text="?" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="WhoAmI" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
      <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}" TextWrapping="NoWrap"/>
    </Border>

    <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavTab}"
                SelectionChanged="Tabs_Changed">

      <!-- ══ SALES-001/003 · sales entry ══════════════════════════════════ -->
      <TabItem Header="Sales entry">
        <DockPanel Margin="8">
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel>
              <TextBlock Text="Date" Style="{StaticResource Lbl}"/>
              <DatePicker SelectedDate="{Binding InvoiceDate}" Style="{StaticResource AppDatePicker}"
                          Width="150" Margin="0,0,16,0"/>
              <TextBlock Text="Buyer" Style="{StaticResource Lbl}"/>
              <ComboBox ItemsSource="{Binding Buyers}" SelectedItem="{Binding SelectedBuyer}" Width="180" Margin="0,0,16,0"/>
              <TextBlock Text="Broker" Style="{StaticResource Lbl}"/>
              <ComboBox ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}" Width="160" Margin="0,0,16,0"/>
              <TextBlock Text="Broker %" Style="{StaticResource Lbl}"/>
              <TextBox Text="{Binding BrokerPct, UpdateSourceTrigger=PropertyChanged}" Width="70"
                       Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <TextBlock Text="Terms" Style="{StaticResource Lbl}"/>
              <TextBox Text="{Binding TermsDays, UpdateSourceTrigger=PropertyChanged}" Width="70"
                       Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <TextBlock Text="Type" Style="{StaticResource Lbl}"/>
              <ComboBox ItemsSource="{Binding DocTypes}" SelectedItem="{Binding DocType}" Width="80" Margin="0,0,16,0"/>
              <TextBlock Text="Due" Style="{StaticResource Lbl}"/>
              <TextBlock Text="{Binding DueDate, StringFormat=dd-MM-yyyy}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </WrapPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,8,0,0">
            <!-- Auto column first: the buttons claim their width before the totals get any,
                 so they can never be clipped off the right edge on a narrow window. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Carats" Style="{StaticResource Lbl}"/>
                <TextBlock Text="{Binding TotalCarats, StringFormat=N2}" Style="{StaticResource Total}"/>
                <TextBlock Text="Amount" Style="{StaticResource Lbl}"/>
                <TextBlock Text="{Binding TotalAmount, StringFormat=N2}" Style="{StaticResource Total}"/>
                <TextBlock Text="Blended rate/ct" Style="{StaticResource Lbl}"/>
                <TextBlock Text="{Binding BlendedRate, StringFormat=N2}" Style="{StaticResource Total}"/>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add line  (Enter)" Click="AddLine_Click" Margin="0,0,8,0"/>
                <Button Content="New" Click="NewInvoice_Click" Margin="0,0,8,0"/>
                <Button Content="Save draft  (Ctrl+S)" Click="SaveDraft_Click" Margin="0,0,8,0"/>
                <Button Content="Post" Click="Post_Click" Style="{StaticResource AppPrimaryButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- CanUserAddRows is OFF: WPF's placeholder row carries a sentinel object, so the
               per-row Size list (which depends on that row's grade) binds to nothing on it.
               Enter appends a real line instead — which is what SALES-001 asks for anyway. -->
          <DataGrid x:Name="Grid" ItemsSource="{Binding Lines}" IsReadOnly="False"
                    CanUserAddRows="False" CanUserDeleteRows="True" SelectionUnit="Cell"
                    PreviewKeyDown="Grid_KeyDown" RowHeight="36" ColumnHeaderHeight="40"
                    HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                <Setter Property="ToolTip" Value="{Binding Error}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Size" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding AllowedSizes}" SelectedItem="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0" Background="Transparent"
                              PreviewMouseLeftButtonDown="CellCombo_Down"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Grade" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding Source={x:Static local:Catalogue.Grades}}"
                              SelectedItem="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                              BorderThickness="0" Background="Transparent"
                              PreviewMouseLeftButtonDown="CellCombo_Down"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Weight" Width="95" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding GrossWeightCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Selection" Width="95" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding SelectionCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Rejection" Width="95" IsReadOnly="True" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding RejectionCt, StringFormat=N2, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
              <DataGridTextColumn Header="Price/ct" Width="100" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding PricePerCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Ex Rate" Width="70" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding ExRate, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Less 1" Width="65" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less1Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Less 2" Width="65" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less2Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Amount" Width="130" IsReadOnly="True" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding Amount, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
              <DataGridTextColumn Header="Remark" Width="*" Binding="{Binding Remark, UpdateSourceTrigger=LostFocus}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ══ SALES-002/004 · PAY-001/003 · invoices & receipts ═══════════ -->
      <TabItem Header="Invoices">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadInvoices_Click"/>
            <TextBlock Text="Receipt:" Style="{StaticResource Lbl}" Margin="16,0,6,0"/>
            <TextBox x:Name="ReceiptAmount" Width="110" Style="{StaticResource NumEdit}" Margin="0,0,6,0"/>
            <ComboBox x:Name="ReceiptMethod" Width="100" SelectedIndex="0" Margin="0,0,6,0">
              <ComboBoxItem>CASH</ComboBoxItem><ComboBoxItem>RTGS</ComboBoxItem><ComboBoxItem>CHEQUE</ComboBoxItem>
            </ComboBox>
            <Button Content="Record receipt" Click="Receipt_Click"/>
            <Button Content="Cancel invoice" Click="CancelInvoice_Click"/>
            <Button Content="Print bill" Click="PrintInvoice_Click"/>
            <Button Content="Export CSV" Click="ExportInvoices_Click"/>
            <Button x:Name="ChangeRequestButton" Content="Request change" Click="ChangeRequest_Click"/>
            <Button x:Name="ReviewRequestsButton" Content="Review requests" Click="ReviewRequests_Click"/>
          </StackPanel>
          <DataGrid x:Name="InvoiceGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="100"/>
              <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}" Width="100"/>
              <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="200"/>
              <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource StatusChip}"/>
              <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
              <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
              <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ══ PAY-002 · receivables ageing ════════════════════════════════ -->
      <TabItem Header="Receivables">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadReceivables_Click"/>
            <Button Content="Export CSV" Click="ExportReceivables_Click"/>
            <TextBlock x:Name="ReceivablesSummary" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
          </StackPanel>
          <DataGrid x:Name="ReceivablesGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="100"/>
              <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="200"/>
              <DataGridTextColumn Header="Invoiced" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}" Width="100"/>
              <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="100"/>
              <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat=N2}" Width="130" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
              <DataGridTextColumn Header="Days overdue" Binding="{Binding DaysOverdue}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
              <DataGridTemplateColumn Header="Bucket" Width="*" CellTemplate="{StaticResource BucketChip}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-002/003 · stock position ════════════════════════════════ -->
      <TabItem Header="Stock">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadStock_Click"/>
            <Button Content="Show movements for selected row" Click="Movements_Click"/>
            <Button Content="Run invariants" Click="Invariants_Click"/>
            <Button Content="Export CSV" Click="ExportStock_Click"/>
            <TextBlock x:Name="StockSummary" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="StockGrid" Grid.Column="0" Margin="0,0,4,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Grade" Binding="{Binding GradeCode}" Width="110"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeCode}" Width="80"/>
                <DataGridTextColumn Header="Balance ct" Binding="{Binding BalanceCt, StringFormat=N4}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Avg price" Binding="{Binding AvgPricePerCt, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="MovementGrid" Grid.Column="1" Margin="4,0,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat=dd-MM-yyyy}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110"/>
                <DataGridTextColumn Header="Weight ct" Binding="{Binding WeightCt, StringFormat=N4}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Price/ct" Binding="{Binding PricePerCt, StringFormat=N2}" Width="100" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-001/004/005/006 · movements in ══════════════════════════ -->
      <TabItem Header="Intake &amp; movements">
        <ScrollViewer Margin="8">
          <StackPanel>
            <TextBlock Text="Rough intake (INV-001)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,14">
              <TextBlock Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="IntakeGrade" Width="130" Margin="0,0,10,0" SelectionChanged="IntakeGrade_Changed"/>
              <TextBlock Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="IntakeSize" Width="90" Margin="0,0,10,0"/>
              <TextBlock Text="Weight ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="IntakeWeight" Width="90" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <TextBlock Text="Price/ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="IntakePrice" Width="90" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <Button Content="Add intake" Click="Intake_Click"/>
            </WrapPanel>

            <TextBlock Text="Grade-to-grade conversion — &quot;avelu&quot; (INV-004)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,14">
              <TextBlock Text="From" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="ConvFromGrade" Width="120" Margin="0,0,6,0" SelectionChanged="ConvFromGrade_Changed"/>
              <ComboBox x:Name="ConvFromSize" Width="85" Margin="0,0,12,0"/>
              <TextBlock Text="To" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="ConvToGrade" Width="120" Margin="0,0,6,0" SelectionChanged="ConvToGrade_Changed"/>
              <ComboBox x:Name="ConvToSize" Width="85" Margin="0,0,12,0"/>
              <TextBlock Text="Weight ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="ConvWeight" Width="85" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <TextBlock Text="Price/ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="ConvPrice" Width="85" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <Button Content="Convert" Click="Convert_Click"/>
            </WrapPanel>

            <TextBlock Text="Rejection with dispositions (INV-005/006)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel Margin="0,0,0,6">
              <TextBlock Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="RejGrade" Width="130" Margin="0,0,10,0" SelectionChanged="RejGrade_Changed"/>
              <TextBlock Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="RejSize" Width="90" Margin="0,0,10,0"/>
              <TextBlock Text="Weight ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="RejWeight" Width="90" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <TextBlock Text="Price/ct" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="RejPrice" Width="90" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <Button Content="Record rejection" Click="Reject_Click"/>
            </WrapPanel>
            <TextBlock Text="Dispositions — weights must sum to the rejection (docs/04 §2.5). Leave empty to record a plain rejection."
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
            <DataGrid x:Name="DispositionGrid" Height="120" IsReadOnly="False" CanUserAddRows="True" Margin="0,0,0,14">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Weight ct" Binding="{Binding WeightCt}" Width="110"/>
                <DataGridComboBoxColumn Header="Outcome" SelectedValueBinding="{Binding Outcome}" Width="130">
                  <DataGridComboBoxColumn.ItemsSource>
                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                      <sys:String>RESELECT</sys:String><sys:String>REPAIR</sys:String><sys:String>REGRADE</sys:String>
                      <sys:String>CULET</sys:String><sys:String>OTHER</sys:String>
                    </x:Array>
                  </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="To grade (REGRADE only)" Binding="{Binding ToGradeCode}" Width="180"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Stock adjustment — always visible, never silent" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <WrapPanel>
              <TextBlock Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="AdjGrade" Width="130" Margin="0,0,10,0" SelectionChanged="AdjGrade_Changed"/>
              <TextBlock Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="AdjSize" Width="90" Margin="0,0,10,0"/>
              <TextBlock Text="Weight ct (± )" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="AdjWeight" Width="90" Style="{StaticResource NumEdit}" Margin="0,0,10,0"/>
              <TextBlock Text="Reason" Style="{StaticResource Lbl}"/>
              <TextBox x:Name="AdjReason" Width="220" Margin="0,0,10,0"/>
              <Button Content="Adjust" Click="Adjust_Click"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ MDM-001/002/004 · master data ═══════════════════════════════ -->
      <TabItem Header="Master data">
        <Grid Margin="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <DataGrid x:Name="GradeGrid" Grid.Column="0" Margin="0,0,8,0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="110"/>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="110"/>
              <DataGridTextColumn Header="Sizes" Binding="{Binding SizeList}" Width="180"/>
              <DataGridTextColumn Header="Aliases" Binding="{Binding AliasList}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Column="1" Width="330">
            <TextBlock Text="Buyers (MDM-002)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="BuyerGrid" Height="180" Margin="0,0,0,6">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Terms" Binding="{Binding DefaultTermsDays}" Width="60"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,0,0,14">
              <TextBox x:Name="NewBuyerName" Width="150" Margin="0,0,6,0"/>
              <TextBox x:Name="NewBuyerTerms" Width="50" Text="0" Style="{StaticResource NumEdit}" Margin="0,0,6,0"/>
              <Button Content="Add buyer" Click="AddBuyer_Click"/>
            </WrapPanel>

            <TextBlock Text="Brokers" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="BrokerGrid" Height="180" Margin="0,0,0,6">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Default %" Binding="{Binding DefaultBrokerPct}" Width="75"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,0,0,14">
              <TextBox x:Name="NewBrokerName" Width="150" Margin="0,0,6,0"/>
              <TextBox x:Name="NewBrokerPct" Width="50" Text="1" Style="{StaticResource NumEdit}" Margin="0,0,6,0"/>
              <Button Content="Add broker" Click="AddBroker_Click"/>
            </WrapPanel>

            <!-- MDM-003 · grade × size price list, effective-dated -->
            <TextBlock Text="Price list (MDM-003)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="PriceGrid" Height="150" Margin="0,0,0,6">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Grade" Binding="{Binding GradeCode}" Width="80"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeCode}" Width="60"/>
                <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="80"/>
                <DataGridTextColumn Header="Price/ct" Binding="{Binding PricePerCt, StringFormat=N2}" Width="*" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="From" Binding="{Binding EffectiveFrom, StringFormat=dd-MM-yy}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel>
              <ComboBox x:Name="PriceGradePicker" Width="95" Margin="0,0,4,0" SelectionChanged="PriceGrade_Changed"/>
              <ComboBox x:Name="PriceSizePicker" Width="70" Margin="0,0,4,0"/>
              <ComboBox x:Name="PriceContext" Width="90" SelectedIndex="0" Margin="0,0,4,0">
                <ComboBoxItem>SALE</ComboBoxItem><ComboBoxItem>STOCK</ComboBoxItem><ComboBoxItem>REJECTION</ComboBoxItem>
              </ComboBox>
              <TextBox x:Name="PriceValue" Width="80" Style="{StaticResource NumEdit}" Margin="0,0,4,0"/>
              <Button Content="Set price" Click="AddPrice_Click"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ══ PHASE 4 · owner dashboard · W1…W15 ══════════════════════════ -->
      <TabItem Header="Dashboard">
        <DockPanel Margin="8">

          <!-- global filter bar — applies to every widget -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel>
              <TextBlock Text="Range" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="RangePicker" Width="120" SelectedIndex="2" Margin="0,0,14,0" SelectionChanged="Range_Changed">
                <ComboBoxItem Tag="TODAY">Today</ComboBoxItem>
                <ComboBoxItem Tag="WEEK">This week</ComboBoxItem>
                <ComboBoxItem Tag="MONTH">This month</ComboBoxItem>
                <ComboBoxItem Tag="QUARTER">This quarter</ComboBoxItem>
                <ComboBoxItem Tag="FY">Financial year</ComboBoxItem>
                <ComboBoxItem Tag="ALL">All time</ComboBoxItem>
                <ComboBoxItem Tag="CUSTOM">Custom…</ComboBoxItem>
              </ComboBox>
              <DatePicker x:Name="FromDate" Style="{StaticResource AppDatePicker}" Width="145" Margin="0,0,4,0" IsEnabled="False"/>
              <DatePicker x:Name="ToDate" Style="{StaticResource AppDatePicker}" Width="145" Margin="0,0,14,0" IsEnabled="False"/>
              <TextBlock Text="Buyer" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="FilterBuyer" Width="150" Margin="0,0,14,0" DisplayMemberPath="Name"/>
              <TextBlock Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="FilterGrade" Width="120" Margin="0,0,14,0"/>
              <Button Content="Apply" Click="LoadDashboard_Click"/>
              <Button Content="Clear" Click="ClearFilters_Click"/>
            </WrapPanel>
          </Border>

          <!-- W15 · alerts strip -->
          <Border DockPanel.Dock="Top" x:Name="AlertStrip" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="AlertText" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
          </Border>

          <!-- W1,W2,W3,W7,W9,W11,W14 · KPI tiles -->
          <UniformGrid DockPanel.Dock="Top" Columns="4" Rows="2" Height="170">
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W1 · Total sales" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiSales" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiSalesDelta" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W2 · Carats sold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiCarats" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W3 · Blended rate/ct" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiRate" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W9 · Outstanding" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiOutstanding" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W11 · Inventory value" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiInventory" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiInventoryCt" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W7 · Margin" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiMargin" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiMarginBasis" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="W14 · Broker cost" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiBroker" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Margin="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="14">
              <StackPanel><TextBlock Text="Posted invoices" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiCount" Style="{StaticResource Kpi}"/></StackPanel></Border>
          </UniformGrid>

          <!-- W4,W5,W6,W8,W10,W12,W13 · one bar list, seven breakdowns -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,8,8,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Breakdown" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="BreakdownPicker" Width="260" SelectedIndex="0" SelectionChanged="Breakdown_Changed">
                  <ComboBoxItem Tag="period">W4 · Sales by period</ComboBoxItem>
                  <ComboBoxItem Tag="salesperson">W5 · Sales by salesperson</ComboBoxItem>
                  <ComboBoxItem Tag="buyer">W6 · Sales by buyer</ComboBoxItem>
                  <ComboBoxItem Tag="grade">W8 · Avg rate/ct by grade</ComboBoxItem>
                  <ComboBoxItem Tag="ageing">W10 · Receivables ageing</ComboBoxItem>
                  <ComboBoxItem Tag="inventory">W11 · Inventory value by grade</ComboBoxItem>
                  <ComboBoxItem Tag="inventory-aging">W12 · Inventory aging</ComboBoxItem>
                  <ComboBoxItem Tag="top-movers">W13 · Top movers</ComboBoxItem>
                  <ComboBoxItem Tag="margin">W7 · Margin by grade</ComboBoxItem>
                  <ComboBoxItem Tag="broker-cost">W14 · Broker cost</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="PeriodBucket" Width="90" SelectedIndex="0" Margin="8,0,0,0" SelectionChanged="Breakdown_Changed">
                  <ComboBoxItem>day</ComboBoxItem><ComboBoxItem>week</ComboBoxItem><ComboBoxItem>month</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BarList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2" Height="26">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Rectangle Grid.Column="1" HorizontalAlignment="Left" Height="18" RadiusX="2" RadiusY="2"
                                   Width="{Binding BarWidth}" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DeltaText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- drill-down: the invoices behind whatever is filtered -->
            <DockPanel Grid.Column="1" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Drill-down · invoices in this view" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DataGrid x:Name="DrillGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="90"/>
                  <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="*"/>
                  <DataGridTextColumn Header="Amount" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ AUD-001 · audit, AUTH-002 · users, CFG · settings ═══════════ -->
      <TabItem Header="Audit">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="Refresh" Click="LoadAudit_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <DataGrid x:Name="AuditGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="When (UTC)" Binding="{Binding OccurredAt, StringFormat=dd-MM-yyyy HH:mm:ss}" Width="150"/>
              <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="130"/>
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
              <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="250"/>
              <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Users" x:Name="UsersTab">
        <DockPanel Margin="8">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadUsers_Click"/>
            <TextBox x:Name="NewUserName" Width="120" Margin="10,0,6,0"/>
            <TextBox x:Name="NewUserDisplay" Width="140" Margin="0,0,6,0"/>
            <PasswordBox x:Name="NewUserPassword" Width="120" Margin="0,0,6,0"/>
            <ComboBox x:Name="NewUserRole" Width="110" SelectedIndex="0" Margin="0,0,6,0">
              <ComboBoxItem>SALES</ComboBoxItem><ComboBoxItem>MANAGER</ComboBoxItem><ComboBoxItem>OWNER</ComboBoxItem>
            </ComboBox>
            <Button Content="Add user" Click="AddUser_Click"/>
            <Button Content="Deactivate selected" Click="DeactivateUser_Click"/>
          </WrapPanel>
          <DataGrid x:Name="UserGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="200"/>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
              <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <DockPanel Margin="8">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadSettings_Click"/>
            <TextBlock Text="Value for selected key:" Style="{StaticResource Lbl}" Margin="16,0,6,0"/>
            <TextBox x:Name="SettingValue" Width="180" Margin="0,0,6,0"/>
            <Button Content="Save (Owner)" Click="SaveSetting_Click"/>
            <Button Content="Back up now" Click="Backup_Click" Margin="16,0,0,0"/>
          </WrapPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="SettingGrid" Grid.Column="0" Margin="0,0,8,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="260"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Column="1">
              <TextBlock DockPanel.Dock="Top" Text="Backups (OPS-001)" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DataGrid x:Name="BackupGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*"/>
                  <DataGridTextColumn Header="KB" Binding="{Binding SizeKb}" Width="60" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                  <DataGridTextColumn Header="Taken (UTC)" Binding="{Binding CreatedUtc, StringFormat=dd-MM HH:mm}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
