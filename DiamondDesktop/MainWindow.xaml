<Window x:Class="DiamondDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiamondDesktop"
        Title="Solitaire Desk — Diamond Sales &amp; Inventory" Height="880" Width="1440"
        MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5">

  <Window.Resources>
    <!-- Implicit styles: every control on every screen inherits the design system without
         each of the eleven views being rewritten. -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource AppDataGrid}"/>
    <Style TargetType="Button" BasedOn="{StaticResource AppButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBox}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}"/>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBox}"/>

    <!-- Left-aligned on request, headers and figures alike, across every grid in the app.
         The convention this replaces put numbers on the right so their decimal points line up in a
         column; noted, asked about, and decided otherwise. The mono/tabular figures are kept, so
         digits still occupy equal width. -->
    <Style x:Key="Num" TargetType="TextBlock" BasedOn="{StaticResource NumericCellText}">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <!-- The in-grid editor gets the same keystroke guard as the header fields: a bad character in
         Weight or Price silently kept the previous value and recomputed Amount from it. -->
    <Style x:Key="NumEdit" TargetType="TextBox" BasedOn="{StaticResource CellNumericTextBox}">
      <Setter Property="local:NumericInput.IsNumeric" Value="True"/>
      <!-- Same edge as the display style above, or the figure jumps sideways the moment you
           start typing in the cell. -->
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <local:EmptyToVisibilityConverter x:Key="Empty"/>

    <!-- "Nothing here yet", shared so every grid says it the same way. Sits over the grid body:
         a DataGrid with no rows is otherwise a header and a blank rectangle, which reads as a
         failure rather than as an empty result. Bind Visibility to the grid's Items.Count. -->
    <!-- Placeholder inside a grid cell. Not hit-testable, so it never intercepts the click that
         opens the drop-down behind it; padding matches the combo's so the text does not shift
         when a value replaces it. -->
    <!-- A cell holding a ComboBox has three things competing for its width: the standard 14px cell
         padding on each side, the combo's own 10/8 padding, and a 26px chevron. On a 90px Size
         column that left about 18px for the text, so "+11" rendered as "+1". These cells give the
         padding back — the combo supplies its own.
         No EventSetter here, unlike the grid's CellStyle: Cell_Down only acts on text columns, and
         these cells have CellCombo_Down on the ComboBox itself. -->
    <Style x:Key="ComboCell" TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
      <Setter Property="Padding" Value="4,0"/>
    </Style>

    <!-- Vertical rule between toolbar groups. The design package's Divider is the horizontal one;
         this is the same hairline stood on its end, so a toolbar reads as related clusters rather
         than one undifferentiated row of controls. -->
    <Style x:Key="ToolbarSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="4,0,14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <Style x:Key="CellPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="11,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Opacity" Value="0.75"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Actions that operate on the selected row. They were always enabled, so clicking Print bill
         with nothing selected just printed "Select an invoice first" to the status bar — which
         reads as a broken button, not as a precondition. Disabled is the honest state. -->
    <Style x:Key="NeedsRowButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NeedsRowPrimary" TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Same idea for the Stock page, whose action depends on a row in a different grid. -->
    <Style x:Key="NeedsStockRow" TargetType="Button" BasedOn="{StaticResource AppButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=StockGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NeedsRowDanger" TargetType="Button" BasedOn="{StaticResource DangerButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedItem, ElementName=InvoiceGrid}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,56,0,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Shared so the closed combo and its dropdown can never disagree. See the Size column for
         why DisplayMemberPath is not used with this design's combo template. -->
    <DataTemplate x:Key="SizeCodeTemplate">
      <TextBlock Text="{Binding Code}"/>
    </DataTemplate>
    <DataTemplate x:Key="GradeNameTemplate">
      <TextBlock Text="{Binding DisplayName}"/>
    </DataTemplate>
    <DataTemplate x:Key="NameTemplate">
      <TextBlock Text="{Binding Name}"/>
    </DataTemplate>

    <!-- The accessible name has to live on the CONTAINER. WPF's ComboBoxItemAutomationPeer names an
         item from the item itself, and with an ItemTemplate there is nothing to read, so it falls
         back to ToString() on the model — a database wire type. Every entry in the Grade list
         announced itself to a screen reader as "DiamondDesktop.Data.Grade", twenty-three times.
         Putting the name on the TextBlock inside the template does NOT fix it; the peer never
         looks there. Measured, not assumed. -->
    <Style x:Key="GradeItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
    </Style>
    <Style x:Key="SizeItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Code}"/>
    </Style>
    <Style x:Key="PartyItemContainer" TargetType="ComboBoxItem" BasedOn="{StaticResource FieldComboBoxItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Label + field, kept together so a wrap can never separate them. -->
    <Style x:Key="FieldPair" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>

    <!-- ItemHeight gives every wrapped row the same pitch: 32px control + 8px gutter. Without it
         a row containing the taller DatePicker sets its own height and the rows drift apart. -->
    <Style x:Key="FieldRowPanel" TargetType="WrapPanel">
      <Setter Property="ItemHeight" Value="40"/>
    </Style>
    <Style x:Key="Total" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
    </Style>
    <Style x:Key="Kpi" TargetType="TextBlock" BasedOn="{StaticResource MonoDisplay}"/>

    <!-- Icon + label, matching the design's NavButton. The header stays a plain string — it is the
         key Tabs_Changed and ScreenSubtitles look up — so the icon is picked from that string here
         rather than by rebuilding every header as a panel. -->
    <DataTemplate x:Key="NavHeader">
      <StackPanel Orientation="Horizontal">
        <Path x:Name="icon" Width="17" Height="17" Stretch="Uniform" Margin="0,0,11,0"
              StrokeThickness="1.4" Fill="Transparent"
              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
              Data="M4,2.5 h12 v15 h-12 z M7,7.5 h6 M7,10.5 h6 M7,13.5 h4"/>
        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding}" Value="Invoices">
          <Setter TargetName="icon" Property="Data" Value="M3,4.5 h14 M3,9 h14 M3,13.5 h14 M3,17.5 h8"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Receivables">
          <Setter TargetName="icon" Property="Data" Value="M10,2.8 A7.2,7.2 0 1,0 10,17.2 A7.2,7.2 0 1,0 10,2.8 M6.8,10.4 h6.4 M8.4,7.6 h3.2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Stock">
          <Setter TargetName="icon" Property="Data" Value="M2.5,2.5 h4 v4 h-4 z M8,2.5 h4 v4 h-4 z M13.5,2.5 h4 v4 h-4 z M2.5,8 h4 v4 h-4 z M8,8 h4 v4 h-4 z M13.5,8 h4 v4 h-4 z M2.5,13.5 h4 v4 h-4 z M8,13.5 h4 v4 h-4 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Intake &amp; movements">
          <Setter TargetName="icon" Property="Data" Value="M3,6 h9 M9,3 L12,6 L9,9 M17,14 h-9 M11,11 L8,14 L11,17"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Master data">
          <Setter TargetName="icon" Property="Data" Value="M2.8,4 h14.4 v4.4 h-14.4 z M2.8,11.6 h14.4 v4.4 h-14.4 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Dashboard">
          <Setter TargetName="icon" Property="Data" Value="M3,3 h6 v6 h-6 z M11,3 h6 v4 h-6 z M11,9 h6 v8 h-6 z M3,11 h6 v6 h-6 z"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Audit">
          <Setter TargetName="icon" Property="Data" Value="M10,3 A7,7 0 1,1 3,10 A7,7 0 0,1 10,3 M10,6 v4.6 l3.4,2"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Users">
          <Setter TargetName="icon" Property="Data" Value="M10,3.6 A3.1,3.1 0 1,0 10,9.8 A3.1,3.1 0 1,0 10,3.6 M4,17 a6,6 0 0,1 12,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding}" Value="Settings">
          <Setter TargetName="icon" Property="Data" Value="M10,7 A3,3 0 1,0 10,13 A3,3 0 1,0 10,7 M10,3 A7,7 0 1,0 10,17 A7,7 0 1,0 10,3"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The tab strip becomes the nav rail, matching the design's NavButton.
         Selection colour goes on the header Border, NOT on the TabItem: a TabItem is the logical
         parent of its own page, so `Foreground` set here inherits straight into every unstyled
         TextBlock on that page and paints the whole screen accent-blue. -->
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HeaderTemplate" Value="{StaticResource NavHeader}"/>
      <!-- Load-bearing: a TabItem is the inheritance parent of its own page, so this is what every
           unstyled TextBlock on that page inherits. Drop it and they fall back to the property
           default — pure black — which is invisible on the dark theme. The accent for the selected
           nav item goes on the header Border below, never here, or it bleeds into the page. -->
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="0,1">
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,9,0,9"
                      CornerRadius="0,2,2,0" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
              <Border x:Name="bd" CornerRadius="7" Background="Transparent" Padding="14,0" Margin="6,0,8,0"
                      TextElement.Foreground="{DynamicResource TextBrush}">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="bd" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="bd" Property="TextElement.FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavTabs" TargetType="TabControl">
      <Setter Property="TabStripPlacement" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="4,14">
                  <TextBlock DockPanel.Dock="Top" Text="WORKSPACE" Style="{StaticResource LabelCaps}"
                             FontSize="10" Margin="20,6,0,10"/>
                  <TabPanel IsItemsHost="True" VerticalAlignment="Top"/>
                </DockPanel>
              </Border>
              <!-- The name is load-bearing, not decoration: TabItemAutomationPeer finds the selected
                   tab's content by looking up "PART_SelectedContentHost" on the TabControl. Unnamed,
                   every screen vanishes from the UIA tree — screen readers and UI automation see the
                   nav rail and nothing else. -->
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1"
                                ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- top bar -->
    <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="ScreenTitle" Text="Sales entry" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="ScreenSub" Text="Keyboard-first invoice entry" FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Height="26" CornerRadius="999" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
              <TextBlock x:Name="SyncText" Text="Connected" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </Border>
          <!-- Named for a reason: with no x:Name and no AutomationProperties.Name a screen reader
               announces this only as "button", and automation can't address it at all. -->
          <Button x:Name="ThemeToggle" Style="{StaticResource IconButton}" Click="ThemeToggle_Click"
                  ToolTip="Light / dark" AutomationProperties.Name="Toggle light or dark theme"
                  Margin="0,0,10,0">
            <Grid Width="14" Height="14">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"/>
              <Path Data="M7,0 A7,7 0 0,1 7,14 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Grid>
          </Button>
          <Border Width="28" Height="28" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,9,0">
            <TextBlock x:Name="Initials" Text="?" FontSize="11.5" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="WhoAmI" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
      <TextBlock x:Name="Status" Foreground="{DynamicResource DangerBrush}" TextWrapping="NoWrap"/>
    </Border>

    <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavTab}"
                SelectionChanged="Tabs_Changed">

      <!-- ══ SALES-001/003 · sales entry ══════════════════════════════════ -->
      <TabItem Header="Sales entry">
        <DockPanel Margin="8">
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <!-- Each label travels WITH its field inside a pair. A flat WrapPanel wrapped between a
                 label and the control it names, so on a narrow window "Broker %" sat at the end of
                 one line and its box at the start of the next. -->
            <WrapPanel Style="{StaticResource FieldRowPanel}">
              <!-- Every header control is named. A bare <ComboBox/> here has no AutomationId and no
                   accessible name, so a screen reader announces it as "combo box" with no clue what
                   it edits, and automation cannot tell the three of them apart at all. -->
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Date" Style="{StaticResource Lbl}"/>
                <DatePicker x:Name="InvoiceDatePicker" SelectedDate="{Binding InvoiceDate}"
                            AutomationProperties.Name="Invoice date"
                            CalendarOpened="InvoiceDatePicker_CalendarOpened"
                            CalendarClosed="InvoiceDatePicker_CalendarClosed"
                            Style="{StaticResource AppDatePicker}" Width="150"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <!-- Same weight and colour as every other label. Requiredness is carried by the
                     validation message and by HelpText for screen readers — not by making one
                     label look different from the six beside it. -->
                <TextBlock Text="Buyer" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="BuyerPicker" ItemsSource="{Binding Buyers}" SelectedItem="{Binding SelectedBuyer}"
                          AutomationProperties.Name="Buyer"
                          AutomationProperties.HelpText="Required" Width="180"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Broker" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="BrokerPicker" ItemsSource="{Binding Brokers}" SelectedItem="{Binding SelectedBroker}"
                          AutomationProperties.Name="Broker" Width="160"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Broker %" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="BrokerPctBox" Text="{Binding BrokerPct, UpdateSourceTrigger=PropertyChanged}" Width="70"
                         AutomationProperties.Name="Broker percent"
                         Style="{StaticResource AppNumericTextBox}"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Terms" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="TermsBox" Text="{Binding TermsDays, UpdateSourceTrigger=PropertyChanged}" Width="70"
                         AutomationProperties.Name="Terms in days"
                         Style="{StaticResource AppNumericTextBox}"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Type" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="DocTypePicker" ItemsSource="{Binding DocTypes}" SelectedItem="{Binding DocType}"
                          AutomationProperties.Name="Document type" Width="80"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Due" Style="{StaticResource Lbl}"/>
                <TextBlock Text="{Binding DueDate, StringFormat=dd-MM-yyyy}" MinWidth="90" Height="32"
                           Padding="0,7,0,0" FontWeight="SemiBold"
                           AutomationProperties.Name="Due date"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,8,0,0">
            <!-- Auto column first: the buttons claim their width before the totals get any,
                 so they can never be clipped off the right edge on a narrow window. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Carats" Style="{StaticResource Lbl}"/>
                <TextBlock x:Name="TotalCarats"
                           Text="{Binding TotalCarats, StringFormat=N2}" Style="{StaticResource Total}"/>
                <TextBlock Text="Amount" Style="{StaticResource Lbl}"/>
                <TextBlock x:Name="TotalAmount"
                           Text="{Binding TotalAmount, StringFormat=N2}" Style="{StaticResource Total}"/>
                <TextBlock Text="Blended rate/ct" Style="{StaticResource Lbl}"/>
                <TextBlock x:Name="BlendedRate"
                           Text="{Binding BlendedRate, StringFormat=N2}" Style="{StaticResource Total}"/>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddLineButton" Content="Add line  (Enter)" Click="AddLine_Click" Margin="0,0,8,0"/>
                <Button x:Name="New" Content="New" Click="NewInvoice_Click" Margin="0,0,8,0"/>
                <Button x:Name="SaveDraft" Content="Save draft  (Ctrl+S)" Click="SaveDraft_Click" Margin="0,0,8,0"/>
                <Button x:Name="Post" Content="Post" Click="Post_Click" Style="{StaticResource AppPrimaryButton}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- One layer stack: grid at the bottom, then the "type a line" hint, then the
               no-catalogue panel on top. These were siblings of the DockPanel before, which meant
               the panel inherited DockPanel's default Dock=Left and would have rendered as a strip
               down the left edge rather than centred over the grid. -->
          <Grid>
            <!-- CanUserAddRows is OFF: WPF's placeholder row carries a sentinel object, so the
                 per-row Size list (which depends on that row's grade) binds to nothing on it.
                 Enter appends a real line instead — which is what SALES-001 asks for anyway.
                 CanUserDeleteRows is OFF too: Delete is handled in code so a typed line cannot
                 vanish without being asked about. -->
            <DataGrid x:Name="Grid" ItemsSource="{Binding Lines}" IsReadOnly="False"
                    Visibility="{Binding Source={x:Static local:Catalogue.Grades}, Path=Count, Converter={StaticResource Empty}, ConverterParameter=Invert}"
                    CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                    PreviewKeyDown="Grid_KeyDown" RowHeight="42" ColumnHeaderHeight="40"
                    HeadersVisibility="Column" GridLinesVisibility="None">
            <!-- A cell takes the first click to become current and only edits on the second, so on
                 a fresh screen the first figure typed goes nowhere. On a keyboard-first entry
                 screen that is a silent data loss, not a nicety. -->
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell" BasedOn="{StaticResource AppCell}">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Cell_Down"/>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
              <!-- Colour on HasConflict, not on Error. Every freshly started line has an Error
                   ("Weight must be greater than 0") from the moment a grade is picked, so keying
                   off Error painted the row you were currently typing into red. The tooltip still
                   carries every message, including the not-yet-typed ones. -->
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ToolTip" Value="{Binding Error}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <!-- CellComboBox, not a bare ComboBox: the default field style is 32px and these sat a
                   visible 4px taller than every other control in a 36px row. Same defect the
                   Disposition dropdown had (docs/12 §3c). -->
              <DataGridTemplateColumn Header="Size" Width="105" CellStyle="{StaticResource ComboCell}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <!-- ItemTemplate, not DisplayMemberPath. The design's combo template draws its
                         closed state from SelectionBoxItemTemplate, which DisplayMemberPath does
                         not populate — so the list showed "+6.5" while the box showed the type
                         name, clipped to "Di". An explicit template feeds both. -->
                    <!-- An unset combo draws nothing but a chevron, so a fresh line looked broken
                         rather than unfilled. The hint sits behind the drop-down and disappears
                         the moment a size is chosen. -->
                    <Grid>
                      <ComboBox ItemsSource="{Binding AllowedSizes}" SelectedItem="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                                ItemTemplate="{StaticResource SizeCodeTemplate}" ItemContainerStyle="{StaticResource SizeItemContainer}" Style="{StaticResource CellComboBox}"
                                AutomationProperties.Name="Size"
                                PreviewMouseLeftButtonDown="CellCombo_Down"/>
                      <TextBlock Text="Size" Style="{StaticResource CellPlaceholder}"
                                 Visibility="{Binding Size, Converter={StaticResource Empty}}"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Grade" Width="195" CellStyle="{StaticResource ComboCell}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <ComboBox ItemsSource="{Binding Source={x:Static local:Catalogue.Grades}}"
                                SelectedItem="{Binding Grade, UpdateSourceTrigger=PropertyChanged}"
                                ItemTemplate="{StaticResource GradeNameTemplate}" ItemContainerStyle="{StaticResource GradeItemContainer}" Style="{StaticResource CellComboBox}"
                                AutomationProperties.Name="Grade"
                                PreviewMouseLeftButtonDown="CellCombo_Down"/>
                      <TextBlock Text="Grade" Style="{StaticResource CellPlaceholder}"
                                 Visibility="{Binding Grade, Converter={StaticResource Empty}}"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Weight" Width="95" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding GrossWeightCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Selection" Width="95" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding SelectionCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Rejection" Width="95" IsReadOnly="True" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding RejectionCt, StringFormat=N2, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
              <DataGridTextColumn Header="Price/ct" Width="120" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding PricePerCt, StringFormat=N2, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Ex Rate" Width="80" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding ExRate, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Less 1" Width="65" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less1Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Less 2" Width="65" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}" EditingElementStyle="{StaticResource NumEdit}"
                                  Binding="{Binding Less2Pct, UpdateSourceTrigger=LostFocus}"/>
              <DataGridTextColumn Header="Amount" Width="155" IsReadOnly="True" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                  Binding="{Binding Amount, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
              <DataGridTextColumn Header="Remark" Width="*" Binding="{Binding Remark, UpdateSourceTrigger=LostFocus}"/>
            </DataGrid.Columns>
            </DataGrid>

            <!-- Guidance while the invoice is still empty. The grid always shows one row, so it is
                 never blank — but a single untouched row over a large empty area says nothing about
                 what to do next. Hides itself the moment a real line exists. -->
            <TextBlock Style="{StaticResource EmptyHint}"
                       Visibility="{Binding LineCount, Converter={StaticResource Empty}}"
                       Text="Pick a grade and size, then type the weight.&#10;Enter adds another line · Ctrl+S saves a draft."/>

            <!-- With no catalogue the Grade and Size dropdowns open onto nothing, which reads as
                 "this app is broken" rather than "it could not reach the database" — and a line can
                 never be completed, so the grid underneath is not worth showing. -->
            <Border Visibility="{Binding Source={x:Static local:Catalogue.Grades}, Path=Count, Converter={StaticResource Empty}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No grades loaded" HorizontalAlignment="Center"
                           FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Grades and sieve sizes come from the database. Without them a sale line cannot be completed."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                           Margin="0,6,0,14" Style="{StaticResource MutedText}"/>
                <Button Content="Retry" Click="ReloadCatalogue_Click" HorizontalAlignment="Center"
                        Style="{StaticResource AppPrimaryButton}"/>
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ SALES-002/004 · PAY-001/003 · invoices & receipts ═══════════ -->
      <TabItem Header="Invoices">
        <DockPanel Margin="8">
          <!-- Same card + wrapping toolbar as Sales entry. It was a bare horizontal StackPanel:
               four of its buttons carried no margin at all so they touched, and on a narrow window
               the row simply ran off the edge instead of wrapping. -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel Style="{StaticResource FieldRowPanel}">
              <StackPanel Style="{StaticResource FieldPair}">
                <Button x:Name="InvoiceRefresh" Content="Refresh" Click="LoadInvoices_Click" TabIndex="1"/>
                <Border Style="{StaticResource ToolbarSeparator}"/>
              </StackPanel>

              <!-- The receipt fields belong together — a wrap between the amount and the button
                   that banks it would be nonsense. Read left to right it now states the task:
                   what is owed, how much is being paid, by what method, then the action. -->
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock Text="Receipt" Style="{StaticResource Lbl}"/>

                <!-- The balance comes BEFORE the box. It is the figure the amount is measured
                     against, and reading it after the button is reading it too late. Display only —
                     it reads the row already on screen and calls nothing. -->
                <!-- The box gave no clue what it wanted. An empty numeric field beside a currency
                     dropdown could be a rate, a percentage or a count. -->
                <Grid Margin="0,0,8,0">
                  <TextBox x:Name="ReceiptAmount" Width="120" TabIndex="2"
                           AutomationProperties.Name="Receipt amount"
                           AutomationProperties.HelpText="Amount received against the selected invoice"
                           Style="{StaticResource AppNumericTextBox}"/>
                  <TextBlock Text="0.00" IsHitTestVisible="False" Margin="0,0,10,0"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" Opacity="0.55"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Visibility="{Binding Text, ElementName=ReceiptAmount, Converter={StaticResource Empty}}"/>
                </Grid>

                <!-- Labelled. "CASH" alone is only obvious once you already know the list holds
                     payment methods; a screen reader announced it with no context at all. -->
                <TextBlock Text="by" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="ReceiptMethod" Width="105" SelectedIndex="0" Margin="0,0,8,0" TabIndex="3"
                          AutomationProperties.Name="Receipt method"
                          AutomationProperties.HelpText="How the payment was received">
                  <ComboBoxItem>CASH</ComboBoxItem><ComboBoxItem>RTGS</ComboBoxItem><ComboBoxItem>CHEQUE</ComboBoxItem>
                </ComboBox>
                <Button x:Name="RecordReceipt" Content="Record receipt" Click="Receipt_Click" TabIndex="4"
                        AutomationProperties.HelpText="Records the amount against the selected invoice"
                        Style="{StaticResource NeedsRowPrimary}"/>
                <Border Style="{StaticResource ToolbarSeparator}"/>
              </StackPanel>

              <StackPanel Style="{StaticResource FieldPair}">
                <Button x:Name="PrintBill" Content="Print bill" Click="PrintInvoice_Click" Margin="0,0,8,0"
                        Style="{StaticResource NeedsRowButton}"/>
                <Button x:Name="ExportInvoices" Content="Export CSV" Click="ExportInvoices_Click" Margin="0,0,8,0"/>
                <!-- Cancelling reverses stock and cannot be undone. It should not look like Export. -->
                <Button x:Name="CancelInvoiceButton" Content="Cancel invoice" Click="CancelInvoice_Click"
                        Style="{StaticResource NeedsRowDanger}"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <Grid>
            <!-- Named for the same reason the buttons are: without it a screen reader reaches this
                 table and announces "table", with no clue which of the app's eleven it landed on. -->
            <DataGrid x:Name="InvoiceGrid"
                      AutomationProperties.Name="Invoices"
                      AutomationProperties.HelpText="Select an invoice to record a receipt, print or cancel it">
              <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="150"/>
                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MM-yyyy}" Width="105"/>
                <!-- Buyer takes the slack, not Due. A date is a fixed 10 characters, so giving it
                     the star width left a wide empty gutter while long buyer names were clipped. -->
                <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="*" MinWidth="180"/>
                <DataGridTemplateColumn Header="Status" Width="120" CellTemplate="{StaticResource StatusChip}"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding AmountTotal, StringFormat=N2}" Width="155" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat=N2}" Width="155" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="105"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyHint}"
                       Visibility="{Binding ItemsSource, ElementName=InvoiceGrid, Converter={StaticResource Empty}}"
                       Text="No invoices yet.&#10;Post one from Sales entry, or press Refresh."/>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ PAY-002 · receivables ageing ════════════════════════════════ -->
      <TabItem Header="Receivables">
        <DockPanel Margin="8">
          <!-- Card + wrapping toolbar, matching Sales entry and Invoices. Two buttons with no
               margin sat flush against each other, and the summary could wrap away from them. -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel Style="{StaticResource FieldRowPanel}">
              <StackPanel Style="{StaticResource FieldPair}">
                <Button x:Name="ReceivablesRefresh" Content="Refresh" Click="LoadReceivables_Click" Margin="0,0,8,0"/>
                <Button x:Name="ReceivablesExport" Content="Export CSV" Click="ExportReceivables_Click"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <!-- No AutomationProperties.Name. On a TextBlock the Name IS what a screen reader
                     announces, so a fixed label here replaced the totals and read out none of the
                     figures. The text carries its own meaning: "Total … · 0-30 …". -->
                <TextBlock x:Name="ReceivablesSummary" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <Grid>
            <DataGrid x:Name="ReceivablesGrid"
                      AutomationProperties.Name="Receivables"
                      AutomationProperties.HelpText="Outstanding invoices by age">
              <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="150"/>
                <!-- Buyer takes the slack; the ageing chip is a fixed-width badge and looked
                     stranded in a star column. -->
                <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=dd-MM-yyyy}" Width="105"/>
                <DataGridTextColumn Header="Outstanding" Binding="{Binding Outstanding, StringFormat=N2}" Width="155" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTextColumn Header="Days overdue" Binding="{Binding DaysOverdue}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                <DataGridTemplateColumn Header="Bucket" Width="140" CellTemplate="{StaticResource BucketChip}"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource EmptyHint}"
                       Visibility="{Binding ItemsSource, ElementName=ReceivablesGrid, Converter={StaticResource Empty}}"
                       Text="Nothing outstanding.&#10;Either every invoice is settled, or none has been posted yet."/>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-002/003 · stock position ════════════════════════════════ -->
      <TabItem Header="Stock">
        <DockPanel Margin="8">
          <!-- Card + wrapping toolbar, as on every other page. It was a bare StackPanel whose four
               buttons carried no margin, so they touched and ran off a narrow window. -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel Style="{StaticResource FieldRowPanel}">
              <StackPanel Style="{StaticResource FieldPair}">
                <Button x:Name="StockRefresh" Content="Refresh" Click="LoadStock_Click" Margin="0,0,8,0"/>
                <Button x:Name="StockExport" Content="Export CSV" Click="ExportStock_Click"/>
                <Border Style="{StaticResource ToolbarSeparator}"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <!-- "for selected row" was in the label because nothing else said so. The button
                     now disables until a row is picked, which states the precondition without
                     needing four extra words. -->
                <Button x:Name="ShowMovements" Content="Show movements" Click="Movements_Click" Margin="0,0,8,0"
                        AutomationProperties.HelpText="Lists every movement for the selected grade and size"
                        Style="{StaticResource NeedsStockRow}"/>
                <Button x:Name="RunInvariants" Content="Run invariants" Click="Invariants_Click"
                        AutomationProperties.HelpText="Checks that stock moved out matches stock invoiced"/>
                <Border Style="{StaticResource ToolbarSeparator}"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <!-- Most grade x size combinations have never been traded: 64 of 92 here. Showing
                     them all buries the 28 that matter and makes "Show movements" look broken,
                     because most rows a user lands on genuinely have no ledger. -->
                <CheckBox x:Name="HideEmptyBuckets" Content="Hide empty buckets" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Checked="HideEmpty_Changed" Unchecked="HideEmpty_Changed"
                          AutomationProperties.HelpText="Hides grade and size combinations with no stock and no movements"/>
                <Border Style="{StaticResource ToolbarSeparator}"/>
              </StackPanel>
              <StackPanel Style="{StaticResource FieldPair}">
                <TextBlock x:Name="StockSummary" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="360"/>
              <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Two unlabelled grids side by side gave no clue which was which, or that the right
                 one depends on a selection in the left. -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Stock position" Style="{StaticResource Lbl}"
                       Margin="2,0,0,6" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Movements" Style="{StaticResource Lbl}"
                       Margin="6,0,0,6" FontWeight="SemiBold"/>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
              <DataGrid x:Name="StockGrid"
                        AutomationProperties.Name="Stock position"
                        AutomationProperties.HelpText="Balance and value by grade and size">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Grade" Binding="{Binding GradeCode}" Width="110"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding SizeCode}" Width="80"/>
                  <DataGridTextColumn Header="Balance ct" Binding="{Binding BalanceCt, StringFormat=N4}" Width="130" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                  <DataGridTextColumn Header="Avg cost" Binding="{Binding AvgCost, StringFormat=N2}" Width="155" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding StockValue, StringFormat=N2}" Width="*" MinWidth="155" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Style="{StaticResource EmptyHint}"
                         Visibility="{Binding ItemsSource, ElementName=StockGrid, Converter={StaticResource Empty}}"
                         Text="No stock positions.&#10;Press Refresh, or record an intake first."/>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
              <DataGrid x:Name="MovementGrid"
                        AutomationProperties.Name="Movements"
                        AutomationProperties.HelpText="Ledger entries for the selected grade and size">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat=dd-MM-yyyy}" Width="105"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="120"/>
                  <DataGridTextColumn Header="Weight ct" Binding="{Binding WeightCt, StringFormat=N4}" Width="130" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                  <DataGridTextColumn Header="Price/ct" Binding="{Binding PricePerCt, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                  <DataGridTextColumn Header="Source" Binding="{Binding RefType}" Width="*" MinWidth="90"/>
                </DataGrid.Columns>
              </DataGrid>
              <!-- Text is rewritten in Movements_Click: "nothing loaded yet" and "loaded, and this
                   bucket has no movements" are both empty, and saying the same thing for each
                   makes a finished load look like a button that did nothing. -->
              <TextBlock x:Name="MovementHint" Style="{StaticResource EmptyHint}"
                         Visibility="{Binding ItemsSource, ElementName=MovementGrid, Converter={StaticResource Empty}}"
                         Text="Pick a grade and size on the left,&#10;then press Show movements."/>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ INV-001/004/005/006 · movements in ══════════════════════════ -->
      <TabItem Header="Intake &amp; movements">
        <!-- IsSharedSizeScope is what keeps the stacked forms honest: every label and field column
             below sizes to the widest entry across ALL of them, so the four forms line up instead
             of each one starting wherever its own label text happens to end. -->
        <ScrollViewer Margin="8" Grid.IsSharedSizeScope="True">
          <StackPanel>
            <StackPanel.Resources>
              <Style x:Key="FormRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,14"/>
              </Style>
            </StackPanel.Resources>

            <TextBlock Text="Rough intake (INV-001)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Style="{StaticResource FormRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L1"/><ColumnDefinition Width="Auto" SharedSizeGroup="F1"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L2"/><ColumnDefinition Width="Auto" SharedSizeGroup="F2"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L3"/><ColumnDefinition Width="Auto" SharedSizeGroup="F3"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L4"/><ColumnDefinition Width="Auto" SharedSizeGroup="F4"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="1" x:Name="IntakeGrade" Width="130" Margin="0,0,16,0" SelectionChanged="IntakeGrade_Changed"/>
              <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="3" x:Name="IntakeSize" Width="90" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="4" Text="Weight ct" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="5" x:Name="IntakeWeight" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="6" Text="Price/ct" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="7" x:Name="IntakePrice" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <Button Grid.Column="8" Content="Add intake" Click="Intake_Click" HorizontalAlignment="Left"/>
            </Grid>

            <TextBlock Text="Grade-to-grade conversion — &quot;avelu&quot; (INV-004)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <!-- Two grade/size pairs instead of one, so only the leading label column is shared —
                 enough to start this form on the same vertical line as the other three. -->
            <Grid Style="{StaticResource FormRow}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L1"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="From" Style="{StaticResource Lbl}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="ConvFromGrade" Width="130" Margin="0,0,6,0" SelectionChanged="ConvFromGrade_Changed"/>
                <ComboBox x:Name="ConvFromSize" Width="90" Margin="0,0,16,0"/>
                <TextBlock Text="To" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="ConvToGrade" Width="130" Margin="0,0,6,0" SelectionChanged="ConvToGrade_Changed"/>
                <ComboBox x:Name="ConvToSize" Width="90" Margin="0,0,16,0"/>
                <TextBlock Text="Weight ct" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="ConvWeight" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
                <TextBlock Text="Price/ct" Style="{StaticResource Lbl}"/>
                <TextBox x:Name="ConvPrice" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
                <Button Content="Convert" Click="Convert_Click"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Rejection with dispositions (INV-005/006)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Style="{StaticResource FormRow}" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L1"/><ColumnDefinition Width="Auto" SharedSizeGroup="F1"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L2"/><ColumnDefinition Width="Auto" SharedSizeGroup="F2"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L3"/><ColumnDefinition Width="Auto" SharedSizeGroup="F3"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L4"/><ColumnDefinition Width="Auto" SharedSizeGroup="F4"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="1" x:Name="RejGrade" Width="130" Margin="0,0,16,0" SelectionChanged="RejGrade_Changed"/>
              <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="3" x:Name="RejSize" Width="90" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="4" Text="Weight ct" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="5" x:Name="RejWeight" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="6" Text="Price/ct" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="7" x:Name="RejPrice" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <Button Grid.Column="8" Content="Record rejection" Click="Reject_Click" HorizontalAlignment="Left"/>
            </Grid>
            <TextBlock Text="Dispositions — weights must sum to the rejection (docs/04 §2.5). Leave empty to record a plain rejection."
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
            <DataGrid x:Name="DispositionGrid" Height="120" IsReadOnly="False" CanUserAddRows="True" Margin="0,0,0,14">
              <DataGrid.Columns>
                <!-- Right-aligned like every other weight in the app. This was the one carat column
                     that read left, which broke the eye's column down the page. -->
                <DataGridTextColumn Header="Weight ct" Binding="{Binding WeightCt, StringFormat=N4}" Width="110"
                                    ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"
                                    EditingElementStyle="{StaticResource NumEdit}"/>
                <!-- Without these it falls back to WPF's own combo chrome and renders 20px tall
                     against the 32px every other input uses. -->
                <DataGridComboBoxColumn Header="Outcome" SelectedValueBinding="{Binding Outcome}" Width="130"
                                        ElementStyle="{StaticResource AppComboBox}"
                                        EditingElementStyle="{StaticResource AppComboBox}">
                  <DataGridComboBoxColumn.ItemsSource>
                    <x:Array Type="sys:String" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                      <sys:String>RESELECT</sys:String><sys:String>REPAIR</sys:String><sys:String>REGRADE</sys:String>
                      <sys:String>CULET</sys:String><sys:String>OTHER</sys:String>
                    </x:Array>
                  </DataGridComboBoxColumn.ItemsSource>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="To grade (REGRADE only)" Binding="{Binding ToGradeCode}" Width="180"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Stock adjustment — always visible, never silent" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Style="{StaticResource FormRow}" Margin="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L1"/><ColumnDefinition Width="Auto" SharedSizeGroup="F1"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L2"/><ColumnDefinition Width="Auto" SharedSizeGroup="F2"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L3"/><ColumnDefinition Width="Auto" SharedSizeGroup="F3"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="L4"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="1" x:Name="AdjGrade" Width="130" Margin="0,0,16,0" SelectionChanged="AdjGrade_Changed"/>
              <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Lbl}"/>
              <ComboBox Grid.Column="3" x:Name="AdjSize" Width="90" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="4" Text="Weight ct (±)" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="5" x:Name="AdjWeight" Width="90" Style="{StaticResource AppNumericTextBox}" Margin="0,0,16,0"/>
              <TextBlock Grid.Column="6" Text="Reason" Style="{StaticResource Lbl}"/>
              <TextBox Grid.Column="7" x:Name="AdjReason" Width="220" Margin="0,0,16,0"/>
              <Button Grid.Column="8" Content="Adjust" Click="Adjust_Click" HorizontalAlignment="Left"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ MDM-001/002/004 · master data ═══════════════════════════════ -->
      <TabItem Header="Master data">
        <Grid Margin="22,18,22,18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ── Header ─────────────────────────────────────────────────────
               The window chrome already carries the connection pill and profile
               chip, so this adds the page identity only rather than repeating
               them. -->
          <StackPanel Grid.Row="0" Margin="2,0,2,16">
            <TextBlock Text="Master Data" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource CardSubtitle}"
                       Text="Manage diamond grades, buyers, brokers and pricing configuration"/>
          </StackPanel>

          <!-- ── Main · Grades 68% / sidebar 32% ────────────────────────────── -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="68*" MinWidth="520"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="32*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardContainer}">
              <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Grades" Style="{StaticResource CardTitle}"/>
                    <Border Style="{StaticResource CountBadge}">
                      <TextBlock x:Name="GradeCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                  </StackPanel>
                  <!-- Overlaid rather than templated: a Button inside the TextBox
                       ControlTemplate cannot carry a Click handler. -->
                  <Grid Grid.Column="2" Width="230" Margin="0,0,10,0">
                    <TextBox x:Name="GradeSearch" Style="{StaticResource SearchBar}"
                             TextChanged="GradeFilter_Changed"
                             AutomationProperties.Name="Search grades"/>
                    <Button x:Name="GradeSearchClear" Content="&#xE711;" Click="ClearGradeSearch_Click"
                            FontFamily="Segoe MDL2 Assets" FontSize="10" Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                            Visibility="Collapsed" Cursor="Hand" BorderThickness="0"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                            ToolTip="Clear search (Esc)" AutomationProperties.Name="Clear search"/>
                  </Grid>
                  <ComboBox Grid.Column="3" x:Name="GradeStatusFilter" SelectedIndex="0"
                            Style="{StaticResource FilterDropdown}"
                            SelectionChanged="GradeStatus_Changed" PreviewMouseWheel="NoWheelChange"
                            AutomationProperties.Name="Filter grades by status">
                    <ComboBoxItem>All statuses</ComboBoxItem>
                    <ComboBoxItem>Active</ComboBoxItem>
                    <ComboBoxItem>Inactive</ComboBoxItem>
                  </ComboBox>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CardSubtitle}" Margin="2,10,0,0"
                           Text="Aliases are the spellings a workbook may use for a grade, separated by ; — an import resolves through them. Double-click a cell to edit. Code, name and order are read-only: they are referenced by imported invoices."/>


                <Grid>
                  <DataGrid x:Name="GradeGrid" Style="{StaticResource DataTable}"
                            ColumnHeaderStyle="{StaticResource TableHeader}"
                            IsReadOnly="False" CellEditEnding="GradeAlias_Committed"
                            AutomationProperties.Name="Grades">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="110" IsReadOnly="True"/>
                      <DataGridTextColumn Header="GRADE NAME" Binding="{Binding DisplayName}" Width="150" IsReadOnly="True"/>
                      <DataGridTextColumn Header="ALIASES" Binding="{Binding Aliases}" Width="*"/>
                      <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="70" IsReadOnly="True"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTemplateColumn Header="STATUS" Width="100" IsReadOnly="True"
                                              CellTemplate="{StaticResource StatusBadgeTemplate}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                              Visibility="{Binding ItemsSource, ElementName=GradeGrid, Converter={StaticResource Empty}}">
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No grades match"/>
                    <TextBlock Style="{StaticResource EmptyStateBody}"
                               Text="Clear the search box or change the status filter to see the full catalogue."/>
                  </StackPanel>
                </Grid>
              </DockPanel>
            </Border>

            <!-- ── Sidebar · one card, two tabs ────────────────────────────────
                 Two stacked cards each got half the height and both started
                 scrolling after two rows. Tabs give the visible list all of it. -->
            <Border Grid.Column="2" Style="{StaticResource CardContainerSoft}">
              <TabControl Style="{StaticResource SectionTabs}" Padding="0,4,0,0">
              <TabItem Header="Buyers" Style="{StaticResource SectionTabItem}">
                <DockPanel Margin="0,6,0,0">
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Left" Margin="0">
                      <TextBlock x:Name="BuyerCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                    <Button Content="Add buyer" Click="AddBuyer_Click" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryAction}" MinWidth="104"
                            VerticalAlignment="Center"/>
                  </Grid>
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                AutomationProperties.Name="Buyers">
                    <ItemsControl x:Name="BuyerGrid">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource PartyRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PartyName}"/>
                                <TextBlock Style="{StaticResource PartyMeta}"
                                           Text="{Binding DefaultTermsDays, StringFormat={}Payment terms · {0} days}"/>
                              </StackPanel>
                              <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              <TabItem Header="Brokers" Style="{StaticResource SectionTabItem}">
                <DockPanel Margin="0,6,0,0">
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Left" Margin="0">
                      <TextBlock x:Name="BrokerCount" Text="0" Style="{StaticResource CountBadgeText}"/>
                    </Border>
                    <Button Content="Add broker" Click="AddBroker_Click" HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryAction}" MinWidth="104"
                            VerticalAlignment="Center"/>
                  </Grid>
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                AutomationProperties.Name="Brokers">
                    <ItemsControl x:Name="BrokerGrid">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource PartyRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource PartyName}"/>
                                <TextBlock Style="{StaticResource PartyMeta}"
                                           Text="{Binding DefaultBrokerPct, StringFormat={}Commission · {0:N2}%}"/>
                              </StackPanel>
                              <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center"
                                              ContentTemplate="{StaticResource StatusBadgeTemplate}"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </TabItem>
              </TabControl>
            </Border>
          </Grid>

          <!-- ── Bottom tabs ────────────────────────────────────────────────── -->
          <Border Grid.Row="2" Style="{StaticResource CardContainer}" Margin="0,18,0,0" Height="320">
            <TabControl Style="{StaticResource SectionTabs}">
              <TabItem Header="Sieve Sizes" Style="{StaticResource SectionTabItem}">
                <Grid Margin="0,4,0,0">
                  <!-- Left-aligned and bounded: a star-width last column stretched four narrow
                       columns across the full card and left a field of empty table. -->
                  <DataGrid x:Name="SizeGrid" Style="{StaticResource DataTable}"
                            ColumnHeaderStyle="{StaticResource TableHeader}" RowHeight="34"
                            HorizontalAlignment="Left" Width="560"
                            AutomationProperties.Name="Sieve sizes">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="130"/>
                      <DataGridTextColumn Header="ORDER" Binding="{Binding SortOrder}" Width="100"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="LOWER MM" Binding="{Binding LowerMm, StringFormat=N2}" Width="160"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                      <DataGridTextColumn Header="UPPER MM" Binding="{Binding UpperMm, StringFormat=N2}" Width="160"
                                          ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                              Visibility="{Binding ItemsSource, ElementName=SizeGrid, Converter={StaticResource Empty}}">
                    <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No sieve sizes"/>
                    <TextBlock Style="{StaticResource EmptyStateBody}" Text="Press Refresh to load the catalogue."/>
                  </StackPanel>
                </Grid>
              </TabItem>

              <TabItem Header="Price Configuration" Style="{StaticResource SectionTabItem}">
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Left · what the price applies to. Right · the price itself. -->
                  <!-- Two columns: stacked in one, PRICE PER CARAT and Save fell off the
                       bottom of the card and could not be reached at all. -->
                  <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                      <TextBlock Text="GRADE" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceGradePicker" Height="34" SelectionChanged="PriceGrade_Changed"
                                PreviewMouseWheel="NoWheelChange"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                      <TextBlock Text="SIZE" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceSizePicker" Height="34" PreviewMouseWheel="NoWheelChange"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                      <TextBlock Text="CONTEXT" Style="{StaticResource FormLabel}"/>
                      <ComboBox x:Name="PriceContext" Height="34" SelectedIndex="0"
                                PreviewMouseWheel="NoWheelChange">
                        <ComboBoxItem>SALE</ComboBoxItem><ComboBoxItem>STOCK</ComboBoxItem><ComboBoxItem>REJECTION</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                      <TextBlock Text="PRICE PER CARAT" Style="{StaticResource FormLabel}"/>
                      <TextBox x:Name="PriceValue" MaxLength="12" Style="{StaticResource FormNumeric}"/>
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Save price"
                            Click="AddPrice_Click" HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryAction}"/>
                  </Grid>

                  <Grid Grid.Column="1">
                    <DataGrid x:Name="PriceGrid" Style="{StaticResource DataTable}"
                              ColumnHeaderStyle="{StaticResource TableHeader}" RowHeight="34"
                              AutomationProperties.Name="Price list">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="GRADE" Binding="{Binding GradeCode}" Width="100"/>
                        <DataGridTextColumn Header="SIZE" Binding="{Binding SizeCode}" Width="80"/>
                        <DataGridTextColumn Header="CONTEXT" Binding="{Binding Context}" Width="100"/>
                        <DataGridTextColumn Header="PRICE/CT" Binding="{Binding PricePerCt, StringFormat=N2}" Width="*"
                                            ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                        <DataGridTextColumn Header="FROM" Binding="{Binding EffectiveFrom, StringFormat=dd-MM-yy}" Width="90"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding ItemsSource, ElementName=PriceGrid, Converter={StaticResource Empty}}">
                      <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No prices configured"/>
                      <TextBlock Style="{StaticResource EmptyStateBody}"
                                 Text="Choose a grade, size and context on the left, enter a price per carat, then press Save price."/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
          </Border>
        </Grid>
      </TabItem>

      <!-- ══ PHASE 4 · owner dashboard · W1…W15 ══════════════════════════ -->
      <TabItem Header="Dashboard">
        <DockPanel Margin="8">

          <!-- global filter bar — applies to every widget -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusCard}" Padding="14" Margin="0,0,0,8">
            <WrapPanel>
              <TextBlock Text="Range" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="RangePicker" Width="120" SelectedIndex="2" Margin="0,0,14,0" SelectionChanged="Range_Changed">
                <ComboBoxItem Tag="TODAY">Today</ComboBoxItem>
                <ComboBoxItem Tag="WEEK">This week</ComboBoxItem>
                <ComboBoxItem Tag="MONTH">This month</ComboBoxItem>
                <ComboBoxItem Tag="QUARTER">This quarter</ComboBoxItem>
                <ComboBoxItem Tag="FY">Financial year</ComboBoxItem>
                <ComboBoxItem Tag="ALL">All time</ComboBoxItem>
                <ComboBoxItem Tag="CUSTOM">Custom…</ComboBoxItem>
              </ComboBox>
              <DatePicker x:Name="FromDate" Style="{StaticResource AppDatePicker}" Width="145" Margin="0,0,4,0" IsEnabled="False"/>
              <DatePicker x:Name="ToDate" Style="{StaticResource AppDatePicker}" Width="145" Margin="0,0,14,0" IsEnabled="False"/>
              <TextBlock Text="Buyer" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="FilterBuyer" Width="150" Margin="0,0,14,0" ItemTemplate="{StaticResource NameTemplate}" ItemContainerStyle="{StaticResource PartyItemContainer}"
                        AutomationProperties.Name="Filter by buyer"/>
              <TextBlock Text="Grade" Style="{StaticResource Lbl}"/>
              <ComboBox x:Name="FilterGrade" Width="120" Margin="0,0,14,0"/>
              <Button Content="Apply" Click="LoadDashboard_Click"/>
              <Button Content="Clear" Click="ClearFilters_Click"/>
            </WrapPanel>
          </Border>

          <!-- W15 · alerts strip -->
          <Border DockPanel.Dock="Top" x:Name="AlertStrip" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="AlertText" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
          </Border>

          <!-- W1,W2,W3,W7,W9,W11,W14 · KPI tiles -->
          <!-- No fixed Height: at 170 each tile got 85px and the third line (delta / basis / carats)
               was clipped off the bottom of every tile. -->
          <UniformGrid DockPanel.Dock="Top" Columns="4" Rows="2">
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W1 · Total sales" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiSales" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiSalesDelta" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W2 · Carats sold" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiCarats" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W3 · Blended rate/ct" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiRate" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W9 · Outstanding" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiOutstanding" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W11 · Inventory value" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiInventory" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiInventoryCt" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W7 · Margin" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiMargin" Style="{StaticResource Kpi}"/><TextBlock x:Name="KpiMarginBasis" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="W14 · Broker cost" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiBroker" Style="{StaticResource Kpi}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="3" Padding="14">
              <StackPanel><TextBlock Text="Posted invoices" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock x:Name="KpiCount" Style="{StaticResource Kpi}"/></StackPanel></Border>
          </UniformGrid>

          <!-- W4,W5,W6,W8,W10,W12,W13 · one bar list, seven breakdowns -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,8,8,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Breakdown" Style="{StaticResource Lbl}"/>
                <ComboBox x:Name="BreakdownPicker" Width="260" SelectedIndex="0" SelectionChanged="Breakdown_Changed">
                  <ComboBoxItem Tag="period">W4 · Sales by period</ComboBoxItem>
                  <ComboBoxItem Tag="salesperson">W5 · Sales by salesperson</ComboBoxItem>
                  <ComboBoxItem Tag="buyer">W6 · Sales by buyer</ComboBoxItem>
                  <ComboBoxItem Tag="ageing">W10 · Receivables ageing</ComboBoxItem>
                  <ComboBoxItem Tag="inventory">W11 · Inventory value by grade</ComboBoxItem>
                  <ComboBoxItem Tag="inventory-aging">W12 · Inventory aging</ComboBoxItem>
                  <ComboBoxItem Tag="broker-cost">W14 · Broker cost</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="PeriodBucket" Width="90" SelectedIndex="0" Margin="8,0,0,0" SelectionChanged="Breakdown_Changed">
                  <ComboBoxItem>day</ComboBoxItem><ComboBoxItem>week</ComboBoxItem><ComboBoxItem>month</ComboBoxItem>
                </ComboBox>
              </StackPanel>

              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BarList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2" Height="26">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Rectangle Grid.Column="1" HorizontalAlignment="Left" Height="18" RadiusX="2" RadiusY="2"
                                   Width="{Binding BarWidth}" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DeltaText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>

            <!-- drill-down: the invoices behind whatever is filtered -->
            <DockPanel Grid.Column="1" Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Top" Text="Drill-down · invoices in this view" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <DataGrid x:Name="DrillGrid">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="No" Binding="{Binding InvoiceNo}" Width="90"/>
                  <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="*"/>
                  <DataGridTextColumn Header="Amount" Binding="{Binding AmountTotal, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource AppNumericHeader}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ══ AUD-001 · audit, AUTH-002 · users, CFG · settings ═══════════ -->
      <TabItem Header="Audit">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Top" Content="Refresh" Click="LoadAudit_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
          <DataGrid x:Name="AuditGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="When (UTC)" Binding="{Binding ChangedAt, StringFormat=dd-MM-yyyy HH:mm:ss}" Width="150"/>
              <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="130"/>
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
              <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="250"/>
              <DataGridTextColumn Header="After" Binding="{Binding After}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Users" x:Name="UsersTab">
        <DockPanel Margin="8">
          <!-- Read-only: creating or disabling a Supabase account needs the service_role key, which
               must never ship in a desktop binary. That work happens in the Supabase dashboard. -->
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadUsers_Click"/>
          </WrapPanel>
          <DataGrid x:Name="UserGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="200"/>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
              <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Settings">
        <DockPanel Margin="8">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Refresh" Click="LoadSettings_Click"/>
            <TextBlock Text="Value for selected key:" Style="{StaticResource Lbl}" Margin="16,0,6,0"/>
            <TextBox x:Name="SettingValue" Width="180" Margin="0,0,6,0"/>
            <Button Content="Save (Owner)" Click="SaveSetting_Click"/>
            <Border Style="{StaticResource ToolbarSeparator}"/>
            <!-- Import lives here rather than on Invoices: it replaces a whole dataset, which is an
                 administrative act, not day-to-day entry. -->
            <Button x:Name="ImportExcel" Content="Import sales from Excel…" Click="ImportExcel_Click"
                    AutomationProperties.HelpText="Validates a sale workbook, then replaces all previously imported sales with it"/>
            <TextBlock x:Name="ImportStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
          </WrapPanel>
          <!-- No backup panel: Supabase takes and keeps the backups now. -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Policies (CFG-001/002)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid x:Name="SettingGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="260"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
