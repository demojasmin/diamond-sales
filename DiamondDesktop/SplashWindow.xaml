<Window x:Class="DiamondDesktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiamondDesktop"
        Icon="{StaticResource AppIcon}" Title="Solitaire Desk" Width="460" Height="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Opacity="0"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

  <!-- Transparent window, rounded card inside: AllowsTransparency is what lets the shadow fall on
       the desktop instead of being clipped to a square. Every colour is an application token, so
       this is the same surface, accent and text the user is about to see behind it. -->
  <Border Margin="24" CornerRadius="18"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.14" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <!-- A wash of the accent behind the mark, the same device the sign-in window uses. -->
      <Grid.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.75" RadiusY="0.6">
          <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0"/>
          <GradientStop Color="{DynamicResource SurfaceColor}" Offset="1"/>
        </RadialGradientBrush>
      </Grid.Background>

      <!-- The same control the pages use, with the wordmark on. -->
      <local:BrandLoader ShowWordmark="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
  </Border>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <!-- Only the window's own fade lives here. Everything else the splash animates now lives
               inside BrandLoader and is triggered there: a Storyboard here can only reach names in
               this window's namescope, and reaching for one it cannot see throws on Loaded rather
               than failing quietly. -->
          <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
</Window>
