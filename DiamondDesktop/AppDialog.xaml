<Window x:Class="DiamondDesktop.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="560" MinHeight="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5" TextOptions.TextFormattingMode="Ideal"
        KeyDown="Window_KeyDown">

  <Window.Resources>
    <!-- One label column shared by every fact row, so the values line up in a column instead of
         wandering with the width of each label. -->
    <Style x:Key="FactLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FactValue" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <!-- Tabular figures: without them the digits in 1,434 and 1,437 sit at different widths
           and the numbers look ragged even when they are aligned. -->
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- Footer first in markup so it keeps its height when the body grows -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="22,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SecondaryButton" MinWidth="104" Height="34" Margin="0,0,10,0"
                Style="{StaticResource AppButton}" Click="Secondary_Click" IsCancel="True"/>
        <Button x:Name="PrimaryButton" MinWidth="124" Height="34"
                Style="{StaticResource AppPrimaryButton}" Click="Primary_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="22,20,22,16">
      <StackPanel Orientation="Horizontal">
        <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="21"
                Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top"
                Margin="0,0,14,0">
          <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                     FontSize="19" Foreground="{DynamicResource WarningBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Headline" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="Subhead" Foreground="{DynamicResource TextMutedBrush}"
                     TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Body. Scrolls rather than growing without limit: a file with many distinct problems
         would otherwise push the buttons off the bottom of the screen. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Padding="22,0,22,18">
      <StackPanel>

        <Border x:Name="FactsCard" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}" Padding="16,12" Margin="0,0,0,14">
          <Grid x:Name="FactsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </Border>

        <Border x:Name="EmphasisCard" Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}" Padding="14,11" Margin="0,0,0,14"
                Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                       Foreground="{DynamicResource DangerBrush}" Margin="0,1,10,0"
                       VerticalAlignment="Top"/>
            <TextBlock x:Name="EmphasisText" TextWrapping="Wrap" MaxWidth="440"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="ListSection" Visibility="Collapsed">
          <TextBlock x:Name="ListTitle" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <ItemsControl x:Name="ListItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="4" Height="4" Margin="4,8,10,0" VerticalAlignment="Top"
                           Fill="{DynamicResource TextMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock x:Name="FooterNote" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
