<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         LIGHT THEME · color tokens (ported 1:1 from the HTML prototype)
         Every component style references these via DynamicResource.
         ============================================================ -->

    <!-- Grounds -->
    <Color x:Key="DeskColor">#0A0D12</Color>
    <Color x:Key="BgColor">#F4F6F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#EEF1F6</Color>
    <Color x:Key="BorderColor">#D9DFE8</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#141A22</Color>
    <Color x:Key="TextMutedColor">#5A6675</Color>

    <!-- Accent (sapphire) -->
    <Color x:Key="AccentColor">#2F6BE0</Color>
    <Color x:Key="AccentHoverColor">#2559C4</Color>
    <Color x:Key="AccentSoftColor">#E7F0FF</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#1E9E6A</Color>
    <Color x:Key="WarningColor">#B87A16</Color>
    <Color x:Key="DangerColor">#CF4632</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="DeskBrush" Color="{StaticResource DeskColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <!-- Fill behind white text. Separate from AccentBrush because the accent that reads well as
         TEXT on a page and the accent that carries white text ON it pull in opposite directions —
         see DarkTheme, where they must differ to clear 4.5:1. -->
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentStrongHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Soft + border variants for chips / state fills (≈ color-mix in HTML) -->
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#211E9E6A"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#521E9E6A"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#21B87A16"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DB87A16"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FCF4632"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4DCF4632"/>
    <!-- Conversions in the Stock report's history: the one transaction type with no status colour. -->
    <SolidColorBrush x:Key="ConversionBrush" Color="#7046C2"/>
    <SolidColorBrush x:Key="ConversionSoftBrush" Color="#1F7046C2"/>
    <!-- Stock report: one soft tint per sieve size, so each size's Weight/Rate pair reads as
         one column. Cycled in order across the sheet (ReportBand0 for the first size shown). -->
    <SolidColorBrush x:Key="ReportBand0" Color="#172F6BE0"/>
    <SolidColorBrush x:Key="ReportBand1" Color="#171E9E6A"/>
    <SolidColorBrush x:Key="ReportBand2" Color="#17D08A12"/>
    <SolidColorBrush x:Key="ReportBand3" Color="#177046C2"/>
    <SolidColorBrush x:Key="ReportBand4" Color="#17D9486A"/>
    <SolidColorBrush x:Key="ReportBand5" Color="#171597A6"/>
    <SolidColorBrush x:Key="ReportBand6" Color="#17E0702F"/>
    <SolidColorBrush x:Key="ReportBand7" Color="#175B6B82"/>
    <!-- Stock report banding: laid over every other grade row and every other column (each
         size's rate column), so a row and a column can be followed across the sheet. -->
    <SolidColorBrush x:Key="ReportStripeBrush" Color="#0B1F2937"/>
    <!-- Stock report: the left-hand Grade column and the Size header row, a step darker so they stand out. -->
    <SolidColorBrush x:Key="ReportLabelBrush" Color="#241F2937"/>

    <!-- ============================================================
         Stock report sheet. The report draws its own grid in code, so the two things that
         have to differ between themes are named here rather than decided in C# — the cells
         bind them with SetResourceReference, so a theme toggle re-colours a report already
         on screen instead of leaving it stale until the next load.
         ============================================================ -->
    <!-- exactly the text colour, which is what it has always been — the sheet is meant to read as
         the printed one it replaces, and that is ruled in ink. -->
    <SolidColorBrush x:Key="ReportRuleBrush" Color="#141A22"/>
    <!-- Mono figures at 13px need the extra stroke on a dark ground and do not on a light
         one, where the same weight reads as shouting. -->
    <FontWeight x:Key="ReportFigureWeight">Normal</FontWeight>

    <!-- Dialog scrim -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#59141A22"/>

    <!-- Elevation -->
    <DropShadowEffect x:Key="CardShadow" Color="#141A22" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.10"/>
    <DropShadowEffect x:Key="PopupShadow" Color="#141A22" BlurRadius="48" ShadowDepth="18" Direction="270" Opacity="0.20"/>

</ResourceDictionary>
