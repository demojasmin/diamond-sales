<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DARK THEME · color tokens (ported 1:1 from the HTML prototype)
         Same keys as LightTheme.xaml — swapping dictionaries re-themes all.
         ============================================================ -->

    <!-- Grounds -->
    <Color x:Key="DeskColor">#0A0D12</Color>
    <Color x:Key="BgColor">#0E1116</Color>
    <Color x:Key="SurfaceColor">#161A21</Color>
    <Color x:Key="Surface2Color">#1E242D</Color>
    <Color x:Key="BorderColor">#2A313C</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#E6EBF2</Color>
    <Color x:Key="TextMutedColor">#93A0B4</Color>

    <!-- Accent (sapphire) -->
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#6AA1FF</Color>
    <Color x:Key="AccentSoftColor">#16263F</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#3FB984</Color>
    <Color x:Key="WarningColor">#E0A63C</Color>
    <Color x:Key="DangerColor">#E5634D</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="DeskBrush" Color="{StaticResource DeskColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Soft + border variants for chips / state fills -->
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#213FB984"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#523FB984"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#21E0A63C"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DE0A63C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FE5634D"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4DE5634D"/>

    <!-- Dialog scrim -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#73000000"/>

    <!-- Elevation -->
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.38"/>
    <DropShadowEffect x:Key="PopupShadow" Color="#000000" BlurRadius="60" ShadowDepth="20" Direction="270" Opacity="0.60"/>

</ResourceDictionary>
