<Window x:Class="DiamondDesktop.AppProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13.5" TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">

  <!-- No chrome at all: there is no close button to press, which is the clearest way to say the
       work cannot be interrupted. Closing is refused in code as well, so Alt+F4 does nothing. -->
  <Border Background="{DynamicResource BgBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
          CornerRadius="{StaticResource RadiusCard}" Padding="26,24">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
    </Border.Effect>

    <StackPanel>
      <TextBlock x:Name="Headline" Text="Importing data, please wait…"
                 FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>

      <TextBlock x:Name="Detail" Foreground="{DynamicResource TextMutedBrush}"
                 TextWrapping="Wrap" Margin="0,6,0,0"
                 Text="Preparing…"/>

      <!-- Slim track, rounded, accent fill. Height 6 keeps it a status indicator rather than a
           control that invites clicking. -->
      <ProgressBar x:Name="Bar" Height="6" Margin="0,18,0,0" IsIndeterminate="True"
                   Minimum="0" Maximum="100" BorderThickness="0"
                   Background="{DynamicResource AccentSoftBrush}"
                   Foreground="{DynamicResource AccentBrush}">
        <ProgressBar.Resources>
          <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
          </Style>
        </ProgressBar.Resources>
      </ProgressBar>

      <TextBlock x:Name="Counter" Foreground="{DynamicResource TextMutedBrush}"
                 FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Right"
                 Visibility="Collapsed"/>

      <TextBlock Text="Please do not close the application while this runs."
                 Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
  </Border>
</Window>
